diff --git a/bofire/data_models/types.py b/bofire/data_models/types.py
index d23a2977c..e1533fd73 100644
--- a/bofire/data_models/types.py
+++ b/bofire/data_models/types.py
@@ -73,6 +73,25 @@ def validate_monotonically_increasing(sequence: Sequence[float]) -> Sequence[flo
     return sequence
 
 
+def validate_strictly_increasing(sequence: Sequence[float]) -> Sequence[float]:
+    """Validate that the sequence is strictly increasing.
+
+    Args:
+        sequence: Sequence of values.
+
+    Raises:
+        ValueError: If lower bound is greater or equal to the upper bound.
+
+    Returns:
+        Validated sequence
+
+    """
+    if len(sequence) > 1:
+        if not all(x < y for x, y in zip(sequence, sequence[1:])):
+            raise ValueError("Sequence is not strictly increasing.")
+    return sequence
+
