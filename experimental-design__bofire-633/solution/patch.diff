             @staticmethod
             def _lb_correction(
                 lb: np.ndarray, x: np.ndarray, n_non_zero: int, min_delta: float
             ) -> np.ndarray:
-                """correct upper bounds: set the upper bound of the smallest n_zero elements in each row to zero"""
