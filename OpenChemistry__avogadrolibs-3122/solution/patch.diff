+  // Sanity check: with both columns the shell loads as S plus P.
+  GAMESSUSOutput format;
+  Molecule molecule;
+  ASSERT_TRUE(format.readString(
+    kCoordinates + kBasisHeader + " C\n\n" + complete + kBasisEnd, molecule));
