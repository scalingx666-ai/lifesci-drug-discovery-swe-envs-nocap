+        δVσ2 .+= @. Vσσ[2,:] * δσ[1,:] + Vσσ[4,:] * δσ[2,:] + Vσσ[5,:] * δσ[3,:]
+        δVσ3 .+= @. Vσσ[3,:] * δσ[1,:] + Vσσ[5,:] * δσ[2,:] + Vσσ[6,:] * δσ[3,:]
+        if !isnothing(Vστ)
+            δVσ1 .+= @. Vστ[1,:]*δτ[1,:] + Vστ[2,:]*δτ[2,:]
+            δVσ2 .+= @. Vστ[3,:]*δτ[1,:] + Vστ[4,:]*δτ[2,:]
