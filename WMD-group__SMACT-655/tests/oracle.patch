diff --git a/.github/workflows/ci.yml b/.github/workflows/ci.yml
index c3f725d5..88a192c4 100644
--- a/.github/workflows/ci.yml
+++ b/.github/workflows/ci.yml
@@ -67,11 +67,12 @@ jobs:
         env:
           MP_API_KEY: ${{ secrets.MP_API_KEY }}
         run: uv run pytest --cov=smact --cov-report=xml -v
-      # CODECOV_TOKEN is not available to pull requests from forks, and the step below
-      # fails the job when an upload errors. Skip it there rather than showing a
-      # contributor a red build they cannot fix.
+      # CODECOV_TOKEN is not available to pull requests from forks, nor to Dependabot's
+      # PRs even though its branches live in this repo, and the step below fails the job
+      # when an upload errors. Skip it there rather than showing a contributor (or
+      # Dependabot) a red build they cannot fix.
       - name: Upload coverage reports to CodeCov
-        if: ${{ github.event_name != 'pull_request' || github.event.pull_request.head.repo.full_name == github.repository }}
+        if: ${{ github.event_name != 'pull_request' || (github.event.pull_request.head.repo.full_name == github.repository && github.actor != 'dependabot[bot]') }}
         uses: codecov/codecov-action@v5
         with:
           token: ${{ secrets.CODECOV_TOKEN }}
diff --git a/pyproject.toml b/pyproject.toml
index 799ea550..6d6c3ca0 100644
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -96,7 +96,12 @@ ml = ["xgboost","shap","smact[featurisers]"]
 property_prediction = [
     "aviary-models>=1.2.1",
     "requests",
-    "torch>=2.0.0",
+    # >=2.11 pulls nvidia-nccl-cu13, which collides with xgboost's nvidia-nccl-cu12
+    # (smact[ml]) on Linux: both packages install to nvidia/nccl/lib/libnccl.so.2, and
+    # whichever installs last wins, leaving torch loaded against a mismatched NCCL ABI.
+    # xgboost can't move to cu13 without dropping Python 3.11 support (dropped at 3.3.0,
+    # before its own cu13 switch at 3.4.0), so cap torch here instead. See #651.
+    "torch>=2.0.0,<2.11",
 ]
 optional = [
     "pydantic>=2.9.2",
