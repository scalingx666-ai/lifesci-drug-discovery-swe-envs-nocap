+  {
+   "cell_type": "markdown",
+   "id": "36",
+   "metadata": {},
+   "source": [
+    "## Example 3: Multiobjective Optimization\n",
+    "by giving multiple objective functions, or returning a 2D array from the objective, we will trigger multiobjective optimization"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "37",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "def objective_function_1(x: List[pd.DataFrame]) -> np.ndarray:\n",
+    "    \"\"\"assume we want to maximize the mean variance of the experiments dataframe\"\"\"\n",
+    "    vars = [xi.var(numeric_only=True).mean() for xi in x]\n",
+    "    return -np.array(vars)"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "38",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "def objective_function_2(x: List[pd.DataFrame]) -> np.ndarray:\n",
+    "    \"\"\"Maximize the sum of all inputs\"\"\"\n",
+    "    vars = [xi.sum().sum() for xi in x]\n",
+    "    return -np.array(vars)"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": null,
+   "id": "39",
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "x_opt, f_opt = run_ga(\n",
+    "    data_model=optimizer,\n",
+    "    domain=domain,\n",
+    "    objective_callables=[\n",
+    "        objective_function_1,\n",
+    "        objective_function_2,\n",
+    "    ],  # list of objective functions to optimize\n",
+    "    q=3,  # number of points to optimize\n",
+    "    callable_format=\"pandas\",\n",
+    ")"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "40",
