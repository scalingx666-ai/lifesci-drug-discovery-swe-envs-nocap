+def load_smiles_from_txt(file):
+    """Load SMILES from a txt file.
+
+    Parameters
+    ----------
+    file : str
+        Path to a txt file where each line has a SMILES string.
+
+    Returns
+    -------
+    list of str
+        List of SMILES
+    """
+    smiles = []
+    with open(file, 'r') as f:
+        for line in f.readlines():
+            smiles.append(line.strip())
+
+    return smiles
