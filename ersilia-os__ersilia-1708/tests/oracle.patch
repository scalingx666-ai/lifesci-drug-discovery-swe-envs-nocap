+                    failed_checks.append(error)
+        if failed_checks:
+            return [
+            create_response(
+                name=ResponseName.TEST_COMMAND_CHECKS_FAILED,
+                status=False,
+                detail=failed_checks,
+            )
+        ]
+        return [
+            create_response(
+                name=ResponseName.TEST_COMMAND_CHECKS_FAILED,
+                status=True,
