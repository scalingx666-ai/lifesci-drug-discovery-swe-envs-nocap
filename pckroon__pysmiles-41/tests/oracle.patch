+        is_perfect = nx.is_perfect_matching(mol.subgraph(cycle),
+                                            {e for e in double_bonds if
+                                             all(v in cycle for v in e)})
+        if is_perfect:
+            for node in cycle:
+                mol.nodes[node]['aromatic'] = True
