+      duplicated(groups_units_tbl[group_conc_cols], fromLast = TRUE)
+    mismatching_units_groups <- groups_units_tbl[mask_duplicated_groups, , drop = FALSE]
+  }
+  if (nrow(mismatching_units_groups) > 0) {
