+                          method='L-BFGS-B',
+                          jac=derivative,
+                          args=(images, idpp, Config.n_cores, False),
+                          options={'gtol': 0.01}
+                          )
+
+        logger.info(f'IDPP minimisation successful: {result.success}')
+
+        self.images.set_coords(result.x)
+        return None
