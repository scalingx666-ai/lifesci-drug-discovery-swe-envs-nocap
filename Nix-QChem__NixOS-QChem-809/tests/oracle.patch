     # LibEcpInt
     "-DENABLE_ecpint=ON"
     "-Decpint_DIR=${libecpint}"
-    # LibEFP
-    "-DENABLE_libefp=OFF"
     # CheMPS2
     "-DENABLE_CheMPS2=ON"
     "-DCheMPS2_DIR=${chemps2_}"
diff --git a/pkgs/python-by-name/pylibefp/package.nix b/pkgs/python-by-name/pylibefp/package.nix
