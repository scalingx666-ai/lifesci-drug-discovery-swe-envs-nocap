diff --git a/tools/pecat/.shed.yml b/tools/pecat/.shed.yml
new file mode 100644
index 0000000000..88eb228ae6
--- /dev/null
+++ b/tools/pecat/.shed.yml
@@ -0,0 +1,13 @@
+categories:
+- Assembly
+description: Phased error correction and assembly tool for long reads
+long_description: |
+  PECAT is a phased error correction and assembly pipeline for diploid genomes
+  from PacBio CLR, Oxford Nanopore (ONT), or PacBio HiFi long-read data. It
+  performs haplotype-aware error correction, phased string-graph assembly, and
+  Racon consensus polishing.
+name: pecat
+owner: bgruening
+homepage_url: https://github.com/lemene/PECAT
+remote_repository_url: https://github.com/bgruening/galaxytools/tree/master/tools/pecat
+type: unrestricted
\ No newline at end of file
diff --git a/tools/pecat/macros.xml b/tools/pecat/macros.xml
new file mode 100644
