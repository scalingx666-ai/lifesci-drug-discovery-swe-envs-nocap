+text(140, 237, "Set neither column", cex = cex_body)
+text(c(420, 700), 237, c("exclude_half.life", "include_half.life"),
+     cex = cex_body, family = "mono")
+text(branch_x, 257,
+     c("on PKNCAconc()", "TRUE drops that point", "TRUE keeps that point"),
