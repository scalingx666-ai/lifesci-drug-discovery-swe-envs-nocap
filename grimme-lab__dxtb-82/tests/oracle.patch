+    dtype : torch.dtype
+        Data type of the tensor.
+    Returns
+    -------
+    Tensor   
+                Tensor from the npz file.
+    """
+    name = name.replace("-", "").lower()
+    return torch.from_numpy(npzfile[name]).type(dtype)
