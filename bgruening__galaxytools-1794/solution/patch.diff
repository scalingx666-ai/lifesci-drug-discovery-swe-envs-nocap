+                    <assert_contents>
+                        <has_text text="&lt;Description&gt;{&quot;shape&quot;: [21571, 19505]}&lt;/Description&gt;&lt;Pixels BigEndian=&quot;true&quot; DimensionOrder=&quot;XYZCT&quot;"/>
+                    </assert_contents>
+                </extra_files>
