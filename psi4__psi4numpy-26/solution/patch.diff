+   "source": [
+    "\"\"\"Tutorial: Overlap, Kinetic, and Dipole Integrals\"\"\"\n",
+    "\n",
+    "__author__    = [\"Adam S. Abbott\", \"Boyi Zhang\", \"Justin M. Turney\"]\n",
+    "__credit__    = [\"Adam S. Abbott\", \"Boyi Zhang\", \"Justin M. Turney\"]\n",
+    "\n",
