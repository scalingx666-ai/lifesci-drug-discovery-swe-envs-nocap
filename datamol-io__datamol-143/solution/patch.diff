     rxn = dm.reactions.rxn_from_smarts(
         "[*:1]O[C:2](=[O])[#6:3].[Nh:4]>>[N:4][C:2](=[O])[#6:3].[*:1][Oh]"
@@ -164,3 +179,82 @@ def test_inverse_reaction():
     rxn_r = dm.reactions.inverse_reaction(rxn)
     assert len(list(rxn_r.GetReactants())) == 1
