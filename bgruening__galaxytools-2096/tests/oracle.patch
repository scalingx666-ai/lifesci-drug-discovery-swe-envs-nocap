diff --git a/tools/salmon/test-data/quantmerge-collection.gxwf-test.yml b/tools/salmon/test-data/quantmerge-collection.gxwf-test.yml
new file mode 100644
index 0000000000..4bb91a70ea
--- /dev/null
+++ b/tools/salmon/test-data/quantmerge-collection.gxwf-test.yml
@@ -0,0 +1,52 @@
+- doc: Reduce a collection to one matrix, preserving distinct sample identities and values.
+  job:
+    quantifications:
+      class: Collection
+      collection_type: list
+      elements:
+        - identifier: sample.one
+          class: File
+          path: sample.one
+          filetype: tabular
+        - identifier: sample_one
+          class: File
+          path: sample_one
+          filetype: tabular
+        - identifier: sample_one_2
+          class: File
+          path: sample_one_2
+          filetype: tabular
+  outputs:
+    merged:
+      asserts:
+        has_line:
+          line: "Name\tsample_one\tsample_one_3\tsample_one_2"
+        has_text_matching:
+          expression: "(?m)^tx_shared\t1\t3\t5$"
+        has_n_lines:
+          n: 4
+        has_n_columns:
+          n: 4
+- doc: Collection identifiers that begin with a hyphen must remain sample names.
+  job:
+    quantifications:
+      class: Collection
+      collection_type: list
+      elements:
+        - identifier: --genes
+          class: File
+          path: sample.one
+          filetype: tabular
+        - identifier: normal
+          class: File
+          path: sample_one
+          filetype: tabular
+  outputs:
+    merged:
+      asserts:
+        has_line:
+          line: "Name\t_--genes\tnormal"
+        has_text_matching:
+          expression: "(?m)^tx_shared\t1\t3$"
+        has_n_lines:
+          n: 4
diff --git a/tools/salmon/test-data/quantmerge-collection.gxwf.yml b/tools/salmon/test-data/quantmerge-collection.gxwf.yml
new file mode 100644
index 0000000000..91323a29ae
--- /dev/null
+++ b/tools/salmon/test-data/quantmerge-collection.gxwf.yml
@@ -0,0 +1,28 @@
+class: GalaxyWorkflow
+label: Merge a collection of Salmon quantifications
+doc: Regression workflow ensuring that quantmerge reduces a list collection to one dataset.
+license: MIT
+creator:
+  - class: Organization
+    name: The galaxytools repository contributors
+    url: https://github.com/bgruening/galaxytools
+
+inputs:
+  quantifications:
+    type: collection
+    collection_type: list
+
+outputs:
+  merged:
+    outputSource: merge/mergedfile
+
+steps:
+  merge:
+    tool_id: salmonquantmerge
+    doc: Preserve collection element names and their corresponding quantification values.
+    state:
+      quants:
+        $link: quantifications
+      column: numreads
+      genes: false
+      missing: 0
