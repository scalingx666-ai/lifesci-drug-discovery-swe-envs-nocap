       - name: install-repo
         run: |
           python -m pip install --upgrade pip
-          pip install pytest pytest-subtests coverage
+          pip install pytest pytest-subtests pytest-cov
           pip install --verbose .
 
       - name: run-pytest
+        run: pytest --cov=bblean --cov-report=json -s -k 'not regression' ./tests
+
+      - name: upload-badge-artifact
+        uses: actions/upload-artifact@v4
+        with:
+          name: coverage-report
+          path: coverage.json
+
+  upload-coverage-badge:
+    runs-on: ubuntu-latest
+    needs: tests
+    if: github.ref == 'refs/heads/main'
+    permissions:
+      contents: write
+    steps:
+      - name: create-site-dir
+        run: mkdir -p site/coverage
+
+      - name: fetch-coverage-report
+        uses: actions/download-artifact@v4
+        with:
+          name: coverage-report
+          path: ./site/coverage/
+
+      - name: generate-coverage-badge
         run: |
-          coverage run -m pytest -s -k 'not regression' ./tests
-          coverage xml
+          COVERAGE=$(jq -r '.totals.percent_covered_display' site/coverage/coverage.json)
+          echo "{\"schemaVersion\":1,\"label\":\"coverage\",\"message\":\"${COVERAGE}%\",\"color\":\"green\"}" > site/coverage/coverage-badge.json
 
-      - name: upload-coverage
-        uses: codecov/codecov-action@v5
+      - name: deploy-badge
+        uses: peaceiris/actions-gh-pages@v4
         with:
-          files: coverage.xml
+          github_token: ${{ secrets.GITHUB_TOKEN }}
+          publish_dir: ./site
+          publish_branch: gh-pages
 
