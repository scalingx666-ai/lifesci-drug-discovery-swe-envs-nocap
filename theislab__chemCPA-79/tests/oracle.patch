+# Config for hyperparameter-tuning CCPA on LINCS, using all embeddings, while keeping AE hparams fixed
+# (part 2 of lincs_rdkit_hparam)
+seml:
+  executable: compert/seml_sweep_icb.py
+  name: lincs_all_emb_hparam
+  output_dir: sweeps/logs
+  conda_environment: chemical_CPA
+  project_root_dir: ../..
+
+slurm:
+  max_simultaneous_jobs: 20
+  experiments_per_job: 1
+  sbatch_options_template: GPU
+  sbatch_options:
+    gres: gpu:1       # num GPUs
+    mem: 32G          # memory
+    cpus-per-task: 6  # num cores
+    # speeds is roughly 3 epochs / minute
+    time: 1-00:01     # max time, D-HH:MM
+###### BEGIN PARAMETER CONFIGURATION ######
+
+fixed:
+  profiling.run_profiler: False
+  profiling.outdir: "./"
+
