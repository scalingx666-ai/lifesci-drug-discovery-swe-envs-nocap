+def get_morgan_rf_pipeline(n_jobs: int = 1) -> Pipeline:
+    """Create a Morgan FP + RandomForest pipeline for testing.
+
+    Parameters
+    ----------
+    n_jobs : int, default 1
+        Number of cores to use.
+
+    Returns
+    -------
+    Pipeline
+        A pipeline based on the Morgan fp and the RF.
+
+    """
