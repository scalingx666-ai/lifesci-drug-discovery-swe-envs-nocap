+            if (nei_layout_idx < 0)
+                continue;
+            SelectionBridge b;
+            b.sel_layout_idx = sel_layout_idx;
+            b.sel_ext_idx = sel_ext_idx;
+            b.fix_layout_idx = nei_layout_idx;
+            b.fix_ext_idx = nei_ext_idx;
+            b.fix_pos = src_layout[nei_layout_idx];
