+LS_THC_Computer::LS_THC_Computer(std::shared_ptr<Molecule> molecule, std::shared_ptr<BasisSet> primary, 
+                                    Options& options) : THC_Computer(molecule, primary, options), auxiliary_(nullptr) {}
