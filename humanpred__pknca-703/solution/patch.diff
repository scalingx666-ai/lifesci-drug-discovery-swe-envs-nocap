+  # The concentrations at the start and end of each interval
+  expect_equal(get_value(0, "cstart"), 0)
+  expect_equal(get_value(0, "ctrough"), 1)
+  expect_equal(get_value(12, "cstart"), 1)
+  expect_equal(get_value(12, "ctrough"), 1.1)
+  # AUMC uses the time since the start of the interval, whether integrated over
+  # the interval's own data (aumclast) or over the group's (aumcint.last)
+  aumc_second <- as.numeric(pk.calc.aumc(conc = d_conc$conc[6:11], time = d_conc$time[6:11] - 12))
+  expect_equal(get_value(12, "aumclast"), aumc_second)
+  expect_equal(get_value(12, "aumcint.last"), aumc_second)
+  expect_equal(get_value(0, "aumcint.last"), get_value(0, "aumclast"))
+  # AUC and Cav do not depend on where time zero is
+  auc_second <- as.numeric(pk.calc.auc(conc = d_conc$conc[6:11], time = d_conc$time[6:11] - 12))
+  expect_equal(get_value(12, "aucint.last"), auc_second)
+  expect_equal(get_value(12, "cav.int.last"), auc_second / 12)
+})
+
+test_that("ctrough and cstart match the interval bounds exactly for a non-integer start, and are NA without a sample there", {
+  d_conc <- data.frame(time = c(0, 1, 2, 4, 8, 12) + 0.3, conc = c(1, 5, 4, 3, 2, 1.5))
+  d_dose <- data.frame(time = 0.3, dose = 1)
+  intervals <-
+    data.frame(start = c(0.3, 1.3), end = c(12.3, 11), ctrough = TRUE, cstart = TRUE)
+  o_data <- PKNCAdata(PKNCAconc(d_conc, conc ~ time), PKNCAdose(d_dose, dose ~ time), intervals = intervals)
+  result <- as.data.frame(suppressWarnings(pk.nca(o_data)))
+  get_value <- function(start, testcd) {
+    result$PPORRES[result$start == start & result$PPTESTCD == testcd]
+  }
+  expect_equal(get_value(0.3, "cstart"), 1)
+  expect_equal(get_value(0.3, "ctrough"), 1.5)
+  expect_equal(get_value(1.3, "cstart"), 5)
+  # No sample at 11
+  expect_equal(get_value(1.3, "ctrough"), NA_real_)
+})
+
+test_that("aumcint.inf.obs matches aumcinf.obs for an interval starting at a later dose", {
+  d_conc <- data.frame(
+    time = c(0, 1, 2, 4, 8, 12, 13, 14, 16, 20, 24),
+    conc = c(0, 5, 4, 3, 2, 1, 5.5, 4.5, 3.2, 2.1, 1.1)
+  )
+  d_dose <- data.frame(time = c(0, 12), dose = 1)
+  intervals <- data.frame(start = 12, end = Inf, aumcinf.obs = TRUE, aumcint.inf.obs = TRUE)
+  o_data <- PKNCAdata(PKNCAconc(d_conc, conc ~ time), PKNCAdose(d_dose, dose ~ time), intervals = intervals)
+  result <- as.data.frame(pk.nca(o_data))
+  expect_equal(
+    result$PPORRES[result$PPTESTCD == "aumcint.inf.obs"],
+    result$PPORRES[result$PPTESTCD == "aumcinf.obs"]
+  )
+})
+
+test_that("calculation functions get the interval's own times relative to its start and the rest on the original scale", {
+  fn_name <- "pknca_test_time_scale_fn_"
+  received <- new.env(parent = emptyenv())
+  assign(
+    fn_name,
+    function(conc, time, time.dose, time.group, time.dose.group, start, end, time.start, time.end) {
+      received$args <-
+        list(
+          time = time, time.dose = time.dose, time.group = time.group,
+          time.dose.group = time.dose.group, start = start, end = end,
+          time.start = time.start, time.end = time.end
+        )
+      1
+    },
+    envir = .GlobalEnv
+  )
+  local_interval_cols()
+  on.exit(rm(list = fn_name, envir = .GlobalEnv), add = TRUE)
+  add.interval.col(
+    "pknca_test_time_scale_col_",
+    FUN = fn_name,
+    unit_type = "conc",
+    pretty_name = "Test: time scale",
+    desc = "Test of the time scale"
+  )
+  d_conc <- data.frame(time = c(0, 2, 12, 14, 24), conc = c(0, 5, 1, 5, 1))
+  d_dose <- data.frame(time = c(0, 12), dose = 1)
+  intervals <- data.frame(start = 12, end = 24, pknca_test_time_scale_col_ = TRUE)
+  o_data <- PKNCAdata(PKNCAconc(d_conc, conc ~ time), PKNCAdose(d_dose, dose ~ time), intervals = intervals)
+  suppressMessages(pk.nca(o_data))
+  expect_equal(
+    received$args,
+    list(
+      time = c(0, 2, 12), time.dose = 0,
+      time.group = c(0, 2, 12, 14, 24), time.dose.group = c(0, 12),
+      start = 12, end = 24,
+      time.start = 0, time.end = 12
+    )
+  )
+})
diff --git a/vignettes/v08-data-imputation.Rmd b/vignettes/v08-data-imputation.Rmd
index e5c67e2b..d8e931cd 100644
--- a/vignettes/v08-data-imputation.Rmd
+++ b/vignettes/v08-data-imputation.Rmd
@@ -175,3 +175,8 @@ In addition to the above, the function may take named arguments of:
 * `start` and `end` to indicate the start and end time of the interval, and
 * `conc.group` and `time.group` to indicate the concentrations and times that
   have not been filtered for the interval.
+
+Imputation functions receive `time`, `start`, `end`, and `time.group` on the
+original time scale of the data.  NCA calculation functions receive `start`,
+`end`, and `time.group` on that scale too, but `time` relative to the start of
+the interval.
diff --git a/vignettes/v80-writing-parameter-functions.Rmd b/vignettes/v80-writing-parameter-functions.Rmd
index 245dde5c..3c194e42 100644
--- a/vignettes/v80-writing-parameter-functions.Rmd
+++ b/vignettes/v80-writing-parameter-functions.Rmd
@@ -36,6 +36,8 @@ The starting point to writing a new NCA parameter is writing the function that c
 * `options` are the PKNCA options used for the current calculation usually as defined by the `PKNCA.options` function (though these options may be over-ridden by the `options` argument to the `PKNCAdata` function.
 * Or, any NCA parameters by name (as given by `names(get.interval.cols())`).
 
+The interval's own times given to the function (`time` and `time.dose`) are relative to the start of the current interval, and a function that returns a time (like Tmax) returns it on the same scale.  `start`, `end`, and the group times (such as `time.group`) are on the original time scale of the data.  A function that compares `time` with the bounds of the interval should map them from `time.start` and `time.end` (the bounds on the scale of `time`, so `time.start` is always 0), as Ctrough does with `formalsmap = list(end = "time.end")`.
+
 The function should return either a scalar which is the value for the parameter (usually the case) or a data.frame with parameters named for each parameter calculated.  For an example of returning a data.frame, see the `half.life` function.
 
 The return value may have an attribute of `exclude` (set by `attr(return_value, "exclude") <- "reason"`).  If the `exclude` attribute is set to a character string, then that string will be included in the `exclude` column for results.  If any of the input parameters have an exclude attribute set, then those are also added to the `exclude` column.  The exception to the setting of the `exclude` column is if the `exclude` attribute is `"DO NOT EXCLUDE"`, then the `exclude` column is set to `NA_character_`.
