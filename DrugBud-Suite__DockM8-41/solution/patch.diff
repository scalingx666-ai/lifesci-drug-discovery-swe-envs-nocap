+        reactive_flexres[out["res_id"]] = out["name"]
+    all_ok &= ok
+    all_err += err
+
+if len(reactive_flexres) > 8:
+    msg = "got %d reactive_flexres but maximum is 8." % (len(args.reactive_flexres))
+    print("Command line error: " + msg, file=sys.stderr)
