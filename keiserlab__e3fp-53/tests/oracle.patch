+@maybe_jit(nopython=True, nogil=True, cache=True)
+def _dense_soergel(X, Y, S):
+    for ix in range(S.shape[0]):
+        for iy in range(S.shape[1]):
+            sum_abs_diff = 0
+            sum_max = 0
+            for j in range(X.shape[1]):
+                diff = X[ix, j] - Y[iy, j]
+                if diff > 0:
+                    sum_abs_diff += diff
+                    sum_max += X[ix, j]
