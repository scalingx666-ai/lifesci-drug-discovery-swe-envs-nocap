+def _has_files_or_valid_symlinks(path: Path) -> bool:
+    has_files = False
+    for p in path.iterdir():
+        if p.is_symlink() and not p.exists():
+            return False
+
+        if p.is_file():
+            has_files = True
+    return has_files
