+        coeff_b = ODE._transformed_coeff_ode(coeff, inv_tf, x)
+        derivs_fun = [inv_tf.deriv, inv_tf.deriv2, inv_tf.deriv3]
+        coeff_b_ref = ODE._transformed_coeff_ode_with_r(coeff, derivs_fun, r)
