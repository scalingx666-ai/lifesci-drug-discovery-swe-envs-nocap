+def maxmin_stratified_train_test_split(
+    data: Sequence[str | Mol],
+    labels: np.ndarray | list[int] | pd.Series,
+    *additional_data: Sequence,
+    train_size: float | None = None,
+    test_size: float | None = None,
+    return_indices: bool = False,
