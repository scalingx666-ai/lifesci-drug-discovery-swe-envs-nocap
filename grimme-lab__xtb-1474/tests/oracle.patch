diff --git a/test/unit/test_fermi.F90 b/test/unit/test_fermi.F90
new file mode 100644
index 000000000..c3270e4e5
--- /dev/null
+++ b/test/unit/test_fermi.F90
@@ -0,0 +1,235 @@
+! This file is part of xtb.
+! SPDX-Identifier: LGPL-3.0-or-later
+!
