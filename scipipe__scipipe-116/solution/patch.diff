+++ b/settings_test.go
@@ -0,0 +1,18 @@
+package scipipe
+
+import (
+	"os"
+	"testing"
+)
+
+func TestGetBufsize(t *testing.T) {
+	initTestLogs()
+
+	wantBufSize := 1234
+	os.Setenv("SCIPIPE_BUFSIZE", "1234")
+	haveBufSize := getBufsize()
+
+	if haveBufSize != wantBufSize {
+		t.Errorf("Got wrong buffert size from getBufsize(): %d, wanted: %d\n", haveBufSize, wantBufSize)
+	}
+}
