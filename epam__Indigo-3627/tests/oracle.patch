+    for (auto sel_layout_idx : sel_vertices)
+    {
+        const int sel_ext_idx = _layout_vertices[sel_layout_idx].ext_idx;
+        const Vertex& vx = getVertex(sel_ext_idx);
+        for (int nei = vx.neiBegin(); nei < vx.neiEnd(); nei = vx.neiNext(nei))
