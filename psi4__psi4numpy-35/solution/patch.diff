+    "    \\lim_{\\alpha\\rightarrow\\infty}\\frac{q \\mathrm{Erf}(\\alpha r)}{4 \\pi \\epsilon_0r} = \\frac{q}{4 \\pi \\epsilon_0 r}\n",
+    "\\end{equation}\n",
