diff --git a/pkgs/by-name/bagel/std-begin.patch b/pkgs/by-name/bagel/std-begin.patch
new file mode 100644
index 00000000..fd06d195
--- /dev/null
+++ b/pkgs/by-name/bagel/std-begin.patch
@@ -0,0 +1,14 @@
+--- a/btas/array_adaptor.h	2026-10-07 15:05:22.782319989 +0200
++++ b/btas/array_adaptor.h	2026-10-07 15:05:22.793319842 +0200
+@@ -164,8 +164,10 @@
+   const T* cbegin(T* x) {
+     return x;
+   }
++  // take the pointer by reference so that arrays do not decay to it
++  // and the overload does not collide with libstdc++'s std::begin(T (&)[N])
+   template <typename T>
+-  T* begin(T* x) {
++  T* begin(T* const& x) {
+     return x;
+   }
+ 
diff --git a/pkgs/by-name/dftbplus/gcc16-capi-visibility.patch b/pkgs/by-name/dftbplus/gcc16-capi-visibility.patch
new file mode 100644
index 00000000..77006f97
--- /dev/null
+++ b/pkgs/by-name/dftbplus/gcc16-capi-visibility.patch
@@ -0,0 +1,15 @@
+GCC 16 gfortran respects the module-level 'private' access specifier for bind(C)
+procedures, causing the C API symbols to be marked HIDDEN in the object file and
+not exported from the shared library. Make the bind(C) procedures public.
+
+--- a/src/dftbp/api/mm/capi.F90
++++ b/src/dftbp/api/mm/capi.F90
+@@ -19,7 +19,7 @@
+   use dftbp_mmapi, only : TDftbPlus, TDftbPlus_destruct, TDftbPlus_init, TDftbPlusAtomList,&
+       & TDftbPlusInput
+   implicit none
+-  private
++  public
+ 
+ 
+   !> DFTB+ input tree
