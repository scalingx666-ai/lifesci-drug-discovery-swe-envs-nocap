+class IOTBXStructure(Structure):
+    def __init__(self, obj, ext='pdb', params={}):
+        """
+        obj must have as_pdb_string method
+        """
+        super(IOTBXStructure, self).__init__()
+        self.path = ''
+        self.ext = ext
+        self.params = params
+        self._mol = obj
+
+    def get_structure_string(self):
+        return self._mol.as_pdb_string()
+
