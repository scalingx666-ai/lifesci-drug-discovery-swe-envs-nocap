+
+    <test expect_num_outputs="1">
+        <conditional name="img_type">
+            <param name="img_type_selector" value="label"/>
+            <conditional name="input_type">
+                <param name="input_type_selector" value="xenium"/>
+                <param name="input_xenium" location="https://zenodo.org/records/20029977/files/Xenium_Prime_MultiCellSeg_Mouse_Ileum_tiny_outs.zip"/>
+                <param name="ref_img" location="https://zenodo.org/records/20029977/files/morphology_tiny.ome.tif"/>
