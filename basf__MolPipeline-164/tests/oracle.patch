diff --git a/.pre-commit-config.yaml b/.pre-commit-config.yaml
new file mode 100644
index 00000000..64c7ede2
--- /dev/null
+++ b/.pre-commit-config.yaml
@@ -0,0 +1,67 @@
+exclude: |
+  (?x)(
+    ^notebooks/|
+    ^$
+  )
+fail_fast: false
+default_stages: [pre-commit, pre-push]
+repos:
+  - repo: https://github.com/pre-commit/pre-commit-hooks
+    rev: v5.0.0
+    hooks:
+      - id: check-case-conflict
+      - id: check-merge-conflict
+      - id: end-of-file-fixer
+      - id: mixed-line-ending
+      - id: trailing-whitespace
+        exclude_types: [tsv]
+        args: [--markdown-linebreak-ext=md]
+
+  - repo: https://github.com/commitizen-tools/commitizen
+    rev: v3.29.1
+    hooks:
+      - id: commitizen
+        stages: [commit-msg]
+
+  - repo: https://github.com/astral-sh/ruff-pre-commit
+    rev: v0.11.2
+    hooks:
+      - id: ruff-format
+        types_or: [python, pyi, jupyter]
+      - id: ruff
+        types_or: [python, pyi, jupyter]
+        args: [ --fix, --exit-non-zero-on-fix, --config, ruff.toml]
+
+
+  - repo: https://github.com/pre-commit/mirrors-prettier
+    rev: v4.0.0-alpha.8
+    hooks:
+      - id: prettier
+        types:
+          - ts
+          - javascript
+          - yaml
+          - markdown
+          - json
+
+  - repo: https://github.com/RobertCraigie/pyright-python
+    rev: v1.1.398
+    hooks:
+      - id: pyright
+        args: [-p, pyproject.toml]
+        verbose: true
+
+  - repo: https://github.com/PyCQA/flake8
+    rev: 7.0.0
+    hooks:
+      - id: flake8
+        additional_dependencies:
+          - docsig==0.69.3
+        args:
+          - --extend-ignore=D203,E203,E501,F401,W5
+          - "--sig-check-class-constructor"
+          - "--sig-check-dunders"
+          - "--sig-check-protected-class-methods"
+          - "--sig-check-nested"
+          - "--sig-check-overridden"
+          - "--sig-check-protected"
