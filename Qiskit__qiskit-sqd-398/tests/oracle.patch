diff --git a/tox.ini b/tox.ini
index c349b21a..1282d75b 100644
--- a/tox.ini
+++ b/tox.ini
@@ -1,7 +1,6 @@
 [tox]
-minversion = 4.4.3
-envlist = py{310,311,312,313,314}{,-notebook}, lint, coverage, docs
-isolated_build = True
+min_version = 4.4.3
+env_list = py{310,311,312,313,314}{,-notebook}, lint, coverage, docs
 
 [testenv]
 package = wheel
@@ -22,9 +21,9 @@ commands =
 
 [testenv:lint]
 image-tester-commit = 7ae965ccf21c39e5170334ec7f4882756883860a
-deps = 
+deps =
   git+https://github.com/Qiskit/documentation.git@{[testenv:lint]image-tester-commit}\#egg=sphinx-alt-text-validator&subdirectory=scripts/image-tester
-basepython = python3.10
+base_python = python3.10
 extras =
   lint
 commands =
@@ -38,7 +37,13 @@ commands =
   nbqa pylint -rn docs/
   reno lint
 
-[testenv:{,py-,py3-,py310-,py311-,py312-,py313-,py314-}notebook]
+# Spelled out deliberately. Writing this as {,py310-,...}notebook does not work: tox
+# expands numeric ranges in a section name before splitting it on braces, so
+# "py310-,...,py314-" parses as "py3" plus the range "10-14". That defines junk
+# environments (py3notebook, 4notebook, ...) and never defines py310-notebook and
+# friends, which then fall through to [testenv] and silently run the unit tests
+# instead of the notebooks.
+[testenv:{notebook,py310-notebook,py311-notebook,py312-notebook,py313-notebook,py314-notebook}]
 # Work around Qiskit/qiskit#17213: with qiskit 2.6.0 these notebooks fail on Linux
 # before any cell runs, with "cannot allocate memory in static TLS block".
 #
@@ -55,7 +60,7 @@ commands =
 # Linux-only: this is a glibc mechanism and macOS has no equivalent limit. Note glibc
 # silently ignores an unrecognized tunable name, so a typo here would look like a
 # working config. Remove this once 17213 is fixed in a release.
-setenv =
+set_env =
   linux: GLIBC_TUNABLES = glibc.rtld.optional_static_tls=4096
 extras =
   nbtest
@@ -81,12 +86,12 @@ commands =
   coverage3 report --fail-under=75 --show-missing
 
 [testenv:docs]
-basepython = python3.10
+base_python = python3.10
 extras =
   docs
 commands =
   sphinx-build -j auto -W -T --keep-going -b html {posargs} {toxinidir}/docs/ {toxinidir}/docs/_build/html
-passenv =
+pass_env =
   CI
   GITHUB_BASE_REF
   GITHUB_REF_NAME
