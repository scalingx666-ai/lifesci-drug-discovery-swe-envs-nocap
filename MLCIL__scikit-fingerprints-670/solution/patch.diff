+    bond_idxs.sort(axis=1)  # a path is a set of bonds, so put the rows in order
+    return Paths(
+        bond_idxs,
+        np.concatenate([half.atom_idxs for half in halves]),
+        np.concatenate([half.end_atoms for half in halves]),
+    )
