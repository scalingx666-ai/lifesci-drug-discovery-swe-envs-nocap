+
+    fn global_atom_index(
+        topology: &Topology,
+        chain_id: &str,
+        residue_id: i32,
+        atom_name: &str,
+    ) -> usize {
+        let mut idx = 0;
+        for chain in topology.structure().iter_chains() {
+            for residue in chain.iter_residues() {
+                for atom in residue.iter_atoms() {
+                    if chain.id == chain_id && residue.id == residue_id && atom.name == atom_name {
+                        return idx;
