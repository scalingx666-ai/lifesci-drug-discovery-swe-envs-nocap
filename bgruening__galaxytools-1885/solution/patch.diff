+++ b/tools/3dtrees_metadata/.shed.yml
@@ -0,0 +1,13 @@
+name: 3dtrees_metadata
+owner: bgruening
+description: Extract administrative and ecoregion metadata for 3Dtrees collections.
+homepage_url: https://github.com/3dTrees-earth/3dtrees_metadata
+long_description: |
+  Extracts administrative and ecoregion context for a 3Dtrees collection summary
+  by computing the collection centroid from collection_summary.json and
+  intersecting it with selected GADM and WWF Terrestrial Ecoregions v2.0 vector
+  datasets.
+remote_repository_url: https://github.com/3dTrees-earth/galaxytools/tree/master/tools/3dtrees_metadata
+type: unrestricted
+categories:
+- "Geo Science"
diff --git a/tools/3dtrees_metadata/3dtrees_metadata.xml b/tools/3dtrees_metadata/3dtrees_metadata.xml
new file mode 100644
index 0000000000..e32ece1f55
--- /dev/null
+++ b/tools/3dtrees_metadata/3dtrees_metadata.xml
@@ -0,0 +1,153 @@
+<tool id="3dtrees_metadata" name="3Dtrees: Metadata" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="24.2">
+    <description>Extract administrative and ecoregion metadata for a point-cloud collection</description>
+    <macros>
+        <token name="@TOOL_VERSION@">1.0.0</token>
+        <token name="@VERSION_SUFFIX@">0</token>
+    </macros>
+    <creator>
+        <person name="Kilian Gerberding" email="kilian.gerberding@geosense.uni-freiburg.de" url="https://orcid.org/0009-0002-5001-2571"/>
+        <organization name="3Dtrees-Team, University of Freiburg" url="https://github.com/3dTrees-earth"/>
+    </creator>
+    <requirements>
+        <container type="docker">ghcr.io/3dtrees-earth/3dtrees_metadata:@TOOL_VERSION@</container>
+    </requirements>
+    <command detect_errors="exit_code"><![CDATA[
+        #set $input_name = 'metadata_input.' + str($input.ext)
+        ln -s '$input' '$input_name' &&
+        python -u /src/run.py
+        #if str($input.ext) == 'json'
+            --collection-summary '$input_name'
+        #else
+            --pointcloud  '$input_name'
+        #end if
+        --metadata-layers '$metadata_layers'
+        --reference-data-dir /reference-data
+        --output-file additional_metadata.json
+        2>&1
+    ]]></command>
+    <inputs>
+        <param name="input" type="data" format="json,las,laz" label="Collection summary or point cloud" help="Use a collection_summary.json with centroid information or a LAS/LAZ point cloud. JSON inputs are read as collection summaries; LAS/LAZ inputs use header bounds as the centroid source."/>
+        <param argument="--metadata-layers" type="select" multiple="true" optional="false" label="Metadata layers to extract" help="Choose at least one metadata layer. Both are selected by default.">
+            <option value="gadm" selected="true">GADM administrative boundaries</option>
+            <option value="ecoregion" selected="true">WWF Terrestrial Ecoregions v2.0</option>
+        </param>
+    </inputs>
+    <outputs>
+        <data name="additional_metadata" format="json" label="Additional Metadata (${metadata_layers})" from_work_dir="additional_metadata.json"/>
+    </outputs>
+    <tests>
+        <test expect_num_outputs="1">
+            <param name="input" value="collection_summary_without_crs.json" ftype="json"/>
+            <param name="metadata_layers" value="gadm,ecoregion"/>
+            <output name="additional_metadata" ftype="json">
+                <assert_contents>
+                    <has_json_property_with_text property="method" text="shapely.centroid(collection.multipolygon_wkt)"/>
+                    <has_json_property_with_value property="matched" value="true"/>
+                    <has_json_property_with_text property="COUNTRY" text="Germany"/>
+                    <has_json_property_with_text property="NAME_4" text="Freiburg im Breisgau"/>
+                    <has_json_property_with_value property="GID_5" value="null"/>
+                    <has_json_property_with_value property="NAME_5" value="null"/>
+                    <has_json_property_with_value property="CC_5" value="null"/>
+                    <has_json_property_with_value property="TYPE_5" value="null"/>
+                    <has_json_property_with_value property="ENGTYPE_5" value="null"/>
+                    <has_json_property_with_text property="ECO_NAME" text="Western European broadleaf forests"/>
+                    <has_json_property_with_value property="BIOME" value="4"/>
+                </assert_contents>
+            </output>
+        </test>
+        <test expect_num_outputs="1">
+            <param name="input" value="collection_summary_with_crs.json" ftype="json"/>
+            <param name="metadata_layers" value="gadm,ecoregion"/>
+            <output name="additional_metadata" ftype="json">
+                <assert_contents>
+                    <has_json_property_with_text property="method" text="collection.centroid"/>
+                    <has_json_property_with_value property="longitude" value="7.85"/>
+                    <has_json_property_with_value property="latitude" value="47.99"/>
+                    <has_json_property_with_value property="reference_layers_checked" value='[{"metadata_layer": "gadm", "dataset": "GADM", "path": "gadm_410.gpkg", "layers_checked": ["gadm_410"]}, {"metadata_layer": "ecoregion", "dataset": "WWF Terrestrial Ecoregions v2.0", "path": "wwf_terr_ecos.shp", "layers_checked": ["wwf_terr_ecos"]}]'/>
+                    <has_json_property_with_text property="metadata_layer" text="gadm"/>
+                    <has_json_property_with_text property="metadata_layer" text="ecoregion"/>
+                    <has_json_property_with_text property="COUNTRY" text="Germany"/>
+                    <has_json_property_with_text property="NAME_4" text="Freiburg im Breisgau"/>
+                    <has_json_property_with_value property="GID_5" value="null"/>
+                    <has_json_property_with_value property="NAME_5" value="null"/>
+                    <has_json_property_with_value property="CC_5" value="null"/>
+                    <has_json_property_with_value property="TYPE_5" value="null"/>
+                    <has_json_property_with_value property="ENGTYPE_5" value="null"/>
+                    <has_json_property_with_text property="ECO_NAME" text="Western European broadleaf forests"/>
+                </assert_contents>
+            </output>
+        </test>
+        <test expect_num_outputs="1">
+            <param name="input" value="mikro.laz" ftype="laz"/>
+            <param name="metadata_layers" value="gadm,ecoregion"/>
+            <output name="additional_metadata" ftype="json">
+                <assert_contents>
+                    <has_json_property_with_text property="method" text="pointcloud.header.bounds"/>
+                    <has_json_property_with_text property="COUNTRY" text="Germany"/>
+                    <has_json_property_with_text property="NAME_4" text="Kippenheim"/>
+                    <has_json_property_with_value property="GID_5" value="null"/>
+                    <has_json_property_with_value property="NAME_5" value="null"/>
+                    <has_json_property_with_value property="CC_5" value="null"/>
+                    <has_json_property_with_value property="TYPE_5" value="null"/>
+                    <has_json_property_with_value property="ENGTYPE_5" value="null"/>
+                    <has_json_property_with_text property="ECO_NAME" text="Western European broadleaf forests"/>
+                </assert_contents>
+            </output>
+        </test>
+    </tests>
+    <help format="markdown"><![CDATA[
+**What it does**
+
+This tool reads a 3Dtrees `collection_summary.json` or LAS/LAZ point cloud,
+resolves a WGS84 centroid, and intersects that point with the selected reference
+layers. If the summary contains centroid longitude/latitude values, the tool uses
+them directly. If not, it computes the centroid from
+`collection.multipolygon_wkt`. If no summary is supplied, it reads the point
+cloud header bounds. GADM provides administrative attributes; WWF Terrestrial
+Ecoregions v2.0 provides raw ecoregion, realm, and biome attributes.
+
+-----
+
+**Input**
+
+- **Collection summary or point cloud**: a `collection_summary.json` produced by
+  the [3DTrees: LAS/LAZ Standardization](https://github.com/bgruening/galaxytools/tree/master/tools/3dtrees_standardization)
+  tool in collection mode, or a LAS/LAZ point cloud.
+  JSON inputs are read as collection summaries; LAS/LAZ inputs use header bounds
+  as the centroid source.
+- **Metadata layers to extract**: one or more internal reference layers. The tool
+  reads the selected reference datasets from the Docker image.
+
+-----
+
+**Output**
+
+The tool writes `additional_metadata.json` with:
+
+- GADM source details and checked layers
+- Collection centroid longitude/latitude in EPSG:4326
+- Whether the centroid matched a GADM feature
+- Raw matched GADM fields for downstream metadata enrichment
+- Raw matched WWF terrestrial ecoregion fields for downstream metadata enrichment
+    ]]></help>
+    <citations>
+        <citation type="bibtex">
+            @misc{3dtrees_metadata,
+              title = {3Dtrees: Metadata},
+              author = {{3Dtrees Project}},
+              year = {2026},
+              url = {https://github.com/3dTrees-earth/3dtrees}
+            }
+        </citation>
+        <citation type="bibtex">
+            @misc{gadm_410,
+              title = {GADM database of Global Administrative Areas, version 4.1},
+              author = {{Global Administrative Areas (GADM)}},
+              year = {2022},
+              url = {https://gadm.org/},
+              note = {Accessed 2026-06-03}
+            }
+        </citation>
+        <citation type="doi">10.1641/0006-3568(2001)051[0933:TEOTWA]2.0.CO;2</citation>
+    </citations>
+</tool>
