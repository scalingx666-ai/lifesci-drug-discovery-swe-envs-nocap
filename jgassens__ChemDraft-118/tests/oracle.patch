+  atomId: string,
+  next: MoleculeObject | undefined
+): NativeAtomSproutHotkeyResult {
+  return next
+    ? { document: nativeMoleculePatched(document, page, molecule, next) }
+    : { document, refusal: nativeSproutFailureReason(molecule, atomId) };
