+def test_optimization_socket_insert_complete_schema_v1(storage_socket: SQLAlchemySocket, session: Session):
+    test_names = [
+        "opt_psi4_benzene",
+        "opt_psi4_fluoroethane_notraj",
+        "opt_psi4_methane",
+        "opt_psi4_methane_sometraj",
