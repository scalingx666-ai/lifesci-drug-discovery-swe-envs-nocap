+            [-0.417651, -1.475314,  0.076637],
+        ]),
+    )
+    forces = np.array([
+        [-0.28561158, -0.48592026, -0.28392327],
+        [-0.05526158, -0.07403455,  0.09665539],
+        [ 0.18824950,  0.39170140,  0.33881928],
