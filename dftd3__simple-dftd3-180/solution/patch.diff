+   call get_dispersion(mol, d3, param, cutoff, er)
+   mol%xyz(ic, iat) = x0 - h
+   call get_dispersion(mol, d3, param, cutoff, el)
+   table(1, 1) = 0.5_wp*(er - el)/h
+   deriv = table(1, 1)
+   prev_deriv = deriv
+
+   do iter = 2, max_tab
