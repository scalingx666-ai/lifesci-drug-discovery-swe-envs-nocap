+        from jpype import JClass
+
+        CDKConstants = JClass("org.openscience.cdk.CDKConstants")
+        Sgroup = JClass("org.openscience.cdk.sgroup.Sgroup")
+        SgroupType = JClass("org.openscience.cdk.sgroup.SgroupType")
