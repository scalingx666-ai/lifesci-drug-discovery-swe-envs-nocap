+        self.assertEqual(len(list1), len(list2))
+        for a, b in zip(list1, list2):
+            self.assertAlmostEqual(a, b, places=places)
+
+    def setUp(self):
+        pass
+
+    def _init_mol(self, molName, ffTypeMethod, chargetuple):
