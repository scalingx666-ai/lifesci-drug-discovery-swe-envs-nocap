+  implicit none
+  character(len=*) :: line
+  integer,intent(out) :: selected
+
+  integer :: i,j,k
+  character(len=1) :: digit
+  character(len=10),parameter :: numbers = '0123456789'
+  character(len=20) :: atom1,atom2
+  integer :: at1,at2,nat
+
+  integer,intent(inout) :: natlist(nat)
+  logical :: rang,stor
+
+  !>-- initialize
+  natlist = 0
+
+  stor = .false.
+  rang = .false.
+
+  atom1 = ''
+  atom2 = ''
