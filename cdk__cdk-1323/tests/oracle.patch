+        assertNothingInCommon(rings, hexane);
+        IAtomContainer unflagged = chain(6);
+        unflagged.addBond(5, 0, IBond.Order.SINGLE);
+        Assertions.assertEquals(6, atoms(rings.match(unflagged)));
+        for (IAtom atom : unflagged.atoms()) {
