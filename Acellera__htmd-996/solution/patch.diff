+    data["city"]        = _ask("  City                : ")
+    data["country"]     = _ask("  Country             : ")
+    data["product"]     = product
+
+    # Send data to the registration server
+    url = "https://www.acellera.com/licensing/htmd/register.php"
+    res = requests.post(url, data=data, timeout=10)
+
