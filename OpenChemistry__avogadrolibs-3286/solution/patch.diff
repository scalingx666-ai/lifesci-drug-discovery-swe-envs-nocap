+double GaussianSet::axisNormalization(double alpha, int l)
+{
+  double doubleFactorial = 1.0;
+  for (int k = 2 * l - 1; k > 1; k -= 2)
+    doubleFactorial *= k;
+  return std::pow(2.0 * alpha / M_PI, 0.75) * std::pow(4.0 * alpha, 0.5 * l) /
+         std::sqrt(doubleFactorial);
+}
