+ShaderProgram& sharedProgram()
+{
+  if (curveProgram == nullptr) {
+    curveVertexShader = new Shader;
+    curveVertexShader->setType(Shader::Vertex);
+    curveVertexShader->setSource(cylinders_vs);
+    curveFragmentShader = new Shader;
