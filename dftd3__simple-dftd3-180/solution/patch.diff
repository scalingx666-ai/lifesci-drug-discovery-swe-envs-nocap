+            deriv = table(iter, order + 1)
+         end if
+      end do
+
+      if (abs(table(iter, iter) - table(iter - 1, iter - 1)) >= 2*err &
+         & .and. iter > 2) then
+         deriv = prev_deriv
+         err = prev_err
+         exit
+      end if
+
+      prev_deriv = deriv
+      prev_err = err
+   end do
+
+   mol%xyz(:, :) = xyz
+   mol%lattice(:, :) = lattice
+
+end subroutine ridders_strain
