diff --git a/packages/ketcher-core/__tests__/application/editor/operations/monomerCreation/AssignAttachmentPointName.test.ts b/packages/ketcher-core/__tests__/application/editor/operations/monomerCreation/AssignAttachmentPointName.test.ts
