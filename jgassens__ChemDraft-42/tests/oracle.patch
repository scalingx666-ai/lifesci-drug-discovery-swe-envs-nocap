@@ -0,0 +1,153 @@
+:root {
+  color-scheme: light;
+  --ink: #111111;
+  --muted: #5f6468;
+  --paper: #fbfaf5;
+  --surface: #ffffff;
+  --line: #d8d8d2;
+  --line-dark: #111111;
+  --blue: #0057ff;
+  --chemdraft: #006b5e;
+  --signal: var(--chemdraft);
+  --font-display: "dunbar-low", "Futura", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
+  --font-text: "dunbar-text", "Avenir Next", "Helvetica Neue", Arial, sans-serif;
+  --font-ui: var(--font-text);
+  font-family: var(--font-text);
+}
+
+* { box-sizing: border-box; }
+
+html { min-height: 100%; background: var(--paper); }
+
+body {
+  min-height: 100%;
+  margin: 0;
+  color: var(--ink);
+  font-size: 16px;
+  font-weight: 480;
+  line-height: 1.55;
+}
+
+a { color: inherit; }
+
+.site-header, .site-footer, main { width: min(1120px, calc(100% - 40px)); margin: 0 auto; }
+
+.site-header, .site-footer {
+  display: flex;
+  align-items: center;
+  justify-content: space-between;
+  gap: 1.5rem;
+}
+
+.site-header { min-height: 92px; border-bottom: 2px solid var(--line-dark); }
+
+.site-footer {
+  min-height: 92px;
+  margin-top: 64px;
+  border-top: 1px solid var(--line);
+  color: var(--muted);
+  font-size: 0.9rem;
+}
+
+.site-nav, .site-footer nav, .action-line {
+  display: flex;
+  align-items: center;
+  gap: clamp(0.85rem, 2vw, 1.5rem);
+  flex-wrap: wrap;
+}
+
+.site-nav a, .site-footer a, .action-line a {
+  color: var(--muted);
+  font-family: var(--font-ui);
+  font-size: 0.76rem;
+  font-weight: 500;
+  letter-spacing: 0.045em;
+  text-decoration: none;
+  text-transform: uppercase;
+}
+
+.site-nav a:hover, .site-footer a:hover, .action-line a:hover, .site-nav a[aria-current="page"] { color: var(--ink); }
+
+.brand { display: inline-flex; align-items: center; gap: 0.8rem; color: var(--ink); text-decoration: none; }
+.brand-mark {
+  display: inline-grid; width: 28px; height: 28px; place-items: center;
+  border: 1px solid var(--blue); background: var(--blue); color: var(--surface);
+  font-family: var(--font-display); font-size: 0.72rem; font-weight: 700; line-height: 1;
+}
+.brand-name { font-size: 0.98rem; font-weight: 600; }
+
+.app-hero { display: grid; gap: 1.1rem; max-width: 860px; padding: clamp(48px, 8vw, 86px) 0 clamp(36px, 6vw, 56px); }
+.hero-heading { display: flex; align-items: center; gap: 1.25rem; }
+.app-icon { width: clamp(72px, 12vw, 112px); height: auto; border: 1px solid var(--line-dark); }
+.index-number {
+  margin: 0; color: var(--muted); font-family: var(--font-ui); font-size: 0.76rem;
+  letter-spacing: 0.045em; text-transform: uppercase;
+}
+.app-hero .index-number, .product-detail .index-number, .principles .index-number { color: var(--signal); }
+h1, h2, p { margin-top: 0; }
+h1 { margin-bottom: 0; font-family: var(--font-display); font-size: clamp(2.8rem, 5.6vw, 4.8rem); font-weight: 520; line-height: 1.04; }
+h2 { margin-bottom: 0; font-family: var(--font-display); font-size: clamp(1.8rem, 4vw, 3.3rem); font-weight: 500; line-height: 1; }
+.lead { max-width: 680px; margin-bottom: 0; color: var(--muted); font-size: 1.05rem; }
+
+.download-box {
+  display: inline-grid; width: fit-content; min-width: 220px; min-height: 56px; place-items: center;
+  padding: 0.9rem 1.25rem; border: 2px solid var(--line-dark); background: var(--signal);
+  box-shadow: 8px 8px 0 var(--line-dark); color: var(--surface); font-family: var(--font-ui);
+  font-size: 0.86rem; font-weight: 700; letter-spacing: 0.045em; text-decoration: none; text-transform: uppercase;
+}
+.download-box:hover { box-shadow: 5px 5px 0 var(--line-dark); transform: translate(2px, 2px); }
+.download-box:focus-visible, a:focus-visible { outline: 3px solid var(--signal); outline-offset: 4px; }
+.release-meta { margin: -0.35rem 0 0; color: var(--muted); font-family: var(--font-ui); font-size: 0.8rem; }
+
+.action-line .repo-link {
+  position: relative; display: inline-grid; grid-template-columns: 18px auto; gap: 0.6rem; align-items: center;
+  min-height: 36px; padding: 0.44rem 0.7rem 0.44rem 0.48rem; border: 1px solid var(--line-dark); background: var(--surface); color: var(--ink);
+}
+.action-line .repo-link::before { content: ""; width: 14px; height: 14px; border: 1px solid var(--line-dark); background: var(--signal); box-shadow: 5px 5px 0 var(--line-dark); }
+.action-line .repo-link:hover { border-color: var(--signal); color: var(--ink); transform: translate(1px, 1px); }
+.action-line .repo-link:hover::before { box-shadow: 3px 3px 0 var(--line-dark); }
+
+.spec-grid {
+  display: grid; grid-template-columns: minmax(280px, 0.9fr) minmax(320px, 1.1fr); gap: clamp(2rem, 6vw, 6rem);
+  align-items: stretch; padding: 0 0 clamp(56px, 8vw, 96px);
+}
+.spec-grid dl { display: grid; margin: 0; border-top: 1px solid var(--line-dark); }
+.spec-grid dl > div { display: grid; grid-template-columns: minmax(90px, 0.45fr) 1fr; gap: 1rem; padding: 1.05rem 0; border-bottom: 1px solid var(--line); }
+dt { color: var(--muted); font-family: var(--font-ui); font-size: 0.74rem; letter-spacing: 0.04em; text-transform: uppercase; }
+dd { margin: 0; color: var(--muted); }
+.download-note { display: grid; align-content: start; gap: 1rem; padding: clamp(1.5rem, 4vw, 3rem); border: 1px solid var(--line-dark); background: var(--surface); box-shadow: 12px 12px 0 color-mix(in srgb, var(--signal) 14%, transparent); }
+.download-note .index-number { color: var(--signal); }
+.download-note p { margin-bottom: 0; color: var(--muted); }
+
+.product-detail, .principles {
+  display: grid; grid-template-columns: 72px minmax(220px, 0.65fr) minmax(260px, 1fr); gap: 1rem;
+  align-items: start; padding: clamp(56px, 8vw, 96px) 0; border-top: 1px solid var(--line);
+}
+.copy-stack { display: grid; gap: 0.9rem; }
+.copy-stack h2 { max-width: 560px; }
+.copy-stack p { max-width: 620px; margin-bottom: 0; color: var(--muted); }
+.detail-list { display: grid; margin: 0; padding: 0; border-top: 1px solid var(--line-dark); list-style: none; }
+.detail-list li { display: grid; grid-template-columns: minmax(92px, 0.45fr) minmax(0, 1fr); gap: 1rem; padding: 1rem 0; border-bottom: 1px solid var(--line); }
+.detail-list strong { color: var(--ink); font-family: var(--font-ui); font-size: 0.74rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
+.detail-list span { color: var(--muted); }
+
+.principles { padding-bottom: 24px; }
+.principles ol { display: grid; gap: 1rem; margin: 0; padding: 0; list-style: none; counter-reset: principle; }
+.principles li { display: grid; grid-template-columns: 44px 1fr; gap: 1rem; align-items: baseline; counter-increment: principle; }
+.principles li::before { content: counter(principle, decimal-leading-zero); color: var(--muted); font-family: var(--font-ui); font-size: 0.74rem; }
+.principles li span { color: var(--muted); }
+.text-link { color: var(--ink); text-underline-offset: 0.18em; }
+
+@media (max-width: 820px) {
+  .site-header, .site-footer { align-items: flex-start; flex-direction: column; justify-content: center; padding: 1rem 0; }
+  .spec-grid, .product-detail, .principles { grid-template-columns: 1fr; }
+  .principles { gap: 1.5rem; }
+}
+
+@media (max-width: 460px) {
+  .site-header, .site-footer, main { width: min(100% - 24px, 1120px); }
+  h1 { font-size: 2.8rem; }
+  .site-nav, .site-footer nav, .action-line { gap: 0.8rem; }
+  .detail-list li, .spec-grid dl > div { grid-template-columns: 1fr; }
+  .hero-heading { align-items: flex-end; gap: 0.8rem; }
+}
