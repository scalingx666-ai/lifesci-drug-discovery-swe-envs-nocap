+         & .and. iter > 2) then
+         deriv = prev_deriv
+         err = prev_err
+         exit
+      end if
+
+      prev_deriv = deriv
+      prev_err = err
+   end do
+
+   mol%xyz(ic, iat) = x0
+
+end subroutine ridders_cartesian
