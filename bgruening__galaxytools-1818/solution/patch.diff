+    <citation type="bibtex">
+      @misc{rag_retriever,
+      author = {RAG Retriever},
+      title = {RAG Retriever - Retrieval-Augmented Generation Document Retrieval},
+      howpublished = {\url{https://github.com/bgruening/galaxytools/tree/master/tools/rag}},
+      year = {2025}
+      }
+    </citation>
+  </citations>
+</tool>
