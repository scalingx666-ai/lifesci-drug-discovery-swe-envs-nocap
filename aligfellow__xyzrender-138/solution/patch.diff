+    g.add_edges_from([(0, 1), (1, 2), (0, 3)])
+    atoms = resolve_atom_indices("L", g)
+    syms = sorted(g.nodes[n]["symbol"] for n in atoms)
+    assert syms == ["C", "C", "H", "O"]
