+test_that("left_join_by_value matches keys of different types by value", {
+  x <- data.frame(g = c(2L, 1L, 2L, 3L), f = factor(c("b", "a", "b", "c"), levels = c("c", "b", "a")), v = 1:4)
+  y <- data.frame(g = c("1", "2"), f = c("a", "b"), w = c("one", "two"))
