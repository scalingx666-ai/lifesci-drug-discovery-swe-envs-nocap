+{
+ "cells": [
+  {
+   "cell_type": "code",
+   "execution_count": 1,
+   "metadata": {
+    "collapsed": true
+   },
+   "outputs": [],
+   "source": [
+    "\"\"\"Tutorial: CEPA0 and CCD\"\"\"\n",
+    "\n",
+    "__author__    = \"Adam S. Abbott\"\n",
+    "__credit__    = [\"Adam S. Abbott\", \"Justin M. Turney\"]\n",
+    "\n",
+    "__copyright__ = \"(c) 2014-2017, The Psi4NumPy Developers\"\n",
