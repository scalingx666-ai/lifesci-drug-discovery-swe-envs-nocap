+    atoms = [
+        ("C", (0.0, 0.0, 0.0)),
+        ("O", (1.2, 0.0, 0.0)),
+        ("N", (2.4, 0.0, 0.0)),
+        ("Na", (0.0, 20.0, 0.0)),
+    ]
+    for i, (sym, pos) in enumerate(atoms):
+        g.add_node(i, symbol=sym, position=pos)
