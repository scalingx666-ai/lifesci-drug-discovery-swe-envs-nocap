+                '([H])C([H])=C1C=3[H])<-N1=C([H])C([H])=C([H])C([H])='
+                'C1C([H])=N->%10C1=C([H])C([H])=C(C([H])=C1[H])C1=C(['
+                'H])C([H])=C(C([H])=C1[H])N1->[Fe+2]23(<-N4=C([H])C(['
