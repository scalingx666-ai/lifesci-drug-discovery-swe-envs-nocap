+    "Topic :: Scientific/Engineering :: Bio-Informatics",
+    "Topic :: Scientific/Engineering :: Chemistry",
+]
+keywords = ["SMILES", "cheminformatics", "chemistry"]
+dependencies = [
+    "networkx >= 3.1",
+]
+
+[project.urls]
+Repository = "https://github.com/pckroon/pysmiles"
+Issues = "https://github.com/pckroon/pysmiles/issues"
+
+[dependency-groups]
+test = [
+    "pylint",
+    "pytest",
+    "coverage[toml]",
+    "pytest-cov",
+    "hypothesis",
+]
+
+[tool.setuptools]
+include-package-data = true
+
+[tool.setuptools.packages.find]
+where = ["."]
+include = ["pysmiles*"]
+namespaces = false
+
+[tool.setuptools_scm]
+
+[tool.pytest]
+addopts = [
+    "--import-mode=importlib",
+]
+testpaths = ["tests"]
+
+[tool.coverage.run]
+branch = true
+source_pkgs = ["pysmiles"]
+omit = [
+    "tests/*",
+    "pysmiles/testhelper.py",
+]
+
+[tool.coverage.report]
+show_missing = true
