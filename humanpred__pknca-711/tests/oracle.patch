diff --git a/NEWS.md b/NEWS.md
index 20bb3cf9..18b6f894 100644
--- a/NEWS.md
+++ b/NEWS.md
@@ -1212,6 +1212,12 @@ the generated intervals:
 
 ## Bug fixes
 
+* Preferred units (`concu_pref`, `doseu_pref`, and the others) with unit
+  columns whose units differ between groups no longer stop `PKNCAdata()` with
+  "arguments imply differing number of rows: 1, 0" when some groups are
+  already in the preferred units.  Those groups now report their own units with
+  a conversion factor of 1, and the others are converted (@billdenney).
+
 * `pk.nca()` with units that differ between groups (for example, a subject
   without a dose, or a unit column) no longer stops with "Can't join ... due
   to incompatible types" when a group column is integer, numeric, or a date:
diff --git a/R/unit-support.R b/R/unit-support.R
index 4e058545..4859ed43 100644
--- a/R/unit-support.R
+++ b/R/unit-support.R
@@ -294,10 +294,8 @@ pknca_units_table.PKNCAdata <- function(concu, ..., conversions = data.frame())
       concu = groups_units_tbl[[concu_col]][i],
       amountu = groups_units_tbl[[amountu_col]][i],
       timeu = groups_units_tbl[[timeu_col]][i],
-      # Note: $units$concu_pref (and amountu_pref, timeu_pref) are only non-NULL
-      # when the original units were specified as scalar values rather than as a
-      # column name.  When units are column-based, preferred unit conversion is
-      # not supported through the _pref scalar mechanism and these will be NULL.
+      # Preferred units are always one value (pknca_set_units()), so every unit
+      # set, including one from unit columns, converts to the same units.
       concu_pref = o_conc$units$concu_pref[1],
       amountu_pref = o_conc$units$amountu_pref[1],
       timeu_pref = o_conc$units$timeu_pref[1],
@@ -305,7 +303,6 @@ pknca_units_table.PKNCAdata <- function(concu, ..., conversions = data.frame())
     )
     if (has_dose) {
       pknca_units_tbl_args$doseu <- groups_units_tbl[[doseu_col]][i]
-      # Same limitation applies to doseu_pref; see concu_pref note above.
       pknca_units_tbl_args$doseu_pref <- o_dose$units$doseu_pref[1]
     }
     pknca_units_tbl_i <- do.call(pknca_units_table, pknca_units_tbl_args)
@@ -314,12 +311,23 @@ pknca_units_table.PKNCAdata <- function(concu, ..., conversions = data.frame())
       pknca_units_tbl_i <- pknca_units_tbl_i[!is.na(pknca_units_tbl_i$PPORRESU), ]
     }
     unit_tables[[i]] <- pknca_units_tbl_i
+  }
+  # A unit set whose units are already the preferred ones has no conversions,
+  # so its table lacks the standardization columns that another set's table
+  # has.  As in pknca_units_table(), its units are the ones to report, with a
+  # factor of 1.
+  has_std <- vapply(X = unit_tables, FUN = function(x) "PPSTRESU" %in% names(x), FUN.VALUE = TRUE)
+  for (i in which(!has_std & any(has_std))) {
+    unit_tables[[i]]$PPSTRESU <- unit_tables[[i]]$PPORRESU
+    unit_tables[[i]]$conversion_factor <- rep(1, nrow(unit_tables[[i]]))
+  }
+  for (i in seq_along(unit_tables)) {
     if (length(groups_cols) > 0) {
       groups_values <- groups_units_tbl[i, groups_cols, drop = FALSE]
       row.names(groups_values) <- NULL
-      ret[[i]] <- cbind(groups_values, pknca_units_tbl_i)
+      ret[[i]] <- cbind(groups_values, unit_tables[[i]])
     } else {
-      ret[[i]] <- pknca_units_tbl_i
+      ret[[i]] <- unit_tables[[i]]
     }
   }
 
diff --git a/tests/testthat/test-unit-support.R b/tests/testthat/test-unit-support.R
index 87588281..ba3f346f 100644
--- a/tests/testthat/test-unit-support.R
+++ b/tests/testthat/test-unit-support.R
@@ -667,3 +667,42 @@ test_that("left_join_by_value matches keys of different types by value", {
     data.frame(g = c(2L, 2L), v = c(1L, 1L), w = c("a", "b"))
   )
 })
+
+test_that("Preferred units with unit columns convert the groups that need it and keep the others", {
+  skip_if_not_installed("units")
+  d_conc <-
+    data.frame(
+      analyte = rep(c("parent", "metabolite"), each = 3), subject = 1,
+      time = rep(c(0, 12, 24), 2), conc = c(4, 10, 2, 8000, 20000, 4000),
+      cu = rep(c("mg/L", "ng/mL"), each = 3), tu = "hr"
+    )
+  o_conc <- PKNCAconc(d_conc, conc~time|analyte + subject, concu = "cu", timeu = "tu", concu_pref = "mg/L")
+  o_data <- PKNCAdata(o_conc, intervals = data.frame(start = 0, end = 24, cmax = TRUE))
+  units_cmax <- o_data$units[o_data$units$PPTESTCD == "cmax", ]
+  expect_equal(units_cmax$analyte, c("parent", "metabolite"))
+  expect_equal(units_cmax$PPORRESU, c("mg/L", "ng/mL"))
+  # The parent is already in the preferred units
+  expect_equal(units_cmax$PPSTRESU, c("mg/L", "mg/L"))
+  expect_equal(units_cmax$conversion_factor, c(1, 0.001))
+  df_nca <- as.data.frame(pk.nca(o_data))
+  expect_equal(df_nca$analyte, c("metabolite", "parent"))
+  expect_equal(df_nca$PPORRES, c(20000, 10))
+  expect_equal(df_nca$PPSTRES, c(20, 10))
+  expect_equal(df_nca$PPSTRESU, c("mg/L", "mg/L"))
+
+  # The same with a dose unit column and preferred dose units
+  d_conc_dose <- data.frame(treatment = rep(c("A", "B"), each = 3), time = rep(c(0, 12, 24), 2), conc = c(4, 10, 2, 4, 10, 2))
+  d_dose <- data.frame(treatment = c("A", "B"), time = 0, dose = c(1, 1000), du = c("mg", "ug"))
+  o_data_dose <-
+    PKNCAdata(
+      PKNCAconc(d_conc_dose, conc~time|treatment, concu = "mg/L", timeu = "hr"),
+      PKNCAdose(d_dose, dose~time|treatment, doseu = "du", doseu_pref = "mg"),
+      intervals = data.frame(start = 0, end = 24, cmax.dn = TRUE)
+    )
+  units_cmax_dn <- o_data_dose$units[o_data_dose$units$PPTESTCD == "cmax.dn" & is.na(o_data_dose$units$treatment_ref), ]
+  expect_equal(units_cmax_dn$PPORRESU, c("(mg/L)/mg", "(mg/L)/ug"))
+  expect_equal(units_cmax_dn$PPSTRESU, c("(mg/L)/mg", "(mg/L)/mg"))
+  expect_equal(units_cmax_dn$conversion_factor, c(1, 1000))
+  df_nca_dose <- as.data.frame(pk.nca(o_data_dose))
+  expect_equal(df_nca_dose$PPSTRES[df_nca_dose$PPTESTCD == "cmax.dn"], c(10, 10))
+})
