+	if (isPluginEnabled(app)) {
+		//@ts-ignore
+		gDataview = app.plugins.plugins.dataview;
+	} else {
+		gDataview;
+		throw new Error(i18n.t('errors.dataview.title'));
+	}
+};
+
+export const clearDataview = () => {
+	gDataview = {};
+};
