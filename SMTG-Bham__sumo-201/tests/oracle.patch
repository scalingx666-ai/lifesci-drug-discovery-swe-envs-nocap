+        )
+        self.ref_labels = {
+            r"\Gamma": (0.0, 0.0, 0.0),
+            "X": (0.5, 0.0, 0.5),
+            "U": (0.625, 0.25, 0.625),
+            "K": (0.375, 0.375, 0.75),
+            "L": (0.5, 0.5, 0.5),
+            "W": (0.5, 0.25, 0.75)
+        }
+
+    def test_castep_parse_break_in_k_path(self):
+        labels = labels_from_cell(self.pt_cell)
