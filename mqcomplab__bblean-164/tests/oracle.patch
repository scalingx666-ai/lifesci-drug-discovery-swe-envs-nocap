+    "import bblean.analysis as analysis\n",
+    "import bblean.similarity as iSIM\n",
+    "import numpy as np\n",
+    "import matplotlib.pyplot as plt\n",
+    "import os\n",
+    "\n",
+    "# Functions to reproduce the figures in the best practices guidelines paper\n",
+    "from best_practices_plots import plot_cluster_refinement, clusters_pop_plot, sampled_MSC, plot_threshold_scan\n",
+    "from best_practices_functions import threshold_scan, recluster_iteration_metrics"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "af053b9d",
+   "metadata": {},
+   "source": [
+    "Let's download some smiles for this example"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 14,
+   "id": "b8bcd3fa",
+   "metadata": {},
+   "outputs": [
+    {
+     "data": {
+      "text/plain": [
+       "0"
+      ]
+     },
+     "execution_count": 14,
+     "metadata": {},
+     "output_type": "execute_result"
+    }
+   ],
+   "source": [
+    "os.system(\"wget -q https://zenodo.org/records/17796465/files/chembl.smi\")"
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 15,
+   "id": "383bef0c-2b46-4d78-b929-4814bfe18c43",
+   "metadata": {
