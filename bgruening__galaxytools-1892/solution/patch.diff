+def reencode_h264(path: Path, crf: int = 23) -> None:
+    tmp = path.with_stem(path.stem + "_tmp")
+    path.rename(tmp)
+    try:
+        subprocess.run(
+            ["ffmpeg", "-y", "-i", str(tmp), "-c:v", "libx264", "-crf", str(crf), "-preset", "fast", str(path)],
+            check=True, capture_output=True,
+        )
+    finally:
+        tmp.unlink(missing_ok=True)
+
