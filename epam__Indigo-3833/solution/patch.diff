+            continue;
+
+        _bmol->addStereocenters(i, MoleculeStereocenters::ATOM_ABS, 0, false);
+        if (MoleculeStereocenters::getMdlParity(*_bmol, i) != parity)
+            _bmol->stereocenters.invertPyramid(i);
+    }
