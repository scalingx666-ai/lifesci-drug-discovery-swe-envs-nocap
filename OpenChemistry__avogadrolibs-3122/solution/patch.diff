+{
+  const std::string complete =
+    "      1   L       1             2.9412494   -0.099967229187    "
+    "0.155916274999\n"
+    "      1   L       2             0.6834831    0.399512826089    "
+    "0.607683718598\n";
+  const std::string missing =
+    "      1   L       1             2.9412494   -0.099967229187    "
+    "0.155916274999\n"
+    "      1   L       2             0.6834831    0.399512826089\n";
