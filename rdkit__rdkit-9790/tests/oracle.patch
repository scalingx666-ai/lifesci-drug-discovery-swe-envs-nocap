+SELECT d.id, d.m, (s.m @= d.m) AS same_mol
+FROM binary_io_mol_src s INNER JOIN binary_io_mol_dst d USING (id)
+ORDER BY d.id;
+ id |               m               | same_mol 
+----+-------------------------------+----------
+  1 | c1ccccc1                      | t
+  2 | C[C@@H]([C@H](C)F)[C@@H](C)Br | t
+  3 |                               | 
+(3 rows)
+
+DROP TABLE binary_io_mol_src, binary_io_mol_dst;
