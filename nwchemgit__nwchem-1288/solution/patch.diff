+                     dumz = dumz + xvv*yvv*dzv(k+mz)*w2r
+  470             continue
+                  elfder(ij,1,ipt) = elfder(ij,1,ipt) + dumx*dijs
+                  elfder(ij,2,ipt) = elfder(ij,2,ipt) + dumy*dijs
+                  elfder(ij,3,ipt) = elfder(ij,3,ipt) + dumz*dijs
+  475          continue
+  480       continue
+c
+         else
+c
+            do 490 iroot = 1,nroots
+               uu = u9(iroot)*aa
+               w0(iroot) = w9(iroot)*znuc
+               tt = 1.0d0/(aa + uu)
+               tx = sqrt(tt)
+               x0 = (aax + uu*cx)*tt
+               y0 = (aay + uu*cy)*tt
+               z0 = (aaz + uu*cz)*tt
+               do 488 i = 1,lit
+                  ni = i
+                  do 486 j = 1,ljt
+                     nj  = j
+                     idx = iroot + (i-1)*nr + (j-1)*nrli
+                     call hnd_sxyz
+                     xv(idx) = xint
+                     yv(idx) = yint
+                     zv(idx) = zint
+  486             continue
+  488          continue
+  490       continue
+c
+            ij = 0
+            do 496 j = 1,maxj
+               jox = (jxa(j)-1)*nrli
+               joy = (jya(j)-1)*nrli
+               joz = (jza(j)-1)*nrli
+               do 495 i = 1,maxi
+                  mx = (ixa(i)-1)*nr + jox
+                  my = (iya(i)-1)*nr + joy
+                  mz = (iza(i)-1)*nr + joz
+                  ij = ij + 1
+                  dumx = 0.0d0
+                  do 494 k = 1,nroots
+                     dumx = dumx
+     1                    + xv(k+mx)*yv(k+my)*zv(k+mz)*w0(k)
+  494             continue
+                  elfder(ij,1,ipt) = elfder(ij,1,ipt) + dumx*dijs
+  495          continue
+  496       continue
+c
+         endif
 c
   500 continue
 c
  6000 continue
- 7000 continue 
+ 7000 continue
 c
