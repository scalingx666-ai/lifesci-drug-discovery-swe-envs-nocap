-
-__global__ void local_optimization_step(
-    float* pose_coords,        // [n_poses, n_atoms, 3] (in/out)
-    float* receptor_coords,    // [n_receptor_atoms, 3]
-    float* receptor_charges,   // [n_receptor_atoms]
