+            <param argument="--gap-height-threshold" type="float" min="0" max="100" value="3" label="Gap height threshold (m)" help="CHM height below which a cell counts as a canopy gap."/>
+            <param argument="--minimum-tree-voxels" type="integer" min="1" max="1000000" value="100" label="Minimum tree voxels" help="Occupied metric voxels a segment needs to be accepted as a tree."/>
+            <param argument="--apex-minimum-height" type="float" min="0" max="100" value="3" label="Minimum apex height (m)" help="A tree's highest point must be strictly above this height."/>
