+        """
+
+        # weighting arrays for the virtual sites should not be changed
+        w1o, w2o, w3o = 1.0, 0.0, 0.0   # SUM SHOULD BE 1
+        w1x, w2x, w3x = -1.0, 1.0, 0.0  # SUM SHOULD BE 0
+        w1y, w2y, w3y = -1.0, 0.0, 1.0  # SUM SHOULD BE 0
