+
+        for (di, dj, dk), pairs in uc_pairs.items():
+            # Determine valid source replica ranges from the constraint:
+            #   ii' = ii + dx_sc*m - di,  0 <= ii' < m  →  di - dx_sc*m <= ii < m + di - dx_sc*m
+            def _valid_range(d_sc: int, rep: int, delta: int) -> range:
