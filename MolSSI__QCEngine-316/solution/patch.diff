+        "dftd3": "Grimme",  # freebie
+        "gamess": "IOWA STATE UNIVERSITY",  # freebie
+        "gcp": "Grimme",  # freebie
+        "mctc-gcp": "Grimme",  # freebie
+        "mp2d": "Beran",  # freebie
+        "nwchem": "E. Apra",  # freebie
