+def test_validate_cpu_gpu_flags():
+    """Test that the validate_cpu_gpu_flags function works as expected."""
+
+    with pytest.raises(exceptions.BadParameter) as error:
+        validate_cpu_gpu_flags(
+            cpu=False,
+            gpu=False,
