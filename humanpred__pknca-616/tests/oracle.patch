+    } else if (exists("interval.cols_sorted", envir = PKNCA:::.PKNCAEnv, inherits = FALSE)) {
+      rm("interval.cols_sorted", envir = PKNCA:::.PKNCAEnv)
+    }
+    rm(list = fn_name, envir = .GlobalEnv)
+  }, add = TRUE)
+
+  add.interval.col(
+    "pknca_test_formalsmap_constant_col_",
+    FUN = fn_name,
