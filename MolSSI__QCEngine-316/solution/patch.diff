+
+    # a scratch file (preferrably output) expected after job if scratch not cleaned up
+    scratch_sample = {
+        "cfour": "*/NEWFOCK",
+        "dftd3": "*/dftd3_geometry.xyz",  # no outfiles
+        "gamess": "*/gamess.dat",
+        "gcp": "*/gcp_geometry.xyz",  # no outfiles
+        "mctc-gcp": "*/gcp_geometry.xyz",  # no outfiles
