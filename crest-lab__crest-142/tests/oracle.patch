+      read (ich,*,iostat=io) dum
+      if (io < 0) exit
+      if (io > 0) cycle
+      if (nat == 0) natref = dum
+      read (ich,*,iostat=io)
+      if (io < 0) exit
+      iosum = 0
+      do i = 1,dum
