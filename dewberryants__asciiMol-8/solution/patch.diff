@@ -18,12 +18,28 @@ def __init__(self):
 
     def parse(self):
         parser = argparse.ArgumentParser()
-        parser.add_argument('XYZFILE', type=str, help='Specify an .xyz file to open and display.')
+        parser.add_argument('XYZFILE', metavar='XYZFILE or SMILES', type=str, help='Specify an .xyz file or a SMILES string (e.g., CC) to open and display.')
         opts = parser.parse_args()
-        with open(opts.XYZFILE, "r") as xyzfile:
