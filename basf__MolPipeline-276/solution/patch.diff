+                    n_jobs=n_jobs,
+                    n_estimators=2,
+                ),
+            ),
+            (
+                "error_reinserter",
+                PostPredictionWrapper(
+                    FilterReinserter.from_error_filter(error_filter, np.nan),
+                ),
+            ),
+        ],
+        n_jobs=n_jobs,
+    )
