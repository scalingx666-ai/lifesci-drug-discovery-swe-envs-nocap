+  const bool stats = d->statsVisible;
+  Clock::time_point tStart;
+  Lap lap;
+  if (stats) {
+    tStart = Clock::now();
+    ++d->rebuildsSincePaint;
+    d->rebuildCoords = true;
+    d->rebuildPlugins.clear();
+    d->rebuildClearMs = 0.0;
+    lap.mark = tStart;
