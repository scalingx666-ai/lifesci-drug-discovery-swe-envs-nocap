+    const original = seed.pages[0].objects[0] as MoleculeObject;
+    const source = { id: "c13", element: "C", isotope: 13, formalCharge: 0, x: 300, y: 300 };
+    const neighbors = [
+      { id: "c1", element: "C", formalCharge: 0, x: 278, y: 300 },
