+# This function checks if required dependencies for this script
+# exist and are executable.
+#
+# arguments: required dependencies to check for.
+check_for_req_deps()
+{
+  for prog in $@; do
+    fullpath=`which $prog`
+    if [ ! -x "$fullpath" ]; then
+      if [ ! -f "$fullpath" ]; then
+        echo "Error: $fullpath not found. Install this program to run this test script."
+      else
+        echo "Error: $fullpath found but not executable. Install this program to run this test script."
+      fi
+      exit 1;
+    fi
+  done
+}
 
