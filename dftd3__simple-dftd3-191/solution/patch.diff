diff --git a/config/template-config.cmake b/config/template-config.cmake
new file mode 100644
index 000000000..0f64702fd
--- /dev/null
+++ b/config/template-config.cmake
@@ -0,0 +1,19 @@
+@PACKAGE_INIT@
+
+set("SDFTD3_WITH_API" @SDFTD3_WITH_API@)
+set("SDFTD3_WITH_OpenMP" @SDFTD3_WITH_OpenMP@)
+set("SDFTD3_USE_MCTCLIB" @SDFTD3_USE_MCTCLIB@)
+
+if(NOT TARGET "@PROJECT_NAME@::@PROJECT_NAME@")
+  include("${CMAKE_CURRENT_LIST_DIR}/@PROJECT_NAME@-targets.cmake")
+
+  include(CMakeFindDependencyMacro)
+
+  if(NOT TARGET "OpenMP::OpenMP_Fortran" AND SDFTD3_WITH_OpenMP)
+    find_dependency("OpenMP")
+  endif()
+
+  if(NOT TARGET "mctc-lib::mctc-lib" AND SDFTD3_USE_MCTCLIB)
+    find_dependency("mctc-lib")
+  endif()
+endif()
diff --git a/config/template-targets.cmake b/config/template-targets.cmake
new file mode 100644
index 000000000..9b9f1b8ca
--- /dev/null
+++ b/config/template-targets.cmake
@@ -0,0 +1,23 @@
+set(CMAKE_IMPORT_FILE_VERSION 1)
+
+set(
+  SDFTD3_INCLUDEDIRS
+  "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_INCLUDEDIR@"
+  "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_INCLUDEDIR@/@module-dir@"
+)
+find_library(
+  SDFTD3_LIBRARIES
+  "@PROJECT_NAME@"
+  PATHS "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_LIBDIR@"
+  NO_DEFAULT_PATH
+)
+set(
+  SDFTD3_DEPENDENCIES
+  "$<$<BOOL:${SDFTD3_USE_MCTCLIB}>:mctc-lib::mctc-lib>"
+  "$<$<BOOL:${SDFTD3_WITH_OpenMP}>:OpenMP::OpenMP_Fortran>"
+)
+
+add_library(@PROJECT_NAME@::@PROJECT_NAME@-lib INTERFACE IMPORTED)
+add_library(@PROJECT_NAME@::@PROJECT_NAME@ ALIAS @PROJECT_NAME@::@PROJECT_NAME@-lib)
+target_link_libraries(@PROJECT_NAME@::@PROJECT_NAME@-lib INTERFACE ${SDFTD3_LIBRARIES} ${SDFTD3_DEPENDENCIES})
+target_include_directories(@PROJECT_NAME@::@PROJECT_NAME@-lib INTERFACE ${SDFTD3_INCLUDEDIRS})
