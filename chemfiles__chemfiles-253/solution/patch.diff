+        CHECK((bonds[3][0] == 2 && bonds[3][1] == 3));
+        CHECK((bonds[4][0] == 2 && bonds[4][1] == 5));
+        CHECK((bonds[5][0] == 3 && bonds[5][1] == 4));
+        CHECK((bonds[6][0] == 4 && bonds[6][1] == 5));
+
+        // [CH2+]C[CH+2]
