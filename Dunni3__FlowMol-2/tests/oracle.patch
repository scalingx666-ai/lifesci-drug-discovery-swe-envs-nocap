+
+        # get the corresponding alpha values for each timepoint
+        alpha_t = self.interpolant_scheduler.alpha_t(t)
+        alpha_t_prime = self.interpolant_scheduler.alpha_t_prime(t)
+
+        # set x_t = x_0
+        for feat in self.canonical_feat_order:
+            if feat == 'e':
+                data_src = g.edata
