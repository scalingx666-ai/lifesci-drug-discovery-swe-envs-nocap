+# Prune test suites, C headers and static libs from site-packages.
+# Keep numpy/_core/tests: numpy.testing imports numpy._core.tests._natype (numpy >= 2.x).
+RUN --mount=type=bind,source=./$MODEL,target=/root/$MODEL,rw \
