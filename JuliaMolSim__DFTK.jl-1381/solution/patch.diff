diff --git a/.cscs-ci/README.md b/.cscs-ci/README.md
new file mode 100644
index 0000000000..05ab401709
--- /dev/null
+++ b/.cscs-ci/README.md
@@ -0,0 +1,16 @@
+This folder contains the necessary logic for GPU CI/CD on CSCS infrastructure.
+
+There is a short list of GitHub users whose actions that will trigger the CI/CD pipeline. These actions are:
+- opening a PR against master
+- writing a comment in a PR with `cscs-ci run Mi300`, `cscs-ci run GH200` or `cscs-ci run GH200, Mi300`
+
+And the privileged users are:
+- abussy
+- mfherbst
+- antoine-levitt
+
+The CI/CD pipelines will be run on CSCS infrastructure for free. Depending on the state of the machines 
+(maintenance, shut-down, etc.), the CI might not run. In this case, the tests can be re-triggered by
+a comment from a privileged user, i.e. `cscs-ci run GH200, Mi300`.
+
+If there is a problem, feel free to raise an issue, or to contact abussy (augustin.bussy@cscs.ch) directly.
diff --git a/.cscs-ci/cscs_gh200.yml b/.cscs-ci/cscs_gh200.yml
new file mode 100644
index 0000000000..9dfc9cd690
--- /dev/null
+++ b/.cscs-ci/cscs_gh200.yml
@@ -0,0 +1,29 @@
+include:
+  - remote: 'https://gitlab.com/cscs-ci/recipes/-/raw/master/templates/v2/.ci-ext.yml'
+
+stages:
+  - build
+  - test
+
+variables:
+  PERSIST_IMAGE_NAME: $CSCS_REGISTRY_PATH/aarch64/dftk-gpu:$CI_COMMIT_SHORT_SHA
+
+build:
+  stage: build
+  extends: .container-builder-cscs-gh200
+  variables:
+    DOCKERFILE: .cscs-ci/docker/Dockerfile.build-gh200
+
+test:
+  stage: test
+  extends: .container-runner-daint-gh200
+  needs: [build]
+  image: $PERSIST_IMAGE_NAME
+  variables:
+    SLURM_JOB_NUM_NODES: 1
+    SLURM_NTASKS: 1
+    SLURM_TIMELIMIT: "01:00:00"
+    SLURM_MPI_TYPE: none
+    CUDA_CACHE_PATH: "/cuda_cache"
+  script:
+    - /usr/local/julia/bin/julia --project="/TestEnv" -e 'using Pkg; Pkg.test("DFTK"; test_args = ["gpu"])'
diff --git a/.cscs-ci/cscs_mi300.yml b/.cscs-ci/cscs_mi300.yml
new file mode 100644
index 0000000000..3cab4c981b
--- /dev/null
+++ b/.cscs-ci/cscs_mi300.yml
@@ -0,0 +1,30 @@
+include:
+  - remote: 'https://gitlab.com/cscs-ci/recipes/-/raw/master/templates/v2/.ci-ext.yml'
+
+stages:
+  - test
+
+test:
+  stage: test
+  extends: .baremetal-runner-beverin-mi300
+  variables:
+    GIT_STRATEGY: fetch
+    SLURM_JOB_NUM_NODES: 1
+    SLURM_NTASKS: 1
+    SLURM_TIMELIMIT: "01:00:00"
+    SLURM_MPI_TYPE: none
+  script:
+
+    # Download Julia fresh for this run
+    - cd $CI_PROJECT_DIR
+    - wget --tries=3 --timeout=60 https://julialang-s3.julialang.org/bin/linux/x64/1.12/julia-1.12.7-linux-x86_64.tar.gz
+    - tar -xzf julia-1.12.7-linux-x86_64.tar.gz
+    - export PATH="$CI_PROJECT_DIR/julia-1.12.7/bin:$PATH"
+    - export JULIA_DEPOT_PATH="$CI_PROJECT_DIR/.julia"
+
+    # Run DFTK GPU tests
+    - julia --project="TestEnv" -e 'using Pkg; Pkg.develop(path=".")'
+    - julia --project="TestEnv" -e 'using Pkg; Pkg.test("DFTK"; test_args = ["gpu"])'
+
+  after_script:
+    - rm -rf $CI_PROJECT_DIR/julia-1.12.7 && rm -rf $CI_PROJECT_DIR/.julia
diff --git a/.cscs-ci/docker/Dockerfile.build-gh200 b/.cscs-ci/docker/Dockerfile.build-gh200
new file mode 100644
index 0000000000..0cad8c36bc
--- /dev/null
+++ b/.cscs-ci/docker/Dockerfile.build-gh200
@@ -0,0 +1,21 @@
+# Use and existing Julia image as a base
+FROM docker.io/library/julia:1.12 AS builder
+
+RUN mkdir -p /cuda_cache
+ENV CUDA_CACHE_PATH=/cuda_cache
+
+COPY . /dftk_source
+WORKDIR /dftk_source
+
+# Add CUDA and precompile DFTK. Set CUDA version for insured Libxc_GPU_jll availability.
+RUN julia --project="/TestEnv" -e '\
+    using Pkg; \
+    Pkg.add("CUDA"); \
+    using CUDA; \
+    CUDA.set_runtime_version!(v"13.0");'
+
+# DFTKCUDAExt cannot be precompiled here, because NVIDIA drivers are lacking
+RUN julia --project="/TestEnv" -e '\
+    using Pkg; \
+    Pkg.develop(path="/dftk_source"); \
+    using DFTK;'
