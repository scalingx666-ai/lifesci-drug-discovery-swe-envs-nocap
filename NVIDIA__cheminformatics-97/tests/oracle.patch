+            with closing(sqlite3.connect(self.chembl_db, uri=True)) as con, con, \
+                    closing(con.cursor()) as cur:
+                select_stmt = '''
+                    SELECT count(*)
+                    FROM compound_structures cs
+                    WHERE canonical_smiles = ?
+                '''
