+    ep1 = c["endpoint1"]["monomerId"]
+    ep2 = c["endpoint2"]["monomerId"]
+    if ep1 in selected_ids and ep2 in selected_ids:
+        adj_cp[ep1].add(ep2)
+        adj_cp[ep2].add(ep1)
+
