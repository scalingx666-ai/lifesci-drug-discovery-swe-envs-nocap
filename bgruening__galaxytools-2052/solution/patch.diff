     <command detect_errors="aggressive"><![CDATA[
+## The pipeline writes several files next to its inputs (e.g. an extended bed
+## file, a fasta index) and Galaxy datasets live on a read-only filesystem.
+## Link the relevant inputs into the writable working directory first, so that
+## those sidecar files are created next to the links and not next to the
+## datasets themselves.
 ln -s '$bam_file' ./bam_file.bam
 &&
+ln -s '$motif_coords' ./motif_coords.bed
+&&
+#if $refGenomeSource.genomeSource == "history":
+    ## samtools faidx writes the .fai index next to the fasta file.
+    ln -s '$refGenomeSource.ownFile' ./genome.fa
+#end if
+&&
+## footprint 1.0.1 ships the protocol bias profiles in
+## share/footprint-pipeline/ of the conda package. Resolve that directory
+## relative to the find_footprints.sh executable rather than \$CONDA_PREFIX,
+## which is not guaranteed to be exported on every job destination.
+#if str($bias_source.bias_source_selector) == "bundled":
+    bias_file_resolved="\$(dirname \$(dirname \$(readlink -f \$(command -v find_footprints.sh))))/share/footprint-pipeline/SeqBias_${bias_source.bias_file_bundled}.txt"
+#else
+    bias_file_resolved='$bias_source.bias_file'
+#end if
+&&
 find_footprints.sh
     ./bam_file.bam
     '$chrom_sizes'
-    '$motif_coords'
-    ## genome source
+    ./motif_coords.bed
     #if $refGenomeSource.genomeSource == "history":
-        '$refGenomeSource.ownFile'
+        ./genome.fa
     #else
         '$refGenomeSource.builtin.fields.path'
     #end if
     '$factor_name'
-    '$bias_file'
+    "\$bias_file_resolved"
     '$peak_file'
     $no_of_components
     $background
