+    #[track_caller]
+    fn assert_rgba_near(pixels: &image::RgbaImage, (x, y): (u32, u32), expected: [u8; 4]) {
+        let actual = pixels.get_pixel(x, y).0;
+        assert!(
+            actual
+                .iter()
+                .zip(expected)
+                .all(|(actual, expected)| actual.abs_diff(expected) <= 2),
+            "pixel ({x}, {y}) is {actual:?}, expected {expected:?}"
+        );
+    }
