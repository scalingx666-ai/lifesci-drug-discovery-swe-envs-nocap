+        end
+        return libxc_combine_spins(δVτ1, δVτ2)
+    end
+end
+@views function libxc_assemble_δVl(Vρl, δρ, Vσl, δσ, Vlτ, δτ, Vll, δl)
+    if size(δρ, 1) == 1
