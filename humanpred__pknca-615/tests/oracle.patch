+  o_dose <- PKNCAdose(d_dose, dose ~ time | ID)
+  o_data <-
+    PKNCAdata(
+      o_conc, o_dose,
+      intervals = data.frame(start = 0, end = 24, erint = TRUE, erlst = TRUE, ae = TRUE)
