+	for (std::vector<VirtualMol>::iterator it=linker_frags.begin(); it!=linker_frags.end(); ++it) {
+		PseudoAtom collapsed = simplified_net.CollapseFragment(*it);
+		simplified_net.SetRoleToAtom("linker", collapsed);
+	}
