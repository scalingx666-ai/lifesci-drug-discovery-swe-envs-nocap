+
+        // we do not belong to a molecule
+        if (atom.getContainer() == null)
+            return false;
+
+        // we already have coordinates
+        if (atom.getPoint2d() != null)
+            return false;
+
+        List<IAtom> candidates = new ArrayList<>();
+        for (IBond bond : atom.bonds()) {
+            IAtom nbor = bond.getOther(atom);
