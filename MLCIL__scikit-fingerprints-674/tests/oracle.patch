+    def get_prop_weighted_matrix(self, weights: np.ndarray) -> csr_matrix:
+        """
+        Return the same bonds, carrying the given weights.
+        """
+        return csr_matrix(
+            (weights[self._csr_bond_idxs], self._indices, self._indptr),
+            shape=self.shape,
         )
