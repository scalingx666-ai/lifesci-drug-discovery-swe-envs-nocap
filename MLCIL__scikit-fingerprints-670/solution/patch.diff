+def _grow_paths(paths: Paths, subgraphs: Subgraphs) -> Paths:
+    """
+    Extend every path by one bond, at either of its two ends.
+    """
+    halves = [_grow_at_end(paths, subgraphs, end) for end in (0, 1)]
