+      engine.plugin->process(*mol, *engine.node);
+    }
+    if (stats)
+      d->rebuildPlugins.emplace_back(engine.plugin->name(), lap());
+  }
+  if (stats)
+    lap.reset();
+  for (const Private::ToolNode& tool : tools) {
+    if (!tool.tool)
