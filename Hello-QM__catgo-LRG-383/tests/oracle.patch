+# Resolve OUT to an absolute path BEFORE cd-ing into the temp workdir — a relative
+# OUT would otherwise land inside $WORK and be deleted by the trap below.
+mkdir -p "$OUT"
+OUT="$(cd "$OUT" && pwd)"
+
 WORK="$(mktemp -d)"
