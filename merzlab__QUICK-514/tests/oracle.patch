diff --git a/src/dnc/mfcc_fragment_scf.f90 b/src/dnc/mfcc_fragment_scf.f90
index 0a76a98aa..5d19ac050 100644
--- a/src/dnc/mfcc_fragment_scf.f90
+++ b/src/dnc/mfcc_fragment_scf.f90
@@ -60,6 +60,7 @@ subroutine mfcc_fragment_scf(ierr)
    logical :: MPIsaved, mastersaved, real_master
    integer :: myrank, nranks
    integer :: commsaved, ranksaved, sizesaved
+   integer :: gpuranksaved, gpusizesaved
    integer :: nd1, nd2, nd3, nc1, nc2, nc3
    logical :: do_rpt
    double precision, allocatable :: xyzsaved(:,:)
@@ -123,6 +124,24 @@ subroutine mfcc_fragment_scf(ierr)
       quick_comm_rank = 0
       quick_comm_size = 1
       master = .true.
+
+      ! gpu->mpi_comm_rank/size are a separate C-side copy (set once at job
+      ! start by mgpu_init_device, main.f90) that mgpu_eri_greedy_distribute/
+      ! mgpu_oei_greedy_distribute key off of to split shell pairs across
+      ! ranks. Left at their original (rank, N) values here, each rank would
+      ! keep computing only its own ~1/N slice of every fragment's own
+      ! two-electron integrals, with no real reduction left under
+      ! MPI_COMM_SELF to recombine the rest: every fragment's Fock build
+      ! silently loses (N-1)/N of its 2e contribution. Confirmed via
+      ! debug instrumentation in mgpu_eri_greedy_distribute (tot_pcore for
+      ! this rank consistently ~nitems/4 on a 4-rank cudampi Trp-cage MFCC
+      ! run, 2026-11-04) before this was understood or fixed.
+#if defined(GPU) || defined(MPIV_GPU)
+      if (quick_method%bGPU) then
+         call mgpu_get_rank_size(gpuranksaved, gpusizesaved)
+         call mgpu_set_rank_size(0, 1)
+      endif
+#endif
    endif
 #endif
    quick_method%HF = .true.
@@ -426,6 +445,10 @@ subroutine mfcc_fragment_scf(ierr)
       quick_comm_rank = ranksaved
       quick_comm_size = sizesaved
 
+#if defined(GPU) || defined(MPIV_GPU)
+      if (quick_method%bGPU) call mgpu_set_rank_size(gpuranksaved, gpusizesaved)
+#endif
+
       nd1 = size(mfccdens,1); nd2 = size(mfccdens,2); nd3 = size(mfccdens,3)
       call mfcc_reduce_dens(mfccdens,    nd1,nd2,nd3)
       call mfcc_reduce_dens(mfccdenscap, nd1,nd2,nd3)
diff --git a/src/gpu/cuda/mgpu.h b/src/gpu/cuda/mgpu.h
index da1a08c99..f03f9e8c2 100644
--- a/src/gpu/cuda/mgpu.h
+++ b/src/gpu/cuda/mgpu.h
@@ -56,6 +56,30 @@ extern "C" void mgpu_query_(int *mpi_comm_rank, int *mgpu_id, int* ierr)
 }
 
 
+//-----------------------------------------------
+// Get/set the rank and size that the greedy ERI/OEI distributors key off
+// of. gpu->mpi_comm_rank/size are set once, at job start, from the real
+// MPI communicator. Code that temporarily solves independent sub-problems
+// under a different (e.g. MPI_COMM_SELF) communicator -- such as
+// mfcc_fragment_scf, where each rank solves its own standalone fragment --
+// must override these too, or mgpu_eri_greedy_distribute keeps splitting
+// each fragment's own shell pairs across the original N-way partition and
+// every rank silently keeps only its own ~1/N share, with no real
+// cross-rank reduction left to recombine the rest.
+//-----------------------------------------------
+extern "C" void mgpu_get_rank_size_(int *mpi_comm_rank, int *mpi_comm_size)
+{
+    *mpi_comm_rank = gpu->mpi_comm_rank;
+    *mpi_comm_size = gpu->mpi_comm_size;
+}
+
+extern "C" void mgpu_set_rank_size_(int *mpi_comm_rank, int *mpi_comm_size)
+{
+    gpu->mpi_comm_rank = *mpi_comm_rank;
+    gpu->mpi_comm_size = *mpi_comm_size;
+}
+
+
 //-----------------------------------------------
 // Initialize the devices
 //-----------------------------------------------
diff --git a/src/gpu/hip/mgpu.h b/src/gpu/hip/mgpu.h
index 8239456f1..f1ced60cc 100644
--- a/src/gpu/hip/mgpu.h
+++ b/src/gpu/hip/mgpu.h
@@ -56,6 +56,31 @@ extern "C" void mgpu_query_(int *mpi_comm_rank, int *mgpu_id, int* ierr)
 }
 
 
+//-----------------------------------------------
+// Get/set the rank and size that the greedy ERI/OEI distributors key off
+// of. Mirrors src/gpu/cuda/mgpu.h -- see that file for why this is needed:
+// code that temporarily solves independent sub-problems under a different
+// (e.g. MPI_COMM_SELF) communicator, such as mfcc_fragment_scf, must
+// override gpu->mpi_comm_rank/size too, or the greedy distributors keep
+// splitting each sub-problem's own work across the original N-way
+// partition. Added so mfcc_fragment_scf.f90's call to this pair (guarded
+// by the same #if defined(GPU) || defined(MPIV_GPU) as the CUDA path)
+// still links for a HIP+MPI build, even though that bug was only actually
+// observed and fixed on CUDA+MPI.
+//-----------------------------------------------
+extern "C" void mgpu_get_rank_size_(int *mpi_comm_rank, int *mpi_comm_size)
+{
+    *mpi_comm_rank = gpu->mpi_comm_rank;
+    *mpi_comm_size = gpu->mpi_comm_size;
+}
+
+extern "C" void mgpu_set_rank_size_(int *mpi_comm_rank, int *mpi_comm_size)
+{
+    gpu->mpi_comm_rank = *mpi_comm_rank;
+    gpu->mpi_comm_size = *mpi_comm_size;
+}
+
+
 //-----------------------------------------------
 // Initialize the devices
 //-----------------------------------------------
