+        jit(vmap(func, in_axes=(0, 0))),
+        jit(vmap(grad(func, argnums=0), in_axes=(0, 0))),
+        jit(vmap(jacfwd(grad(func, argnums=0), argnums=0), in_axes=(0, 0))),
+    )
