+      x: object.x + (16 - minX), y: object.y + (16 - minY),
+      ...(object.type === "molecule" ? { atoms: object.atoms.map(atom => ({ ...atom,
+        x: atom.x + (16 - minX), y: atom.y + (16 - minY) })) } : {})
+    })));
+  });
+});
