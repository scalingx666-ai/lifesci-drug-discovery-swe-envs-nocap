diff --git a/tools/webatlas/build_config.xml b/tools/webatlas/build_config.xml
new file mode 100644
index 0000000000..303573d80a
--- /dev/null
+++ b/tools/webatlas/build_config.xml
@@ -0,0 +1,449 @@
+<tool id="webatlas_build_config" name="WebAtlas Build Vitessce Config" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE_VERSION@">
+    <description>from AnnData and image Zarr inputs</description>
+    <macros>
+        <import>macros.xml</import>
+    </macros>
+    <expand macro="requirements"/>
+    <command detect_errors="exit_code"><![CDATA[
+        cat $images_script &&
+        python '$images_script' &&
+        cat $options_script &&
+        python '$options_script' &&
+        build_config.py
+        --project '$project'
+        --dataset '$dataset'
+        --file_paths '["/api/datasets/${__app__.security.encode_id($input_file_path.id)}/extra_files/raw/$input_file_path.metadata.store_root/"]'
+        --images "\$(cat images.json)"
+        --url '${__app__.config.galaxy_infrastructure_url}'
+        --options "\$(cat options.json)"
+        --layout '$layout'
+        #if $custom_layout:
+            --custom_layout '$custom_layout'
+        #end if
+        #if $title:
+            --title '$title'
+        #end if
+        #if $description:
+            --description '$description'
+        #end if
+        #if $config_filename_suffix:
+            --config_filename_suffix '$config_filename_suffix'
+        #end if
+        &&
+        mv '${project}-${dataset}-${config_filename_suffix}'* '$output_json'
+    ]]></command>
+<configfiles>
+<configfile name="images_script"><![CDATA[
+import json
+
+images = {"raw": [], "label": []}
+
+#if $sec_label_img.input_image_label and $sec_label_img.input_metadata_label and $sec_label_img.image_name_label
+label_zarr_path = "/api/datasets/${__app__.security.encode_id($sec_label_img.input_image_label.id)}/extra_files/raw/${sec_label_img.input_image_label.metadata.store_root}/"
+label_metadata_path = "${sec_label_img.input_metadata_label}"
+label_image_name = "${sec_label_img.image_name_label}"
+
+with open(label_metadata_path) as md_file:
+    label_md = json.load(md_file)
+
+images["label"].append({
+    "path": label_zarr_path,
+    "name": f"{label_image_name}-label",
+    "md": label_md
+})
+#end if
+
+#if $sec_raw_img.input_image_raw and $sec_raw_img.input_metadata_raw and $sec_raw_img.image_name_raw
+raw_zarr_path = "/api/datasets/${__app__.security.encode_id($sec_raw_img.input_image_raw.id)}/extra_files/raw/${sec_raw_img.input_image_raw.metadata.store_root}/"
+raw_metadata_path = "${sec_raw_img.input_metadata_raw}"
+raw_image_name = "${sec_raw_img.image_name_raw}"
+
+with open(raw_metadata_path) as md_file:
+    raw_md = json.load(md_file)
+
+images["raw"].append({
+    "path": raw_zarr_path,
+    "name": f"{raw_image_name}-raw",
+    "md": raw_md
+})
+#end if
+
+clean_dict = {}
+for key, value in images.items():
+    if value:
+        clean_dict[key] = value
+images = clean_dict
+
+with open("images.json", "w") as file:
+    json.dump(images, file)
+]]>
+</configfile>
+<configfile name="options_script"><![CDATA[
+import json
+
+options = {}
+
+spatial = "${sec_vitessce_options.spatial}".strip()
+factors= "${sec_vitessce_options.factors}".strip()
+sets = "${sec_vitessce_options.sets}".strip()
+matrix = "${sec_vitessce_options.matrix}".strip()
+
+## spatial
+if spatial:
+    options["spatial"] = {
+        "xy": f"obsm/{spatial}"
+    }
+
+## mappings
+mappings = {}
+
+#if $sec_vitessce_options.sec_mappings_spatial.mappings_spatial == "true" and $sec_vitessce_options.spatial:
+spatial_dim1 = "${sec_vitessce_options.sec_mappings_spatial.spatial_dim1}"
+spatial_dim2 = "${sec_vitessce_options.sec_mappings_spatial.spatial_dim2}"
+if spatial_dim1 != "" and spatial_dim2 != "":
+    mappings[f"obsm/{spatial}"] = [int(spatial_dim1), int(spatial_dim2)]
+#end if
+
+#if $sec_vitessce_options.sec_mappings_pca.pca_value:
+pca_value = "${sec_vitessce_options.sec_mappings_pca.pca_value}"
+pca_dim1 = "${sec_vitessce_options.sec_mappings_pca.pca_dim1}"
+pca_dim2 = "${sec_vitessce_options.sec_mappings_pca.pca_dim2}"
+if pca_dim1 != "" and pca_dim2 != "":
+    mappings[f"obsm/{pca_value}"] = [int(pca_dim1), int(pca_dim2)]
+#end if
+
+#if $sec_vitessce_options.sec_mappings_umap.umap_value:
+umap_value = "${sec_vitessce_options.sec_mappings_umap.umap_value}"
+umap_dim1 = "${sec_vitessce_options.sec_mappings_umap.umap_dim1}"
+umap_dim2 = "${sec_vitessce_options.sec_mappings_umap.umap_dim2}"
+if umap_dim1 != "" and umap_dim2 != "":
+    mappings[f"obsm/{umap_value}"] = [int(umap_dim1), int(umap_dim2)]
+#end if
+
+if mappings:
+    options["mappings"] = mappings
+
+## factors
+if factors:
+    options["factors"] = [f"obs/{f.strip()}" for f in factors.split(",") if f.strip()]
+
+## sets
+if sets:
+    parsed_sets = []
+
+    for s in sets.split(","):
+        s = s.strip()
+        if not s:
+            continue
+
+        if ":" in s:
+            name, score = [x.strip() for x in s.split(":", 1)]
+            parsed_sets.append({"name": f"obs/{name}","score": f"obs/{score}"})
+        else:
+            parsed_sets.append(f"obs/{s}")
+    if parsed_sets:
+        options["sets"] = parsed_sets
+
+## matrix
+if matrix:
+    options["matrix"] = matrix
+
+with open("options.json", "w") as file:
+    json.dump(options, file, indent=2)
+]]>
+</configfile>
+</configfiles>
