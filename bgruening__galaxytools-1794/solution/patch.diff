+                <expand macro="sanitizer_options"/>
+            </param>
+            <section name="sec_mappings_spatial" title="Spatial mapping">
+                <param name="mappings_spatial" type="boolean" checked="false" optional="true" label="Include spatial in scatterplot" help="Provide values for the following 2 dimensions if you choose 'Yes' here."/>
+                <param name="spatial_dim1" type="integer" value="" optional="true" label="Spatial dimension 1" help="Dimension to be plotted on the x-axis."/>
+                <param name="spatial_dim2" type="integer" value="" optional="true" label="Spatial dimension 2" help="Dimension to be plotted on the y-axis."/>
+            </section>
+            <section name="sec_mappings_pca" title="PCA mapping">
+                <param name="pca_value" type="text" value="" optional="true" label="Where the PCA is stored" help="Includes PCA in scatterplot. Example: 'X_pca'. 'obsm/' gets prepended automatically. Provide values for the following 2 dimensions if enter a value here.">
+                    <expand macro="sanitizer_options"/>
+                </param>
+                <param name="pca_dim1" type="integer" value="" optional="true" label="PCA dimension 1" help="Dimension to be plotted on the x-axis(e.g. PC1)"/>
+                <param name="pca_dim2" type="integer" value="" optional="true" label="PCA dimension 2" help="Dimension to be plotted on the y-axis(e.g. PC2)"/>
+            </section>
+            <section name="sec_mappings_umap" title="UMAP mapping">
+                <param name="umap_value" type="text" value="" optional="true" label="Where the UMAP is stored" help="Includes UMAP in scatterplot. Example: 'X_umap'. 'obsm/' gets prepended automatically. Provide values for the following 2 dimensions if you enter a value here.">
+                    <expand macro="sanitizer_options"/>
+                </param>
+                <param name="umap_dim1" type="integer" value="" optional="true" label="UMAP dimension 1" help="Dimension to be plotted on the x-axis."/>
+                <param name="umap_dim2" type="integer" value="" optional="true" label="UMAP dimension 2" help="Dimension to be plotted on the y-axis."/>
+            </section>
+            <param name="factors" type="text"  value="" optional="true" label="Factors" help="Comma-separated list of 'obs' fields to show when hovering over cells in the visualization. Example input: sample. 'obs/' gets prepended automatically.">
+                <sanitizer invalid_char="">
+                    <valid initial="string.ascii_letters,string.digits">
+                        <add value="_"/>
