+def _cjson_unit_cell(root: dict) -> np.ndarray | None:
+    """Extract a ``(3, 3)`` row-vector lattice from a CJSON ``unitCell`` block."""
+    cell = root.get("unitCell")
+    if not isinstance(cell, dict):
+        cell = root.get("unit cell")
+    if not isinstance(cell, dict):
+        return None
