+def sanitize_mol(mol: Chem.Mol, verbose=False) -> Chem.Mol:
+    # Ensure the charges are "standardized"
+    uncharger = Uncharger()
+    if not verbose:
+        rdBase.DisableLog('rdApp.info')
+    mol = uncharger.uncharge(mol)
+    if not verbose:
+        rdBase.EnableLog('rdApp.info')
+    return mol
+
+
