+   },
+   "outputs": [],
+   "source": [
+    "\"\"\"Tutorial: Symmetry-Adapted Perturbation Theory (SAPT0)\"\"\"\n",
+    "\n",
+    "__author__    = [\"Daniel G. A. Smith\", \"Konrad Patkowski\"]\n",
+    "__credit__    = [\"Daniel G. A. Smith\", \"Konrad Patkowski\"]\n",
+    "\n",
