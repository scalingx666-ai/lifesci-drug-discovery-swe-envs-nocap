+                )
+            min_p = np.min(points)
+            if domain[0] - 1e-7 >= min_p:
+                raise ValueError(
+                    f"point coordinates should not be below domain! {min_p < domain[0]}"
+                )
+            max_p = np.max(points)
+            if domain[1] + 1e-7 <= max_p:
+                raise ValueError(
