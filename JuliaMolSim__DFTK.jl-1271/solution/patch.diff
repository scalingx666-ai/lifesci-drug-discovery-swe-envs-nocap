+        δVl2 .+= @. Vσl[2,:] * δσ[1,:] + Vσl[4,:] * δσ[2,:] + Vσl[6,:] * δσ[3,:]
+        δVl1 .+= @. Vlτ[1,:] * δτ[1,:] + Vlτ[2,:] * δτ[2,:]
+        δVl2 .+= @. Vlτ[3,:] * δτ[1,:] + Vlτ[4,:] * δτ[2,:]
+        δVl1 .+= @. Vll[1,:] * δl[1,:] + Vll[2,:] * δl[2,:]
+        δVl2 .+= @. Vll[2,:] * δl[1,:] + Vll[3,:] * δl[2,:]
+        return libxc_combine_spins(δVl1, δVl2)
+    end
+end
