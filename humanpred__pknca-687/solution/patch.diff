+  # Cholesky (FA0) scale, where the optimum is stationary; the dense
+  # computation on that scale agrees.
+  w <- fda_work(generate_be_replicate(48, 7, "full", cv_wr = 0.3, cv_wt = 0.5))
+  m <- .be_fda_mixed(w)
