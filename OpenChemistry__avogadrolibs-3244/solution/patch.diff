+TEST(CommandRegistryTest, requiredAndDefaults)
+{
+  Molecule mol = makeMolecule();
+  Harness h;
+  h.add("c",
+        { CommandArgumentSpec::real("value", "v").withRequired(),
+          CommandArgumentSpec::enumeration("mode", "m", { "replace", "add" })
+            .withDefault("replace"),
