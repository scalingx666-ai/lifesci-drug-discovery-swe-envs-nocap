+    with pytest.raises(ValueError, match="Charge/multiplicity/solvent"):
+        _ = NullImagePair(mol1, mol2)
+    mol1.solvent = None
+
+    # different atom order should also raise Error
+    with pytest.raises(ValueError, match="order of atoms"):
