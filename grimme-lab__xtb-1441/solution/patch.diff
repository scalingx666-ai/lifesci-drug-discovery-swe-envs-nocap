diff --git a/test/unit/test_optimizer.f90 b/test/unit/test_optimizer.f90
new file mode 100644
index 000000000..8b6eec3b4
--- /dev/null
+++ b/test/unit/test_optimizer.f90
@@ -0,0 +1,137 @@
+! This file is part of xtb.
+! SPDX-Identifier: LGPL-3.0-or-later
