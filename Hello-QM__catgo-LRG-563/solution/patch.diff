+    expect(result.structures.map((entry) => entry.id)).toEqual([`JVASP-1`])
+    expect(fetch_mock).toHaveBeenCalledWith(
+      `https://atomgpt.org/optimade/v1/structures?page_limit=2&page_offset=0`,
