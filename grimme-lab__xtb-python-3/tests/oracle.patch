+def _delete_molecule(mol):
+    """Delete molecular structure data"""
+    ptr = _ffi.new("xtb_TMolecule *")
+    ptr[0] = mol
+    _lib.xtb_delMolecule(ptr)
+
+
+def _new_molecule(env, natoms, numbers, positions, charge, uhf, lattice, periodic):
