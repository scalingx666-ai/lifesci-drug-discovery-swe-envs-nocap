+def write_c_header(context, filename="physconst.h"):
+    """Write C header file defining physical constants and pi, all with ``pc_`` prefix."""
+
+    self = PhysicalConstantsContext(context)
+
+    pi = _get_pi(from_scratch=False)
+    tau = 2 * pi
