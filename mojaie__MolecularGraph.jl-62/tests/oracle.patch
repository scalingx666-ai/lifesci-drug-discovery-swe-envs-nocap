+function Base.iterate(reader::RDFileReader, state=nothing)
+    block = readuntil(reader.io, "\$RXN")
+    while startswith(block, "\$RDFILE") && block != ""
+        block = readuntil(reader.io, "\$RXN")
+    end
+    isempty(block) ? nothing : (reader.parser("\$RXN" * block), state)
+end
