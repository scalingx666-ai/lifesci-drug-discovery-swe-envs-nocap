+  const fallback = await moleculeSmiles(source, 0, [], undefined);
+  const engine = await moleculeSmiles(source, 0, warnings, computeStructureIdentifiers);
+  expect(engine).toBe(fallback);
+  expect(warnings).toEqual([]);
