diff --git a/.github/workflows/wheels.yml b/.github/workflows/wheels.yml
index d8712ed011..2109014fc7 100644
--- a/.github/workflows/wheels.yml
+++ b/.github/workflows/wheels.yml
@@ -19,15 +19,44 @@ env:
   CIBW_BUILD: "cp310-* cp311-* cp312-* cp313-* cp314-*"
   CIBW_SKIP: "*-manylinux_i686 *-win32 *-musllinux*"
   CIBW_BUILD_VERBOSITY: 1
-  # setuptools_scm doesn't recognize the 'openbabel-X-Y-Z' tag format, so
-  # explicit override is required to publish a real release.
-  SETUPTOOLS_SCM_PRETEND_VERSION_FOR_OPENBABEL: ${{ inputs.version }}
-  CIBW_ENVIRONMENT: ${{ inputs.version && format('SETUPTOOLS_SCM_PRETEND_VERSION_FOR_OPENBABEL={0}', inputs.version) || '' }}
+
+# Least-privilege default for GITHUB_TOKEN; jobs opt into more as needed.
+permissions:
+  contents: read
 
 jobs:
+  # setuptools_scm doesn't recognize the 'openbabel-X-Y-Z' tag format, so
+  # this job derives the version from either an explicit dispatch input or
+  # the tag itself (e.g. openbabel-3-2-0 -> 3.2.0). Empty for PR/dev builds.
+  determine_version:
+    name: Determine project version
+    runs-on: ubuntu-latest
+    outputs:
+      version: ${{ steps.compute.outputs.version }}
+    steps:
+      - id: compute
+        shell: bash
+        env:
+          INPUT_VERSION: ${{ inputs.version }}
+        run: |
+          if [ -n "$INPUT_VERSION" ]; then
+            v="$INPUT_VERSION"
+          elif [[ "${GITHUB_REF}" == refs/tags/openbabel-* ]]; then
+            v="${GITHUB_REF#refs/tags/openbabel-}"
+            v="${v//-/.}"
+          else
+            v=""
+          fi
+          echo "Project version: '$v'"
+          echo "version=$v" >> "$GITHUB_OUTPUT"
+
   build_wheels:
     name: Build wheels for ${{ matrix.os }}
+    needs: [determine_version]
     runs-on: ${{ matrix.runs-on }}
+    env:
+      SETUPTOOLS_SCM_PRETEND_VERSION_FOR_OPENBABEL: ${{ needs.determine_version.outputs.version }}
+      CIBW_ENVIRONMENT: ${{ needs.determine_version.outputs.version && format('SETUPTOOLS_SCM_PRETEND_VERSION_FOR_OPENBABEL={0}', needs.determine_version.outputs.version) || '' }}
     strategy:
       fail-fast: false
       matrix:
