+class ColumnsFileReader(ErsiliaBase):
+    """
+    Reads column names
+
+    Parameters
+    ----------
+    model_id : str
+        Identifier of the model.
+    config_json : dict
+        Configuration settings for the reader.
+
+    Methods
+    -------
+    names() -> list
+        Returns a list of column names.
+    types() -> list
+        Returns a list of column types.
+    """
+
+    def __init__(self, model_id: str, config_json: dict):
+        ErsiliaBase.__init__(self, config_json=config_json, credentials_json=None)
+        self.model_id = model_id
+        full_path = os.path.join(
+            self._get_bundle_location(self.model_id),
+            "model",
+            "framework",
+            "columns",
+            "run_columns.csv",
+        )
+        if os.path.exists(full_path):
+            self.columns_file = os.path.join(full_path)
+        else:
+            self.columns_file = None
+
+    def names(self) -> list:
+        """
+        Returns a list of column names.
+
+        Returns
+        -------
+        list
+            List of column names.
+        """
+        if self.columns_file is None:
+            return None
+        names = []
+        with open(self.columns_file, "r") as f:
+            reader = csv.reader(f)
+            header = next(reader)
+            idx = header.index("name")
+            for r in reader:
+                names += [r[idx]]
+        return names
+
+    def types(self) -> list:
+        """
+        Returns a list of column types.
+
+        Returns
+        -------
+        list
+            List of column types.
+        """
+        if self.columns_file is None:
+            return None
+        types = []
+        with open(self.columns_file, "r") as f:
+            reader = csv.reader(f)
+            header = next(reader)
+            idx = header.index("type")
+            for r in reader:
+                types += [r[idx]]
+        return types
+
 
