+
+    fn has_bond(topology: &Topology, idx1: usize, idx2: usize, order: BondOrder) -> bool {
+        let (a1, a2) = if idx1 <= idx2 {
+            (idx1, idx2)
+        } else {
+            (idx2, idx1)
+        };
+        topology
+            .bonds()
+            .iter()
+            .any(|bond| bond.a1_idx == a1 && bond.a2_idx == a2 && bond.order == order)
