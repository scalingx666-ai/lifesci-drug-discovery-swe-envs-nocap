+static void decodeSgField(Array<char>& field)
+{
+    if (field.size() == 0)
+        return;
+
+    QS_DEF(Array<char>, decoded);
+    BufferScanner scanner(field);
+    while (!scanner.isEOF() && scanner.lookNext() != 0)
+        decoded.push(readSgChar(scanner));
+    decoded.push(0);
+    field.readString(decoded.ptr(), true);
+}
