+    }
+    ++k;
+    vertex[k] = q;
+    bound[k] = cross;
+    bound[k + 1] = inf;
+  }
+  if (k < 0) {
+    for (int p = 0; p < n; ++p)
+      out[p] = inf;
+    return;
+  }
+  k = 0;
+  for (int p = 0; p < n; ++p) {
+    while (bound[k + 1] < p)
+      ++k;
+    const double d = s * (p - vertex[k]);
+    out[p] = g[vertex[k]] + d * d;
