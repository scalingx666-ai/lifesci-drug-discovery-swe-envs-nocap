+                        output_data = psi4.schema_wrapper.run_qcschema(input_model).dict()
+                    else:
+                        output_data = psi4.schema_wrapper.run_qcschema(input_model, postclean=False).dict()
                     output_data["extras"]["psiapi_evaluated"] = True
                     success = True
