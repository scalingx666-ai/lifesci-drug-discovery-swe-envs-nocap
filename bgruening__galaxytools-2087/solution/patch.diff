+<tool id="3dtrees_raster" name="3Dtrees: Raster" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="24.2">
+    <description>forest-structure metrics, DTM, CHM and voxel counts</description>
+    <macros>
+        <token name="@TOOL_VERSION@">1.0.0</token>
+        <token name="@VERSION_SUFFIX@">0</token>
+    </macros>
+    <creator>
+        <person name="Kilian Gerberding" email="kilian.gerberding@geosense.uni-freiburg.de" url="https://orcid.org/0009-0002-5001-2571"/>
+        <organization name="3Dtrees-Team, University of Freiburg" url="https://github.com/3dTrees-earth"/>
+    </creator>
+    <requirements>
+        <container type="docker">ghcr.io/3dtrees-earth/3dtrees_raster:@TOOL_VERSION@</container>
+    </requirements>
+    <version_command>Rscript /opt/raster/raster.R --version</version_command>
+    <command detect_errors="exit_code"><![CDATA[
+        cp '$point_cloud' 'input.$point_cloud.ext' &&
+        #if $area.restrict == 'yes':
+            cp '$area.aoi' aoi.geojson &&
+        #end if
+        mkdir -p output &&
+        Rscript /opt/raster/raster.R
+            --point-cloud 'input.$point_cloud.ext'
+            #if $area.restrict == 'yes':
+                --aoi-geojson aoi.geojson
+            #end if
+            #if str($instance_dimension):
+                --instance-dimension '$instance_dimension'
+            #end if
+            $denoise
+            --denoise-neighbors '$advanced.denoise_neighbors'
+            --denoise-sigma '$advanced.denoise_sigma'
+            --tile-size '$advanced.tile_size'
+            --grid-search-step '$advanced.grid_search_step'
+            --voxel-resolution '$advanced.voxel_resolution'
+            --voxel-count-resolution '$advanced.voxel_count_resolution'
+            --dtm-resolution '$advanced.dtm_resolution'
+            --chm-resolution '$advanced.chm_resolution'
+            --ptd-resolution '$advanced.ptd_resolution'
+            --vegetation-minimum-height '$advanced.vegetation_minimum_height'
+            --gap-height-threshold '$advanced.gap_height_threshold'
+            --minimum-tree-voxels '$advanced.minimum_tree_voxels'
+            --apex-minimum-height '$advanced.apex_minimum_height'
+            --minimum-tree-thickness '$advanced.minimum_tree_thickness'
+            --minimum-occupied-layers '$advanced.minimum_occupied_layers'
+            --raster-format '$advanced.raster_format'
+            --output-dir output
+            --temp-dir "\${TMPDIR:-\$_GALAXY_JOB_TMP_DIR}" &&
+        touch output/raster_voxel_counts.copc.laz
+    ]]></command>
+    <inputs>
+        <param name="point_cloud" type="data" format="laz,las" label="Segmented point cloud" help="One full-resolution point cloud with at least one tree instance dimension (PredInstance, PredInstance_SAT, PredInstance_FM or PredInstance_RCT); coordinates in metres, a CRS (if present) projected in metres."/>
+        <conditional name="area">
+            <param name="restrict" type="select" label="Restrict to an area of interest" help="Without an area of interest the full point-cloud extent is analysed.">
+                <option value="no" selected="true">No</option>
+                <option value="yes">Yes</option>
+            </param>
+            <when value="no"/>
+            <when value="yes">
+                <param name="aoi" type="data" format="geojson,json" label="Area of interest" help="Polygon or MultiPolygon (GeoJSON) in the point cloud's coordinate system; it is not reprojected. Only whole tiles and voxel cells inside it are reported."/>
+            </when>
+        </conditional>
+        <param argument="--instance-dimension" type="text" value="" optional="true" label="Instance dimensions" help="Leave empty to process every one present of PredInstance, PredInstance_SAT, PredInstance_FM and PredInstance_RCT. Or type one or more of them, separated by commas without spaces; each must exist in the point cloud, otherwise the job fails.">
+            <validator type="regex" message="Enter PredInstance, PredInstance_SAT, PredInstance_FM or PredInstance_RCT, separated by commas without spaces">^PredInstance(_SAT|_FM|_RCT)?(,PredInstance(_SAT|_FM|_RCT)?)*\Z</validator>
+        </param>
+        <param argument="--denoise" type="boolean" truevalue="--denoise knn" falsevalue="--denoise none" checked="false" label="Remove noise points" help="kNN distance filter: flags points whose mean distance to their nearest neighbours exceeds the whole cloud's mean plus two standard deviations (settings under Advanced parameters). The terrain model, canopy models and tile metrics then use the remaining points; raw voxel counts always include every recorded point."/>
+        <section name="advanced" title="Advanced parameters" expanded="false" help="Defaults are the published 3Dtrees settings. Every run records the values it used in its run provenance.">
+            <param argument="--tile-size" type="float" min="0.001" max="1000" value="20" label="Tile size (m)" help="Width of the square analysis tiles."/>
+            <param argument="--grid-search-step" type="float" min="0.001" max="1000" value="0.5" label="Tile-grid search step (m)" help="Step of the offset search that places the tile grid. Must not exceed the tile size."/>
+            <param argument="--voxel-resolution" type="float" min="0.001" max="1" value="0.2" label="Metric voxel size (m)" help="Voxel edge length for the tile and tree metrics. Must divide 1 m evenly, for example 0.1, 0.2, 0.25, 0.5 or 1.">
+                <validator type="expression" message="Must divide 1 m evenly, for example 0.1, 0.2, 0.25, 0.5 or 1">abs(1 / value - round(1 / value)) &lt;= 1e-9 * max(1, 1 / value)</validator>
+            </param>
+            <param argument="--voxel-count-resolution" type="float" min="0.001" max="10" value="0.5" label="Voxel count size (m)" help="Voxel edge length, horizontal and vertical, of the voxel point counts."/>
+            <param argument="--dtm-resolution" type="float" min="0.001" max="60" value="1" label="DTM resolution (m)" help="Must divide 60 m evenly, for example 0.5, 1, 2 or 5.">
