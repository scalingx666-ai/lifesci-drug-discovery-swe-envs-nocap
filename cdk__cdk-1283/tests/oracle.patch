-        if (mols.hasNext()) {
-            Resource rdfMol = mols.next();
-            mol = builder.newInstance(IAtomContainer.class);
-            Map<Resource, IAtom> rdfToCDKAtomMap = new HashMap<>();
-            StmtIterator atoms = rdfMol.listProperties(CDK.HASATOM);
