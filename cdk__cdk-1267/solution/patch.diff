diff --git a/base/standard/src/main/java/org/openscience/cdk/aromaticity/AromaticTypeMatcher.java b/base/standard/src/main/java/org/openscience/cdk/aromaticity/AromaticTypeMatcher.java
index 9549b844a4b..3441f044af3 100644
--- a/base/standard/src/main/java/org/openscience/cdk/aromaticity/AromaticTypeMatcher.java
+++ b/base/standard/src/main/java/org/openscience/cdk/aromaticity/AromaticTypeMatcher.java
@@ -138,11 +138,16 @@ static AromaticType getType(final IAtom atom) {
         int q;
         switch (atom.getAtomicNumber()) {
             case IElement.B:
-                if (charge(atom) == 0) {
+                q = charge(atom);
+                if (q == 0) {
                     switch (binfo(atom)) {
                         case 0x0011: return AromaticType.B2;
                         case 0x0003: return AromaticType.B3;
                     }
+                } else if (q == -1) {
+                    if (binfo(atom) == 0x0012) {
+                        return AromaticType.B3_MINUS;
+                    }
                 }
                 break;
 
