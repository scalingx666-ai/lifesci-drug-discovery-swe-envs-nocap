+                            { { 4, 0, 0 },
+                              { 0, 4, 0 },
+                              { 0, 0, 4 },
+                              { 3, 1, 0 },
+                              { 3, 0, 1 },
+                              { 1, 3, 0 },
+                              { 0, 3, 1 },
+                              { 1, 0, 3 },
+                              { 0, 1, 3 },
+                              { 2, 2, 0 },
+                              { 2, 0, 2 },
+                              { 0, 2, 2 },
+                              { 2, 1, 1 },
+                              { 1, 2, 1 },
+                              { 1, 1, 2 } },
+                            1e-12 };
