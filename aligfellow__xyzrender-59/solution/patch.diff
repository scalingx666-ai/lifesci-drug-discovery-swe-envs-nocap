 xyzrender "$DIR/NV63_cell.xyz" --no-cell -o "$IMG/NV63_cell_no_cell.svg"       
+xyzrender "$DIR/NV63_cell.xyz" --supercell 2 2 1 --no-axes -o "$IMG/NV63_cell_supercell_221.svg"                    # with ghosts
