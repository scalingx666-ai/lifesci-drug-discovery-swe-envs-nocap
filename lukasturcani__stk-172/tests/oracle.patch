+        ligands={complex_ligand: (0, 1, 2)},
+        reaction_factory=stk.DativeReactionFactory(
+            stk.GenericReactionFactory(
+                bond_orders={
+                    frozenset({
+                        stk.GenericFunctionalGroup,
+                        stk.SingleAtom
+                    }): 9
+                }
+            )
+        )
+    )
+)
+iron_complex = stk.BuildingBlock.init_from_molecule(
