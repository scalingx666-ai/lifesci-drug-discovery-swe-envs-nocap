diff --git a/tools/datavzrd/datavzrd_render.xml b/tools/datavzrd/datavzrd_render.xml
index cb5e1f397b..307d3bc0cb 100644
--- a/tools/datavzrd/datavzrd_render.xml
+++ b/tools/datavzrd/datavzrd_render.xml
@@ -117,9 +117,13 @@ datavzrd config.yaml --output report_output --overwrite-output &&
             <output name="output_html" ftype="html">
                 <assert_contents>
                     <has_text text="&lt;script src=&quot;./static/bundle.js&quot;&gt;"/>
-                    <has_text text="const name = 'Oscars Report';"/>
+                    <!-- Since datavzrd 2.75.0 names are escaped with double quotes in the generated JS -->
+                    <has_text text="const name = &quot;Oscars Report&quot;;"/>
                     <has_text text="const views = {&quot;oscars&quot;:null};"/>
-                    <has_text text="const table = null;"/>
