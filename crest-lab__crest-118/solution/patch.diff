+  at2 = 0
+  selected = 0
+
+  !>-- loop through the input string
+  do i = 1,len(trim(line))
+    digit = line(i:i)
+    !> should exclude tabstops and blanks, 9 is ascii code for  tab
+    if (index(numbers,digit) .ne. 0) then 
+      if (.not. rang) then
+        atom1 = trim(atom1)//digit
+        stor = .true.
+      else
