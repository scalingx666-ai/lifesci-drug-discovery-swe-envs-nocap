+
+    pmol = pbc.gto.M(
+        atom="""
+             O  -1.6256  -0.0413   0.3705
+             H  -0.7061  -0.0938   0.0934
+             H  -2.0618  -0.7328  -0.1359
+             """,
+        basis="def2-tzvp",
+        a=[[3, 0, 0], [0, 3, 0], [0, 0, 3]],
+    )
+
+    xc = 'pbe'
+
+    e_mol_disp = disp.DFTD3Dispersion(mol, xc=xc, version="d3bj").kernel()[0]
