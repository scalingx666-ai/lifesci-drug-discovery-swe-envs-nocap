+// Normalize key by stripping non-alphanumeric characters and converting to
+// lowercase.
+QString normalizeKey(const QString& str)
+{
+  QString result;
+  result.reserve(str.size());
+  for (QChar ch : str) {
+    if (ch.isLetterOrNumber())
+      result.append(ch.toLower());
+  }
+  return result;
