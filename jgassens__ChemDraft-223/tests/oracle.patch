diff --git a/site-redirect/404.html b/site-redirect/404.html
new file mode 100644
index 000000000..9b191d02c
--- /dev/null
+++ b/site-redirect/404.html
@@ -0,0 +1,19 @@
+<!doctype html>
+<html lang="en">
+  <head>
+    <script>
+      const path = location.pathname.replace(/^\/ChemDraft(?=\/|$)/i, '') || '/';
+      location.replace('https://chemdraft.ai' + path + location.search + location.hash);
+    </script>
+    <meta http-equiv="refresh" content="0; url=https://chemdraft.ai/">
+    <meta charset="utf-8">
+    <meta name="viewport" content="width=device-width, initial-scale=1">
+    <title>ChemDraft has moved</title>
+    <meta name="robots" content="noindex">
+    <link rel="canonical" href="https://chemdraft.ai/">
+    <meta name="google-site-verification" content="AWp2YibV3rvijGBpT_MC9TosSDZmwRSwCVNf1GJZpJ4">
+  </head>
+  <body style="font-family: system-ui, sans-serif">
+    ChemDraft has moved to <a href="https://chemdraft.ai/">chemdraft.ai</a>.
+  </body>
+</html>
