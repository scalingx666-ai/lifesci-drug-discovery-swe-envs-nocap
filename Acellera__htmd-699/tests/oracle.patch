+def _getPerpendicular(v):
+    """
+    Returns a perpendicular vector
+
+    Parameters
+    ----------
+    v: np.array
+        The vector you want a perpendicular one
+
+    Returns
+    -------
+    V:  np.array
+        The perpendicular vector
+    """
+    V = [0, 0, 0]
+    X, Y, Z = v[0], v[1], v[2]
+    if X != 0:
+        if Y != 0:
+            V[0] = Y
+            V[1] = -X
+        elif Z != 0:
+            V[2] = -X
+            V[0] = Z
+        else:
+            V[1] = 1
+    elif Y != 0:
+        if Z != 0:
+            V[2] = -Y
+            V[1] = Z
+        else:
+            V[0] = 1
+    elif Z != 0:
+        V[0] = 1
+
+    return np.array(V)
