+                dtype=dtype,
+            ),
+        )
+    )
+    qsh = batch.pack(
+        (
+            torch.tensor(
+                [
+                    *[+2.92177048596496e-1, -8.27551283559270e-1, +3.81811514612779e-1],
+                    *[+4.17784916263666e-1, -6.71683789364610e-1, -5.11576334445887e-2],
