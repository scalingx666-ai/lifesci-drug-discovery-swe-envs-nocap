+                <expand macro="sanitizer_options"/>
+            </param>
+            <param argument="--custom_layout" type="text" value="" optional="true" label="Custom layout" help="Text defining a Vitessce layout following its alternative syntax. See tool help section for more details.">
+                <expand macro="sanitizer_printable"/>
