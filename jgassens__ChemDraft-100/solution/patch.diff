diff --git a/apps/desktop/src/App.css b/apps/desktop/src/App.css
index 97d275eea..c70a4cdce 100644
--- a/apps/desktop/src/App.css
+++ b/apps/desktop/src/App.css
@@ -5509,9 +5509,64 @@ textarea:focus-visible,
   gap: 8px;
 }
 
+/* The status row along the bottom of the workspace (MainWindow): the status, the warnings count and
+   the modifier hint on the left, the build stamp on the right. When the row is short of room the
+   stamp gives way first, truncating with an ellipsis down to a floor that keeps its start (the build
+   and the start of the worktree label) readable; then the status truncates. The warnings count never
+   shrinks. A long branch-build stamp at a high display scale is wider than a narrow window's row, so
+   a stamp that kept its full width ran over the count and past the row's right edge. */
+.status-row {
+  position: absolute;
+  left: 8px;
+  right: 8px;
+  bottom: 8px;
+  z-index: 1000;
+  display: flex;
+  align-items: baseline;
+  gap: 12px;
+  color: var(--cd-text-secondary);
+  pointer-events: none;
+}
+
+.status-row-main {
+  flex: 1 1 auto;
+  min-width: 0;
+  display: flex;
+  align-items: baseline;
+  gap: 10px;
+  font-size: 11px;
+}
+
+.status-message,
+.status-modifier-hint {
+  flex: 0 1 auto;
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+}
+
+.status-modifier-hint {
+  opacity: 0.7;
+}
+
+/* Shrinks far ahead of the status (its shrink factor dwarfs the left part's), down to its floor; the
+   full stamp is in its title tooltip, the one reason it takes the pointer. */
+.build-stamp {
+  flex: 0 1000 auto;
+  min-width: min(260px, 45%);
+  overflow: hidden;
+  text-overflow: ellipsis;
+  font-size: 10px;
+  opacity: 0.5;
+  white-space: nowrap;
+  pointer-events: auto;
+}
+
 /* The warnings a file open reported: a count in the status line, and a list above it. The list
    fits the window it is in and scrolls, so a small window at a high display scale still shows it. */
 .open-warnings-button {
+  flex: 0 0 auto;
   pointer-events: auto;
   border: 0;
   background: none;
