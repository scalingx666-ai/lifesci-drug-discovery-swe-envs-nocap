+    if (!engine.plugin)
+      continue;
+    if (stats)
+      lap.reset();
+    if (!engine.plugin->updateCoordinates(*mol, *engine.node)) {
+      // No in-place update: rebuild this plugin's node, keeping the node.
+      engine.node->clear();
