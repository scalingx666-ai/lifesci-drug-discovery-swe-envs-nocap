 #' @family Clearance and volume parameters
 #' @export
 pk.calc.cl <- function(dose, auc) {
+  # sum() of nothing is 0, which would be a wrong answer, not a missing one
+  if (length(dose) == 0) {
+    return(NA_real_)
+  }
   if (length(auc) == 1) {
     dose <- sum(dose)
   }
