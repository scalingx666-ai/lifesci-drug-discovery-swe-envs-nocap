new file mode 100644
index 000000000..f3d2af6d7
--- /dev/null
+++ b/tools/release/verify-windows-updater.test.ts
@@ -0,0 +1,82 @@
+import { createHash, generateKeyPairSync, randomBytes, sign } from "node:crypto";
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { createRequire } from "node:module";
+import { describe, expect, it } from "vitest";
+import { verifyUpdaterSignature } from "./verify-windows-updater";
+
+// Ephemeral test keys only. No project private key is read, stored, or needed.
+function signed(algorithm = "ED") {
+  const { publicKey, privateKey } = generateKeyPairSync("ed25519");
+  const id = randomBytes(8);
+  const installer = Buffer.from("final Authenticode-signed installer bytes");
+  const message = algorithm === "ED" ? createHash("blake2b512").update(installer).digest() : installer;
+  const signature = sign(null, message, privateKey);
+  const comment = "timestamp:1792540800\tfile:ChemDraft_1.0.0_x64-setup.exe";
+  const global = sign(null, Buffer.concat([signature, Buffer.from(comment)]), privateKey).toString("base64");
+  const packet = Buffer.concat([Buffer.from(algorithm), id, signature]).toString("base64");
+  const key = Buffer.concat([Buffer.from("Ed"), id, publicKey.export({ format: "der", type: "spki" }).subarray(-32)]);
+  const pubkey = Buffer.from(`untrusted comment: test key\n${key.toString("base64")}\n`).toString("base64");
+  const encode = (text: string) => Buffer.from(text).toString("base64");
+  const raw = `untrusted comment: test signature\n${packet}\ntrusted comment: ${comment}\n${global}\n`;
+  return { installer, pubkey, sig: encode(raw), raw, encode };
+}
+
+describe("Windows updater verification", () => {
+  it("accepts an actual Tauri CLI signature with an ephemeral test key", (context) => {
+    const desktopRequire = createRequire(new URL("../../apps/desktop/package.json", import.meta.url));
+    let cli: string;
+    try {
+      cli = desktopRequire.resolve("@tauri-apps/cli/tauri.js");
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code !== "MODULE_NOT_FOUND") throw error;
+      context.skip("Tauri CLI is not installed/resolvable from the desktop package; skipping real CLI signature test.");
+      return;
+    }
+    const root = mkdtempSync(join(tmpdir(), "chemdraft-updater-verify-"));
+    const key = join(root, "test.key");
+    const installer = join(root, "test.exe");
+    try {
+      // Capture all CLI output: even generated test keys must not appear in test logs.
+      const generated = spawnSync(process.execPath, [cli, "signer", "generate", "--ci", "--password", "", "--write-keys", key]);
+      expect(generated.status).toBe(0);
+      writeFileSync(installer, "final installer test bytes");
+      const signed = spawnSync(process.execPath, [cli, "signer", "sign", "--password", "", installer], {
+        env: { ...process.env, TAURI_SIGNING_PRIVATE_KEY: readFileSync(key, "utf8").trim() }
+      });
+      expect(signed.status).toBe(0);
+      expect(() => verifyUpdaterSignature(readFileSync(installer), readFileSync(`${installer}.sig`, "utf8"),
+        readFileSync(`${key}.pub`, "utf8"))).not.toThrow();
+    } finally {
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+
+  it.each(["ED", "Ed"])("verifies %s Minisign packets in Tauri's base64 envelope", (algorithm) => {
+    const { installer, pubkey, sig } = signed(algorithm);
+    expect(() => verifyUpdaterSignature(installer, sig, pubkey)).not.toThrow();
+  });
+
+  it("rejects signing before Authenticode changes the bytes", () => {
+    const { installer, pubkey, sig } = signed();
+    expect(() => verifyUpdaterSignature(Buffer.concat([installer, Buffer.from("certificate")]), sig, pubkey))
+      .toThrow(/verification failed/);
+  });
+
+  it("rejects a different key, tampered comments, truncated packets and unsupported algorithms", () => {
+    const { installer, pubkey, sig, raw, encode } = signed();
+    expect(() => verifyUpdaterSignature(installer, sig, signed().pubkey)).toThrow(/key ID mismatch/);
+    expect(() => verifyUpdaterSignature(installer, encode(raw.replace("timestamp:1792540800", "timestamp:1")), pubkey))
+      .toThrow(/verification failed/);
+    expect(() => verifyUpdaterSignature(installer, encode(raw.split("\n").slice(0, 3).join("\n")), pubkey))
+      .toThrow(/structure/);
+    const lines = raw.trim().split("\n");
+    lines[1] = Buffer.from("Ed").toString("base64");
+    expect(() => verifyUpdaterSignature(installer, encode(lines.join("\n")), pubkey)).toThrow(/packet/);
+    const unknown = signed("XX");
+    expect(() => verifyUpdaterSignature(unknown.installer, unknown.sig, unknown.pubkey)).toThrow(/algorithm/);
+    expect(() => verifyUpdaterSignature(installer, "bad-base64!", pubkey)).toThrow(/base64/);
+  });
+});
diff --git a/tools/release/verify-windows-updater.ts b/tools/release/verify-windows-updater.ts
new file mode 100644
index 000000000..461809173
--- /dev/null
+++ b/tools/release/verify-windows-updater.ts
@@ -0,0 +1,66 @@
+/** Verify Tauri's base64-wrapped Minisign .sig against the checked-in updater public key.
+ * Tauri CLI has no `signer verify` command. Use Node's Ed25519 and BLAKE2b-512 primitives;
+ * verify both the file signature and Minisign's authenticated comment, including the key ID.
+ */
+import { createHash, createPublicKey, verify } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { resolve } from "node:path";
+import { pathToFileURL } from "node:url";
+
+function decode(value: string): Buffer {
+  const trimmed = value.trim();
+  const bytes = Buffer.from(trimmed, "base64");
+  if (!bytes.length || bytes.toString("base64") !== trimmed) throw new Error("Invalid Minisign base64 encoding.");
+  return bytes;
+}
+
+export function verifyUpdaterSignature(installer: Buffer, encodedSignature: string, encodedPublicKey: string): void {
+  const publicLines = decode(encodedPublicKey).toString("utf8").trim().split(/\r?\n/);
+  const signatureLines = decode(encodedSignature).toString("utf8").trim().split(/\r?\n/);
+  if (publicLines.length !== 2 || signatureLines.length !== 4 ||
+      !publicLines[0].startsWith("untrusted comment: ") ||
+      !signatureLines[0].startsWith("untrusted comment: ") ||
+      !signatureLines[2].startsWith("trusted comment: ")) {
+    throw new Error("Invalid Minisign key or signature structure.");
+  }
+  const key = decode(publicLines[1]);
+  const signature = decode(signatureLines[1]);
+  const globalSignature = decode(signatureLines[3]);
+  if (key.length !== 42 || key.subarray(0, 2).toString() !== "Ed" ||
+      signature.length !== 74 || globalSignature.length !== 64) {
+    throw new Error("Invalid Minisign key or signature packet.");
+  }
+  if (!key.subarray(2, 10).equals(signature.subarray(2, 10))) throw new Error("Updater signature key ID mismatch.");
+  const algorithm = signature.subarray(0, 2).toString();
+  if (algorithm !== "Ed" && algorithm !== "ED") throw new Error("Unsupported Minisign signature algorithm.");
+  // DER SubjectPublicKeyInfo prefix for a raw Ed25519 public key (RFC 8410).
+  const publicKey = createPublicKey({
+    key: Buffer.concat([Buffer.from("302a300506032b6570032100", "hex"), key.subarray(10)]),
+    format: "der",
+    type: "spki"
+  });
+  const message = algorithm === "ED" ? createHash("blake2b512").update(installer).digest() : installer;
+  const fileSignature = signature.subarray(10);
+  const comment = Buffer.from(signatureLines[2].slice("trusted comment: ".length));
+  if (!verify(null, message, publicKey, fileSignature) ||
+      !verify(null, Buffer.concat([fileSignature, comment]), publicKey, globalSignature)) {
+    throw new Error("Updater signature verification failed: installer or authenticated comment changed.");
+  }
+}
+
+export function main(args: readonly string[]): void {
+  if (args.length !== 1) throw new Error("Usage: verify-windows-updater.ts <installer.exe>");
+  const installer = resolve(args[0]);
+  const config = JSON.parse(readFileSync(resolve("apps/desktop/src-tauri/tauri.windows.conf.json"), "utf8"));
+  verifyUpdaterSignature(readFileSync(installer), readFileSync(`${installer}.sig`, "utf8"), config.plugins.updater.pubkey);
+  console.log("Updater signature verified against tauri.windows.conf.json.");
+}
+
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
+  try {
+    main(process.argv.slice(2));
+  } catch (error) {
+    console.error(`verify-windows-updater: ${error instanceof Error ? error.message : String(error)}`);
+    process.exit(1);
+  }
+}
diff --git a/tools/release/windows-release.test.ts b/tools/release/windows-release.test.ts
new file mode 100644
index 000000000..752f40523
--- /dev/null
+++ b/tools/release/windows-release.test.ts
@@ -0,0 +1,75 @@
+import { spawnSync } from "node:child_process";
+import { mkdtempSync, readFileSync, rmSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { describe, expect, it } from "vitest";
+
+const workflow = readFileSync(new URL("../../.github/workflows/windows-release.yml", import.meta.url), "utf8");
+const hasPowerShell = spawnSync("pwsh", ["-NoProfile", "-Command", "exit 0"]).status === 0;
+
+// Execute the workflow's actual scripts, with only the Windows certificate/file APIs mocked.
+function stepScript(name: string) {
+  const step = workflow.split(`      - name: ${name}\n`)[1]?.split(/\n      - /)[0];
+  const script = step?.split("        run: |\n")[1];
+  if (!script) throw new Error(`Missing workflow script: ${name}`);
+  return script.split("\n").map((line) => line.replace(/^          /, "")).join("\n");
+}
+
+function run(script: string, env: Record<string, string>) {
+  return spawnSync("pwsh", ["-NoProfile", "-NonInteractive", "-Command", `$ErrorActionPreference = 'Stop'\n${script}`], {
+    encoding: "utf8",
+    env: { ...process.env, ...env }
+  });
+}
+
+describe.skipIf(!hasPowerShell)("Windows release signing gates (requires installed pwsh)", () => {
+  it.each([
+    ["Valid", "CN=SignPath Foundation", "SignPath Foundation", true],
+    ["Valid", "CN=Unexpected Publisher", "SignPath Foundation", false],
+    ["Valid", "CN=SignPath Foundation", "", false],
+    ["Valid", "CN=SignPath Foundation", "   ", false],
+    ["NotSigned", "CN=SignPath Foundation", "SignPath Foundation", false]
+  ] as const)("checks status %s and subject %s against '%s'", (status, subject, expected, accepted) => {
+    const root = mkdtempSync(join(tmpdir(), "chemdraft-signing-gate-"));
+    const output = join(root, "output");
+    try {
+      const result = run(`
+function Get-ChildItem { [PSCustomObject]@{ Name = 'test.exe'; FullName = 'test.exe' } }
+function Get-AuthenticodeSignature {
+  [PSCustomObject]@{ Status = $env:TEST_STATUS; SignerCertificate = [PSCustomObject]@{ Subject = $env:TEST_SUBJECT } }
+}
+function Copy-Item { }
+${stepScript("Verify Authenticode and replace unsigned installer")}`, {
+        TEST_STATUS: status,
+        TEST_SUBJECT: subject,
+        EXPECTED_AUTHENTICODE_SUBJECT: expected,
+        INSTALLER: "test.exe",
+        GITHUB_OUTPUT: output
+      });
+      expect(result.status === 0, result.stderr).toBe(accepted);
+      if (accepted) expect(readFileSync(output, "utf8")).toContain("signed=true");
+      if (!expected.trim()) expect(result.stderr).toContain("EXPECTED_AUTHENTICODE_SUBJECT repository variable is required");
+    } finally {
+      rmSync(root, { recursive: true, force: true });
+    }
+  });
+
+  it.each([
+    ["true", "true", "false", true, false],
+    ["false", "true", "false", false, false],
+    ["true", "false", "false", false, false],
+    ["false", "false", "false", false, false],
+    ["", "", "false", false, false],
+    ["false", "true", "true", true, true],
+    ["true", "false", "true", true, true],
+    ["false", "false", "true", true, true]
+  ] as const)("gates upload with Authenticode=%s updater=%s override=%s", (authenticode, updater, override, accepted, warned) => {
+    const result = run(stepScript("Require verified signatures before release upload"), {
+      AUTHENTICODE_SIGNED: authenticode,
+      UPDATER_SIGNED: updater,
+      ALLOW_UNSIGNED_UPLOAD: override
+    });
+    expect(result.status === 0, result.stderr).toBe(accepted);
+    expect(result.stdout.includes("::warning::UNSIGNED RELEASE UPLOAD OVERRIDE")).toBe(warned);
+  });
+});
