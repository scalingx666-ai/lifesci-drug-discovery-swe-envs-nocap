+        with open('xyz_with_extra_point_charges.xyz') as xyz_sites:
+            lines = xyz_sites.readlines()
+
+        extra_sites = OrderedDict()
+        parent = 0
+        sites_no = 0
+
+        for i, line in enumerate(lines[2:]):
