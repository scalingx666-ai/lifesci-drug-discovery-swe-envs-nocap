+"""
+function atomic_orbital_projections(basis::PlaneWaveBasis{T}, ψ;
+                                    isonmanifold = l -> true,
+                                    positions = basis.model.positions) where {T}
+    projectors, labels = atomic_orbital_projectors(basis; isonmanifold, positions)
