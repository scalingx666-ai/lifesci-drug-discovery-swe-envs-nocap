+    "%matplotlib notebook\n",
+    "\n",
+    "import matplotlib\n",
+    "import numpy as np\n",
+    "import itertools\n",
+    "import matplotlib.pyplot as plt\n",
+    "import matplotlib.animation as animation\n",
+    "from ipywidgets import interact, interactive, fixed, FloatSlider, widgets"
