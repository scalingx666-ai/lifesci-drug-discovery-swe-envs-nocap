             molecule.get_bonds(use_lookup=False, set_lookup=True)
         return molecule
 
+    @classmethod
+    def from_pyscf_molecule(cls, mol):
+        """Create an instance of the own class from a PySCF molecule
+
+        Args:
+            mol (:class:`pyscf.gto.Mole`):
+
+        Returns:
+            Cartesian:
+        """
+        return cls(
+            atoms=mol.elements,
+            coords=mol.atom_coords(unit="Angstrom"),
+        )
