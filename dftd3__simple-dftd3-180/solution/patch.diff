+subroutine ridders_cartesian(ic, iat, deriv, err)
+
+   integer, intent(in) :: ic, iat
+   real(wp), intent(out) :: deriv, err
+
+   integer, parameter :: max_tab = 10
+   real(wp), parameter :: initial_step = 1.0e-4_wp
