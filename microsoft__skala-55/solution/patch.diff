+        self.a_reg = parameter(1.0e-3)
+        self.a1 = parameter(4.9479)
+        self.k0 = parameter(0.174)
+        self.mu = parameter(10 / 81)
+        self.k1 = parameter(0.065)
+        self.cfx1 = parameter(0.667)
