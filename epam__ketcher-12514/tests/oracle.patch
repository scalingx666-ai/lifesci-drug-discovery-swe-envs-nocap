diff --git a/scripts/pr-checks.mjs b/scripts/pr-checks.mjs
new file mode 100644
index 00000000000..079ee36803d
--- /dev/null
+++ b/scripts/pr-checks.mjs
@@ -0,0 +1,269 @@
+// PR checks that Danger runs on every pull request (dangerfile.ts).
+// The rules are pure: dangerfile.ts reads the PR from GitHub and passes it in.
+// Each rule's owner doc: .memory-bank/review-workflow.md (the Danger rules,
+// the PR-type contract, and the large-scale change protocol). The exact title
+// form stays a convention in .memory-bank/coding-standards.md and is not
+// enforced here.
+
+export const LSC_LABEL = 'large-scale-change';
+export const MAX_CHANGED_LINES = 400;
+
+const UNCOUNTED_FILES = [/(^|\/)package-lock\.json$/, /(^|\/)__snapshots__\//];
+const UNIT_TESTED_CODE = [
+  /^packages\/ketcher-core\/src\/domain\//,
+  /^packages\/ketcher-core\/src\/application\/editor\/operations\//,
+];
+const UNIT_TEST = /^packages\/.*(\.test\.[jt]sx?$|\/__tests__\/)/;
+const E2E_TEST = /^ketcher-autotests\/tests\/.*\.spec\.ts$/;
+const OPENSPEC_CHANGE = /^openspec\/changes\//;
+
+const MEMORY_BANK_LINE = /^\s*(?:[-*]\s*)?memory bank\s*:/im;
+const BACKMERGE = /^Backmerge:\s*/i;
+const TITLE_ISSUES = /^#\d+(\s*,\s*#\d+)*/;
+
+/**
+ * @typedef {{ number: number, type: string | null }} LinkedIssue
+ * @typedef {{ path: string, status: string, additions: number, deletions: number }} ChangedFile
+ * @typedef {{
+ *   title: string,
+ *   body: string,
+ *   branch: string,
+ *   labels: string[],
+ *   isDraft: boolean,
+ *   requestedReviewers: number,
+ *   linkedIssues: LinkedIssue[],
+ *   files: ChangedFile[],
+ *   lscTemplate: string,
+ * }} PullRequest
+ * @typedef {{ level: 'fail' | 'warn', rule: string, message: string }} Finding
+ */
+
+/** @returns {Finding[]} */
+export function checkPullRequest(pr) {
+  return [
+    ...checkBranch(pr),
+    ...checkTitle(pr),
+    ...checkLinkedIssue(pr),
+    ...checkSize(pr),
+    ...checkUnitTests(pr),
+    ...checkBugFix(pr),
+    ...checkFeature(pr),
+    ...checkLargeScaleChange(pr),
+    ...checkMemoryBank(pr),
+    ...checkReviewers(pr),
+  ];
+}
+
+function checkBranch({ branch }) {
+  if (!branch.includes('#')) return [];
+  return [
+    fail(
+      'branch',
+      `Branch \`${branch}\` contains \`#\`. Name it \`<issue>-<kebab-case title>\`.`,
+    ),
+  ];
+}
+
+function checkTitle(pr) {
+  const { linkedIssues } = pr;
+  const title = pr.title.replace(BACKMERGE, '');
+  const findings = [];
+  const issuePrefix = title.match(TITLE_ISSUES);
+  if (!issuePrefix && linkedIssues.length > 0) {
+    findings.push(
+      fail(
+        'title',
+        `Title must start with the linked issue: \`#${linkedIssues[0].number} - <title>\`.`,
+      ),
+    );
+  }
+  if (issuePrefix && linkedIssues.length > 0) {
+    const linked = new Set(linkedIssues.map((issue) => issue.number));
+    const unlinked = issuePrefix[0]
+      .match(/\d+/g)
+      .map(Number)
+      .filter((number) => !linked.has(number));
+    if (unlinked.length > 0) {
+      findings.push(
+        warn(
+          'title',
+          `Title names ${unlinked.map((n) => `#${n}`).join(', ')}, but the PR does not link it. Add \`Closes #${unlinked[0]}\` to the body.`,
+        ),
+      );
+    }
+  }
+  return findings;
+}
+
+function checkLinkedIssue({ linkedIssues }) {
+  if (linkedIssues.length > 0) return [];
+  return [
+    warn(
+      'linked-issue',
+      'No linked issue. Add `Closes #<issue>` to the body, or ignore this for a PR with no issue.',
+    ),
+  ];
+}
+
+function checkSize({ files, labels }) {
+  if (labels.includes(LSC_LABEL)) return [];
+  const changed = files
+    .filter((file) => !UNCOUNTED_FILES.some((re) => re.test(file.path)))
+    .reduce((sum, file) => sum + file.additions + file.deletions, 0);
+  if (changed <= MAX_CHANGED_LINES) return [];
+  return [
+    warn(
+      'size',
+      `${changed} changed lines (lockfiles and snapshots not counted). Review quality drops above ${MAX_CHANGED_LINES}. Split the PR, or follow the large-scale change protocol in \`.memory-bank/review-workflow.md\`.`,
+    ),
+  ];
+}
+
+function checkUnitTests({ files }) {
+  const code = files.filter(
+    (file) =>
+      file.status !== 'removed' &&
+      UNIT_TESTED_CODE.some((re) => re.test(file.path)),
+  );
+  if (code.length === 0 || files.some((file) => UNIT_TEST.test(file.path))) {
+    return [];
+  }
+  return [
+    warn(
+      'unit-test',
+      `\`ketcher-core\` domain or operations code changed with no unit test change: ${code
+        .map((file) => `\`${file.path}\``)
+        .join(', ')}.`,
+    ),
+  ];
+}
+
+function checkBugFix({ linkedIssues, files }) {
+  const bug = linkedIssues.find((issue) => issue.type === 'Bug');
+  if (!bug) return [];
+  if (
+    files.some((file) => UNIT_TEST.test(file.path) || E2E_TEST.test(file.path))
+  ) {
+    return [];
+  }
+  return [
+    warn(
+      'bug-fix',
+      `#${bug.number} is a Bug, and the PR changes no test. A bug fix carries a regression test (PR-type contract, \`.memory-bank/review-workflow.md\`).`,
+    ),
+  ];
+}
+
+function checkFeature({ title, linkedIssues, files }) {
+  const feature = linkedIssues.find((issue) => issue.type === 'Feature');
+  if (!feature || BACKMERGE.test(title)) return [];
+  const findings = [];
+  if (!files.some((file) => OPENSPEC_CHANGE.test(file.path))) {
+    findings.push(
+      fail(
+        'feature',
+        `#${feature.number} is a Feature, and the PR has no OpenSpec change in \`openspec/changes/\` (PR-type contract, \`.memory-bank/review-workflow.md\`).`,
+      ),
+    );
+  }
+  if (
+    !files.some((file) => UNIT_TEST.test(file.path) || E2E_TEST.test(file.path))
+  ) {
+    findings.push(
+      warn(
+        'feature-test',
+        `#${feature.number} is a Feature, and the PR changes no test. Add a unit or E2E test, or explain in the body why none fits.`,
+      ),
+    );
+  }
+  return findings;
+}
+
+function checkMemoryBank({ title, body }) {
+  if (BACKMERGE.test(title) || MEMORY_BANK_LINE.test(body)) return [];
+  return [
+    warn(
+      'memory-bank',
+      'The body has no `Memory bank:` line. Name the memory-bank file the PR updated, or write `Memory bank: not needed`.',
+    ),
+  ];
+}
+
+function checkReviewers({ isDraft, requestedReviewers }) {
+  if (isDraft || requestedReviewers > 0) return [];
+  return [
+    warn(
+      'reviewers',
+      'No reviewer is requested. Request a review before you ask for one in chat.',
+    ),
+  ];
+}
+
+function checkLargeScaleChange({ labels, body, lscTemplate }) {
+  if (!labels.includes(LSC_LABEL)) return [];
+  const template = sections(lscTemplate);
+  const filled = sections(body);
+  const findings = [];
+  for (const [heading, templateText] of template) {
+    const text = filled.get(heading);
+    if (text === undefined) {
+      findings.push(
+        fail('large-scale-change', `Section \`${heading}\` is missing.`),
+      );
+    } else if (text === '' || text === templateText) {
+      findings.push(
+        fail(
+          'large-scale-change',
+          `Section \`${heading}\` still holds the template text.`,
+        ),
+      );
+    }
+  }
+  return findings;
+}
+
+/**
+ * Splits markdown at `##` and `###` headings.
+ * @returns {Map<string, string>} heading → its text, comments removed and whitespace collapsed
+ */
+export function sections(markdown) {
+  const result = new Map();
+  let heading = null;
+  let lines = [];
+  const flush = () => {
+    if (heading !== null) result.set(heading, normalize(lines.join('\n')));
+  };
+  let withoutComments = markdown;
+  let previous;
+  do {
+    previous = withoutComments;
+    withoutComments = withoutComments.replace(/<!--[\s\S]*?-->/g, '');
+  } while (withoutComments !== previous);
+  for (const line of withoutComments.split(/\r?\n/)) {
+    const match = line.match(/^#{2,3}\s+(.+?)\s*$/);
+    if (match) {
+      flush();
+      heading = match[1].toLowerCase();
+      lines = [];
+    } else {
+      lines.push(line);
+    }
+  }
+  flush();
+  return result;
+}
+
+function normalize(text) {
+  return text
+    .replace(/^-{3,}$/gm, '')
+    .replace(/\s+/g, ' ')
+    .trim();
+}
+
+function fail(rule, message) {
+  return { level: 'fail', rule, message };
+}
+
+function warn(rule, message) {
+  return { level: 'warn', rule, message };
+}
diff --git a/scripts/pr-checks.test.mjs b/scripts/pr-checks.test.mjs
new file mode 100644
index 00000000000..40e11239e02
--- /dev/null
+++ b/scripts/pr-checks.test.mjs
@@ -0,0 +1,285 @@
+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import { dirname, join } from 'node:path';
+import { test } from 'node:test';
+import { fileURLToPath } from 'node:url';
+import { checkPullRequest, LSC_LABEL, sections } from './pr-checks.mjs';
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), '..');
+const LSC_TEMPLATE = readFileSync(
+  join(ROOT, '.github', 'PULL_REQUEST_TEMPLATE', 'large-scale-change.md'),
+  'utf8',
+);
+
+function file(path, lines = 10, status = 'modified') {
+  return { path, status, additions: lines, deletions: 0 };
+}
+
+function pr(overrides = {}) {
+  return {
+    title: '#100 - Atom labels break at 20% zoom',
+    body: 'Memory bank: not needed',
+    branch: '100-atom-labels-break',
+    labels: [],
+    isDraft: false,
+    requestedReviewers: 1,
+    linkedIssues: [{ number: 100, type: 'Task' }],
+    files: [file('packages/ketcher-react/src/a.ts')],
+    lscTemplate: LSC_TEMPLATE,
+    ...overrides,
+  };
+}
+
+function rules(findings, level) {
+  return findings
+    .filter((finding) => finding.level === level)
+    .map((finding) => finding.rule);
+}
+
+test('a PR that follows every rule has no findings', () => {
+  assert.deepEqual(checkPullRequest(pr()), []);
+});
+
+test('a branch name with # fails', () => {
+  const findings = checkPullRequest(pr({ branch: '#100-atom-labels' }));
+  assert.deepEqual(rules(findings, 'fail'), ['branch']);
+});
+
+test('title: no issue prefix with a linked issue fails', () => {
+  for (const title of ['100 - Atom labels', 'Atom labels break']) {
+    assert.deepEqual(
+      rules(checkPullRequest(pr({ title })), 'fail'),
+      ['title'],
+      title,
+    );
+  }
+});
+
+test('title: the separator form is not enforced', () => {
+  for (const title of [
+    '#100-Atom labels',
+    '#100 Atom labels',
+    '#100 – Atom labels',
+  ]) {
+    assert.deepEqual(checkPullRequest(pr({ title })), [], title);
+  }
+});
+
+test('title: a Backmerge prefix and several issues are accepted', () => {
+  const findings = checkPullRequest(
+    pr({
+      title: 'Backmerge: #100, #101 - Atom labels',
+      linkedIssues: [
+        { number: 100, type: 'Task' },
+        { number: 101, type: 'Task' },
+      ],
+    }),
+  );
+  assert.deepEqual(findings, []);
+});
+
+test('title: an issue in the title that the PR does not link warns', () => {
+  const findings = checkPullRequest(pr({ title: '#999 - Atom labels' }));
+  assert.deepEqual(rules(findings, 'warn'), ['title']);
+});
+
+test('no linked issue warns, and a plain title is then accepted', () => {
+  const findings = checkPullRequest(
+    pr({ title: 'ci: upgrade CodeQL', linkedIssues: [] }),
+  );
+  assert.deepEqual(rules(findings, 'fail'), []);
+  assert.deepEqual(rules(findings, 'warn'), ['linked-issue']);
+});
+
+test('size: over 400 lines warns; lockfiles and snapshots are not counted', () => {
+  const big = checkPullRequest(
+    pr({ files: [file('packages/ketcher-react/src/a.ts', 401)] }),
+  );
+  assert.deepEqual(rules(big, 'warn'), ['size']);
+
+  const lockfile = checkPullRequest(
+    pr({
+      files: [
+        file('packages/ketcher-react/src/a.ts', 100),
+        file('package-lock.json', 5000),
+        file('packages/ketcher-core/__tests__/__snapshots__/a.snap', 900),
+      ],
+    }),
+  );
+  assert.deepEqual(rules(lockfile, 'warn'), []);
+});
+
+test('size: a large-scale change is not warned about size', () => {
+  const findings = checkPullRequest(
+    pr({
+      labels: [LSC_LABEL],
+      files: [file('packages/ketcher-react/src/a.ts', 3000)],
+    }),
+  );
+  assert.ok(!rules(findings, 'warn').includes('size'));
+});
+
+test('unit test: domain or operations code without a unit test change warns', () => {
+  const domain = file('packages/ketcher-core/src/domain/entities/atom.ts');
+  assert.deepEqual(rules(checkPullRequest(pr({ files: [domain] })), 'warn'), [
+    'unit-test',
+  ]);
+
+  const withTest = checkPullRequest(
+    pr({
+      files: [
+        domain,
+        file('packages/ketcher-core/__tests__/domain/entities/atom.test.ts'),
+      ],
+    }),
+  );
+  assert.deepEqual(rules(withTest, 'warn'), []);
+
+  const removedOnly = checkPullRequest(
+    pr({
+      files: [
+        file(
+          'packages/ketcher-core/src/application/editor/operations/old.ts',
+          10,
+          'removed',
+        ),
+      ],
+    }),
+  );
+  assert.deepEqual(rules(removedOnly, 'warn'), []);
+});
+
+test('bug fix: a Bug issue with no unit or E2E test change warns', () => {
+  const bug = [{ number: 100, type: 'Bug' }];
+  assert.deepEqual(rules(checkPullRequest(pr({ linkedIssues: bug })), 'warn'), [
+    'bug-fix',
+  ]);
+
+  const withE2E = checkPullRequest(
+    pr({
+      linkedIssues: bug,
+      files: [
+        file('packages/ketcher-react/src/a.ts'),
+        file('ketcher-autotests/tests/specs/zoom/atom-labels.spec.ts'),
+      ],
+    }),
+  );
+  assert.deepEqual(rules(withE2E, 'warn'), []);
+});
+
+test('feature: a Feature issue with no OpenSpec change fails, except a backmerge', () => {
+  const feature = [{ number: 100, type: 'Feature' }];
+  assert.deepEqual(
+    rules(checkPullRequest(pr({ linkedIssues: feature })), 'fail'),
+    ['feature'],
+  );
+
+  const withChange = checkPullRequest(
+    pr({
+      linkedIssues: feature,
+      files: [
+        file('packages/ketcher-react/src/a.ts'),
+        file('openspec/changes/atom-labels/proposal.md'),
+      ],
+    }),
+  );
+  assert.deepEqual(rules(withChange, 'fail'), []);
+
+  const backmerge = checkPullRequest(
+    pr({ title: 'Backmerge: #100 - Atom labels', linkedIssues: feature }),
+  );
+  assert.deepEqual(rules(backmerge, 'fail'), []);
+});
+
+test('large-scale change: the unedited template fails on every section', () => {
+  const findings = checkPullRequest(
+    pr({ labels: [LSC_LABEL], body: LSC_TEMPLATE }),
+  );
+  const failed = findings.filter((f) => f.rule === 'large-scale-change');
+  assert.equal(failed.length, sections(LSC_TEMPLATE).size);
+  assert.ok(failed.every((f) => f.message.includes('template text')));
+});
+
+test('large-scale change: a missing section fails, filled sections pass', () => {
+  const filled = [...sections(LSC_TEMPLATE).keys()]
+    .filter((heading) => heading !== 'review map')
+    .map((heading) => `## ${heading}\n\nFilled in by the author.`)
+    .join('\n\n');
+  const findings = checkPullRequest(pr({ labels: [LSC_LABEL], body: filled }));
+  assert.deepEqual(
+    findings
+      .filter((f) => f.rule === 'large-scale-change')
+      .map((f) => f.message),
+    ['Section `review map` is missing.'],
+  );
+});
+
+test('large-scale change: without the label, the body is not checked', () => {
+  assert.deepEqual(
+    checkPullRequest(pr({ body: 'Memory bank: not needed' })),
+    [],
+  );
+});
+
+test('sections: splits at ## and ###, drops comments, lowercases headings', () => {
+  const result = sections(
+    '<!-- note -->\n## Merge Danger\n\nDoor\n\n### Revert plan\n\nRoll back.\n',
+  );
+  assert.deepEqual(
+    [...result],
+    [
+      ['merge danger', 'Door'],
+      ['revert plan', 'Roll back.'],
+    ],
+  );
+});
+
+test('memory bank: a missing line warns, any line passes', () => {
+  assert.deepEqual(rules(checkPullRequest(pr({ body: '' })), 'warn'), [
+    'memory-bank',
+  ]);
+  for (const body of [
+    'Memory bank: not needed',
+    '- Memory bank: `.memory-bank/domain.md`',
+    'memory bank:updated',
+  ]) {
+    assert.deepEqual(checkPullRequest(pr({ body })), [], body);
+  }
+});
+
+test('memory bank: a backmerge is skipped', () => {
+  const title = 'Backmerge: release/3.0 into master';
+  assert.deepEqual(
+    rules(checkPullRequest(pr({ title, body: '' })), 'warn'),
+    [],
+  );
+});
+
+test('reviewers: no reviewer warns, a draft is skipped', () => {
+  assert.deepEqual(
+    rules(checkPullRequest(pr({ requestedReviewers: 0 })), 'warn'),
+    ['reviewers'],
+  );
+  assert.deepEqual(
+    checkPullRequest(pr({ requestedReviewers: 0, isDraft: true })),
+    [],
+  );
+});
+
+test('feature: no test warns, a unit or E2E test passes', () => {
+  const linkedIssues = [{ number: 100, type: 'Feature' }];
