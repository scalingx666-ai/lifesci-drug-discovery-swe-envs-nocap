+@pytest.mark.usefixtures("batch_mol_graph_pytree")
+def test_mean_aggregation_onnx_parity_dynamic_batch(tmp_path):
+    ort = pytest.importorskip("onnxruntime")
+
+    export_smiles = ["c1ccccc1", "CC(=O)O"]
