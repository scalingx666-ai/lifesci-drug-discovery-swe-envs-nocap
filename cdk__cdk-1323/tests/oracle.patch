+    MCSSearch(MCSGraph graph, MCSGraph.Clock clock, int minBonds) {
+        this.graph = graph;
+        this.clock = clock;
+        this.minBonds = minBonds;
+        query = graph.query;
+        target = graph.target;
+        queryCount = query.atomCount;
+        targetCount = target.atomCount;
+        words = MCSGraph.words(targetCount);
