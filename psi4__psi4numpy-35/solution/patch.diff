+    "\\begin{align}\n",
+    "    \\tilde\\rho^L(\\mathbf{m}) &= \\int_V \\rho^L(\\mathbf{r}) e^{-2\\pi i\\mathbf{m}\\cdot\\mathbf{r}} \\mathrm{d}^3\\mathbf{r}\\\\\n",
+    "    \\tilde\\phi^L(\\mathbf{m}) &= \\int_V \\phi^L(\\mathbf{r}) e^{-2\\pi i\\mathbf{m}\\cdot\\mathbf{r}} \\mathrm{d}^3\\mathbf{r}\n",
