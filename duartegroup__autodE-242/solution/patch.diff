+            f"No viable unit conversion from {value.units} -> {units}"
         )
 
     # Convert to the base unit, then to the new units
@@ -214,16 +214,22 @@ def __add__(self, other) -> "Value":
             float(self) + self._other_same_units(other), units=self.units
         )
 
