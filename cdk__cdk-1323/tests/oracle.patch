+                for (int atom = 0; atom < side.atomCount; atom++) {
+                    root[atom] = atom;
+                    chainAtom[atom] = true;
+                    for (int place = side.start[atom]; place < side.start[atom + 1]; place++) {
+                        if (ringBond[side.neighbourBond[place]]) {
+                            chainAtom[atom] = false;
+                        } else {
