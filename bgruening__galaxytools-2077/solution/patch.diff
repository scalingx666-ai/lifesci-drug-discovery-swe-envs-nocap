+<tool id="metilene" name="metilene" version="@TOOL_VERSION@+galaxy@VERSION_SUFFIX@" profile="@PROFILE@">
+    <description>calling differentially methylated regions from bisulfite sequencing data</description>
+    <macros>
+        <import>macros.xml</import>
+    </macros>
+    <expand macro="requirements"/>
+    <command detect_errors="aggressive"><![CDATA[
+metilene_input.pl --in1 '$in1' --in2 '$in2'
+&& metilene
+    --maxdist $Options.maxdist
+    --mincpgs $Options.mincpgs
+    --minMethDiff $Options.minMethDiff
+    --threads "\${GALAXY_SLOTS:-4}"
+    #if $bed:
+        --mode 2
+        --bed '$bed'
+    #else
+        --mode 1
+    #end if
+    --mtc $Options.mtc
+    #if $Options.maxseg:
+        --maxseg $Options.maxseg
+    #end if
+    #if $Options.minNoA:
+        --minNoA $Options.minNoA
+    #end if
+    #if $Options.minNoB:
+        --minNoB $Options.minNoB
+    #end if
+    --valley $Options.valley
+    metilene_g1_g2.input
+    > metilene_raw.out
+## metilene emits the DMRs in genomic order only when run on a single thread,
+## so the (otherwise identical) results are sorted here to keep the output
+## deterministic and comparable regardless of the number of allocated slots.
+&& LC_ALL=C sort -k1,1 -k2,2n metilene_raw.out > '$output_bedlike'
+&& cut -f1-4 '$output_bedlike' > '$output_bedgraph'
+&& metilene_output.pl -q '$output_bedlike' -p 0.05 -o ./metilene
     ]]></command>
