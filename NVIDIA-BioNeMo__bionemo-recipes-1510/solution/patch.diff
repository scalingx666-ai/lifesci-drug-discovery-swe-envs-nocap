+            assert name in ref_grads, f"Unexpected gradient for {name}"
+            torch.testing.assert_close(
+                g,
+                ref_grads[name],
+                atol=1e-5,
+                rtol=1e-5,
+                msg=f"All-to-all gradient mismatch for {name}",
+            )
