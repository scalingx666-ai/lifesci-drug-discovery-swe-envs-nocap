new file mode 100644
index 00000000..cdb071f6
--- /dev/null
+++ b/nglview/tests/test_show.py
@@ -0,0 +1,31 @@
+import subprocess
+from mock import MagicMock
+import nglview
+import numpy as np
+
+# local
+from make_dummy_comm import *
+# TODO : add more show_xxx
+# (check test_widgets.py)
+
+def _write(*args, **kargs):
+    # fake write method
+    subprocess.check_call([
+        'cp', nglview.datafiles.PDB,
+        'tmp.pdb'
+    ])
+
+def test_show_schrodinger_structure():
+    s = MagicMock()
+    s.write = _write
+    nglview.show_schrodinger_structure(s)
+
+
+def test_show_htmd():
+    mol = MagicMock()
+    mol.write = _write
+    n_frames = 10
+    mol.coordinates = np.zeros((n_frames, 1000, 3))
+    mol.numFrames = n_frames
+    view = nglview.show_htmd(mol)
+    view
