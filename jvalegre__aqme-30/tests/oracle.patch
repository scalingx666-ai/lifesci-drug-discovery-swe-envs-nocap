+                sdwriter,
+                args,
+                log,
+                update_to_rdkit,
+                coord_Map,
+                alg_Map,
+                mol_template,
+            )
+        else:
+            args.charge = rules_get_charge(mol, args)
+            dup_data.at[dup_data_idx, "Overall charge"] = np.sum(args.charge)
+            status = crest_opt(
+                mol,
+                name,
