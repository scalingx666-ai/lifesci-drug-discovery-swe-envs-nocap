+  assert.deepEqual(
+    rules(checkPullRequest(pr({ linkedIssues, files: [change] })), 'warn'),
+    ['feature-test'],
+  );
+  for (const test of [
+    'packages/ketcher-core/src/a.test.ts',
+    'ketcher-autotests/tests/a/b.spec.ts',
