+            δVσ3 .+= @. Vσl[5,:]*δl[1,:] + Vσl[6,:]*δl[2,:]
+        end
+        return libxc_combine_spins(δVσ1, δVσ2, δVσ3)
+    end
+end
+@views function libxc_assemble_δVτ(Vρτ, δρ, Vστ, δσ, Vττ, δτ,
