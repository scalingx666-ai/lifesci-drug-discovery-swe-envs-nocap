+@uusing("s-dftd3_160")
+@pytest.mark.parametrize("name_hint,level_hint,ref", [
+    pytest.param("b3lyp-d3bj", None, _wd_b3lyp_d3bj_hess_findif5, id="d3bj2b"),
+    pytest.param("pbe0", "d3mzeroatm", _wd_pbe0_d3mzeroatm_hess_findif5, id="d3mzeroatm"),
+])
+def test_dftd3_analytic_hessian(name_hint, level_hint, ref):
+    from psi4.driver.procrouting.empirical_dispersion import EmpiricalDispersion
+
+    mol = psi4.geometry(_wd_hess)
+    mol.update_geometry()
+    wfn = psi4.core.Wavefunction.build(mol, "sto-3g")
+
+    disp = EmpiricalDispersion(name_hint=name_hint, level_hint=level_hint)
+    assert disp.engine == "s-dftd3"
+    assert disp._analytic_hessian_available()
+
+    hess = disp.compute_hessian(mol, wfn)
+    assert compare_values(ref, hess, 9, f"{name_hint} {level_hint} analytic vs findif5 Hessian")
+    assert compare_values(ref, wfn.variable("DISPERSION CORRECTION HESSIAN"), 9, "DISPERSION CORRECTION HESSIAN qcvar")
+
+
+@uusing("s-dftd3")
+@pytest.mark.parametrize("name_hint,level_hint,ref", [
+    pytest.param("b3lyp-d3bj", None, _wd_b3lyp_d3bj_hess_findif5, id="d3bj2b"),
+    pytest.param("pbe0", "d3mzeroatm", _wd_pbe0_d3mzeroatm_hess_findif5, id="d3mzeroatm"),
+])
+def test_dftd3_findif_hessian(name_hint, level_hint, ref, monkeypatch):
+    from psi4.driver.procrouting.empirical_dispersion import EmpiricalDispersion
+
+    mol = psi4.geometry(_wd_hess)
+    mol.update_geometry()
+
+    # force the 3-point fallback, which must not project out rotations
+    disp = EmpiricalDispersion(name_hint=name_hint, level_hint=level_hint)
+    monkeypatch.setattr(disp, "_analytic_hessian_available", lambda: False)
+
+    hess = disp.compute_hessian(mol)
+    assert compare_values(ref, hess, 7, f"{name_hint} {level_hint} findif3 vs findif5 Hessian")
+
+
+def test_libdisp_hessian_findif():
+    from psi4.driver.procrouting.empirical_dispersion import EmpiricalDispersion
+
+    disp = EmpiricalDispersion(name_hint="b3lyp-d2", engine="libdisp")
+    assert not disp._analytic_hessian_available()
