+  # Every concentration is on the line from get_halflife_fit()
+  fit_by_row <- hl_fit[match(hl_curve$Subject, hl_fit$Subject), ]
+  expect_equal(hl_curve$conc, exp(fit_by_row$intercept + fit_by_row$slope*hl_curve$time))
