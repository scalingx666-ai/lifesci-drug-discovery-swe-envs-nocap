+THC_Computer::THC_Computer(std::shared_ptr<Molecule> molecule, std::shared_ptr<BasisSet> primary, Options& options) :
+    molecule_(molecule), primary_(primary), options_(options) {}
+
+THC_Computer::~THC_Computer() {}
