+      "\n"
+     ]
+    }
+   ],
+   "source": [
+    "# Get the SCF wavefunction & energies\n",
+    "scf_e, scf_wfn = psi4.energy('scf', return_wfn=True)\n",
+    "\n",
+    "# ==> Nuclear Repulsion Energy <==\n",
