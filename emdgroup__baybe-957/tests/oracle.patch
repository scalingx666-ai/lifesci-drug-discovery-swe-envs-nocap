+    posterior.assert_called_once()
+    assert posterior.call_args.args[0].shape == (
+        n_rows,
+        1,
+        len(searchspace.comp_rep_columns),
+    )
+    assert predictions.shape == (n_rows,)
+    np.testing.assert_allclose(predictions, expected)
