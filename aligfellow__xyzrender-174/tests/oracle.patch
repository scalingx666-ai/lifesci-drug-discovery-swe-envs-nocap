+    bonds: list[tuple[int, int, float]] = []
+    for k in range(len(index) // 2):
+        try:
+            i, j = remap.get(int(index[2 * k]), -1), remap.get(int(index[2 * k + 1]), -1)
+        except (TypeError, ValueError):
