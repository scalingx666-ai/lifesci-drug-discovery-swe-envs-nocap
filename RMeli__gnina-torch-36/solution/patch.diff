+import re
+
+import molgrid
+import numpy as np
+import pytest
+import torch
+
+from gnina import gnina, models
+from gnina.dataloaders import GriddedExamplesLoader
+
+
+@pytest.mark.parametrize(
+    "input_key, output_key",
