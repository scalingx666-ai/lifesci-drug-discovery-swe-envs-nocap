+def test_load_moleculeace_benchmark():
+    benchmark_full = load_moleculeace_benchmark(as_frames=True)
+    benchmark_names = [name for name, df in benchmark_full]
+    assert benchmark_names == MOLECULEACE_DATASET_NAMES
+
