+    "    \\phi(\\mathbf{r}) = \\frac{1}{4\\pi^2\\epsilon_0 V}\n",
+    "        \\sum_{\\mathbf{m}\\ne\\mathbf{0}}\\frac{e^{-\\frac{m^2\\pi^2}{\\alpha^2}}}{m^2}\n",
