+            <param name="sets" type="text" value="" optional="true" label="Sets" help="Comma-separated list of keys for grouping cells. Use 'name' for simple sets or 'name:score' for scored sets. Example: 'cluster, celltype:celltype_prob'.">
+                <sanitizer invalid_char="">
+                    <valid initial="string.ascii_letters,string.digits">
+                        <add value="_"/>
+                        <add value="-"/>
+                        <add value="."/>
+                        <add value=","/>
+                        <add value=":"/>
+                        <add value=" "/>
+                    </valid>
+                </sanitizer>
+            </param>
+            <param name="matrix" type="text" value="X" optional="true" label="Matrix" help="Expression matrix to use in the Vitessce config. Default: X.">
+                <expand macro="sanitizer_options"/>
+            </param>
+        </section>
+        <section name="sec_advanced_options" title="Advanced options" expanded="false">
+            <param argument="--title" type="text" value="" optional="true" label="Title" help="Data title to show in the visualization.">
+                <expand macro="sanitizer_printable"/>
