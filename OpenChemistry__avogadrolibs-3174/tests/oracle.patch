+UnitCell makeCell(double a, double b, double c, double alphaDeg, double betaDeg,
+                  double gammaDeg)
+{
+  const double d2r = 3.14159265358979323846 / 180.0;
+  return UnitCell(a, b, c, alphaDeg * d2r, betaDeg * d2r, gammaDeg * d2r);
