+     "output_type": "display_data"
+    }
+   ],
+   "source": [
+    "to_visualize = 0 # Change this to visualize other clusters\n",
+    "img1, img2 = sampled_MSC(cluster=clusters[to_visualize], smiles = smiles, n_samples=25)\n",
+    "print(f\"Sample of molecules in the cluster {to_visualize}, population {len(clusters[to_visualize])}:\")\n",
+    "display(img1)\n",
+    "print(f\"MCS:\")\n",
+    "display(img2)"
+   ]
+  },
+  {
+   "cell_type": "markdown",
+   "id": "0944b9ee",
+   "metadata": {},
+   "source": [
+    "It is evident that there is a big cluster with structures that do not go together. To solve this, we are going to use the refinement method `refine_inplace`, this method breaks apart the big cluster and passes the molecules through the tree. Note that we increase the threshold to prevent the reformation of the big cluster. It is only necessary when there is an overly-large cluster."
+   ]
+  },
+  {
+   "cell_type": "code",
+   "execution_count": 52,
+   "id": "c14a653c",
+   "metadata": {},
+   "outputs": [
+    {
+     "data": {
+      "text/plain": [
+       "BitBirch(threshold=0.7807536475095639, branching_factor=1024, merge_criterion='diameter')"
+      ]
+     },
+     "execution_count": 52,
+     "metadata": {},
+     "output_type": "execute_result"
+    }
+   ],
+   "source": [
+    "bb_tree.threshold += 1 * isim_sigma  # Increase threshold to avoid reforming large clusters\n",
+    "bb_tree.refine_inplace(fps)"
+   ]
+  },
+  {
+   "cell_type": "code",
