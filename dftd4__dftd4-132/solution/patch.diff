diff --git a/.github/workflows/fortran-build.yml b/.github/workflows/fortran-build.yml
index b6e821c4d..a8ae3b715 100644
--- a/.github/workflows/fortran-build.yml
+++ b/.github/workflows/fortran-build.yml
