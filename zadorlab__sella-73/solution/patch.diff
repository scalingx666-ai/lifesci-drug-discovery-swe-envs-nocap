+        # XS_S is (k, k) and tiny; use solve.
+        XS_S_t = XS_t @ S_t  # (k, k)
+        # Use lstsq for parity with numpy path (handles k=1 trivially).
+        U_t = torch.linalg.lstsq(XS_S_t, XS_t).solution.T
