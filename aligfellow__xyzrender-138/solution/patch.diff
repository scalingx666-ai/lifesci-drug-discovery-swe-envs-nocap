+    rot = _rotation_z(50.0)
+    g_mob = _rigid_transform_graph(g_ref, rot, np.array([2.0, -1.0, 3.0]))
+    _, rmsd = best_fit_align(g_ref, g_mob)
+    assert rmsd < 1e-6
+
+
+def test_best_fit_align_returns_finite_for_different_molecules() -> None:
