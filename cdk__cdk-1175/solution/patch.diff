+    	logger.setLevel(ILoggingTool.FATAL);
+    	logger.fatal("test");
+    	errContent.flush();
+    	String output = new String(errContent.toByteArray());
+    	Assertions.assertTrue(output.contains("FATAL: test"));
+    }
+
+    @Test
+    void testWarn() throws IOException {
