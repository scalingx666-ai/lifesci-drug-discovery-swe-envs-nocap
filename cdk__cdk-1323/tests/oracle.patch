+    static Set<String> inverses(Collection<int[]> mappings, int size) {
+        Set<String> keys = new HashSet<>();
+        for (int[] mapping : mappings) {
+            keys.add(Arrays.toString(inverse(mapping, size)));
+        }
+        return keys;
+    }
