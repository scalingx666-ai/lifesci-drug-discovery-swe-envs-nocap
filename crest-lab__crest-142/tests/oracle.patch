+!============================================================!
+! count number of bonds from an wbo matrix
+!============================================================!
+  function countbonds(nat,wbo) result(nbd)
+    implicit none
+    integer,intent(in)  :: nat
+    real(wp),intent(in) :: wbo(nat,nat)
+    integer :: nbd
+    integer :: i,j,k
+    nbd = 0
+    do i=1,nat
+     do j=1,i-1
+       k = nint(wbo(i,j))
+       if(k > 0) nbd = nbd + 1 
+     enddo
+    enddo
+    return
+  end function countbonds
 
