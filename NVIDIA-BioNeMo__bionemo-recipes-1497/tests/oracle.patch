+
+if [ $# -gt 0 ]; then
+    echo "==> Running command: $*"
+    docker exec \
+        --user "${REMOTE_USER}" \
+        -w "${WORKSPACE_FOLDER}" \
+        "${CONTAINER_NAME}" \
+        "$@"
+else
+    echo "    Attach with:  docker exec -it ${CONTAINER_NAME} bash"
+    echo "    Stop with:    docker rm -f ${CONTAINER_NAME}"
+    echo ""
+    echo "==> Attaching interactive shell…"
+    exec docker exec -it \
+        --user "${REMOTE_USER}" \
+        -w "${WORKSPACE_FOLDER}" \
+        "${CONTAINER_NAME}" \
+        bash
+fi
