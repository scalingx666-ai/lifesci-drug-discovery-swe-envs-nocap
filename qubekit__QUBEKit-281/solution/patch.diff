+def test_read_rb_terms(tmpdir):
+    """
+    Make sure we can parameterise a molecules using an xml file with RB torsion terms.
+    """
+    with tmpdir.as_cwd():
+        mol = Ligand.from_file(file_name=get_data("cyclohexane.sdf"))
