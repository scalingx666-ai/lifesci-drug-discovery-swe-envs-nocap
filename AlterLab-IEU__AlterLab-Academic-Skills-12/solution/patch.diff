+            VERSION="${{ github.event.inputs.version }}"
+            [ -n "$VERSION" ] || VERSION="$PYPROJECT_VERSION"
+            TAG="v${VERSION}"
+          fi
           echo "pyproject version: $PYPROJECT_VERSION"
-          if [ "$TAG" != "$PYPROJECT_VERSION" ]; then
