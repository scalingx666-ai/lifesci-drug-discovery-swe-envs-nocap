diff --git a/{{cookiecutter.repo_name}}/.travis.yml b/{{cookiecutter.repo_name}}/.travis.yml
index fd2dc6c..9999713 100644
--- a/{{cookiecutter.repo_name}}/.travis.yml
+++ b/{{cookiecutter.repo_name}}/.travis.yml
@@ -12,12 +12,21 @@ matrix:
       language: generic
       env: PYTHON_VER=3.7
 
+{% if cookiecutter.dependency_source == 'Dependencies from pip only (no conda)' %}
+    # Pip can use Travis build-in Python
     - os: linux
       python: 3.6
-      env: PYTHON_VER=3.6
     - os: linux
+      dist: xenial  # Travis Trusty image does not have Python 3.7, Xenial does
       python: 3.7
+{% else %}
+    - os: linux
+      language: generic  # No need to set Python version since its conda
+      env: PYTHON_VER=3.6
+    - os: linux
+      language: generic
       env: PYTHON_VER=3.7
+{% endif %}
 
 before_install:
     # Additional info about the build
diff --git a/{{cookiecutter.repo_name}}/devtools/travis-ci/before_install.sh b/{{cookiecutter.repo_name}}/devtools/travis-ci/before_install.sh
index 83e6b4f..3630c65 100755
--- a/{{cookiecutter.repo_name}}/devtools/travis-ci/before_install.sh
+++ b/{{cookiecutter.repo_name}}/devtools/travis-ci/before_install.sh
@@ -13,7 +13,6 @@ if [ "$TRAVIS_OS_NAME" == "osx" ]; then
     MINICONDA=Miniconda3-latest-MacOSX-x86_64.sh
 else
     MINICONDA=Miniconda3-latest-Linux-x86_64.sh
-    export PYTHON_VER=$TRAVIS_PYTHON_VERSION
 fi
 MINICONDA_HOME=$HOME/miniconda
 MINICONDA_MD5=$(curl -s https://repo.continuum.io/miniconda/ | grep -A3 $MINICONDA | sed -n '4p' | sed -n 's/ *<td>\(.*\)<\/td> */\1/p')
