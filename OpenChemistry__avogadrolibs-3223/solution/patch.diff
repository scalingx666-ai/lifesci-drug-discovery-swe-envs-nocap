+    with pytest.raises(TypeError):
+        state_cls.energy.__get__(5)
+    with pytest.raises(TypeError):
+        calc.LbfgsParameters.max_step.__get__(5)
+    with pytest.raises(TypeError):
+        calc.OptimizationOptions.lbfgs.__get__(5)
+    with pytest.raises(TypeError):
+        calc.OptimizationOptions.lbfgs.__set__(5, calc.LbfgsParameters())
