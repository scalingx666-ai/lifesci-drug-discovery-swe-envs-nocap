+  implicit none
+  character(len=*) :: line
+  character(len=*) :: argument
+
+  character(len=256) :: dummy
+  character(len=1) :: digit
+  integer :: i,j
+
+  line = adjustl(line)
+
+  do i = 1,len(trim(line))
