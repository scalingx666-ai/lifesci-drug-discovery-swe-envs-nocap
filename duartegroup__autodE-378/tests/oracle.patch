+def _rdkit_conformer_method_string() -> str:
+    """Get the method for RDKit, depending on the version"""
+    if hasattr(AllChem, "srETKDGv3"):
+        return "srETKDGv3"
+    elif hasattr(AllChem, "ETKDGv3"):
+        return "ETKDGv3"
+    else:
+        return "ETKDGv2"
+
+
 def _is_xyz_filename(value: str) -> bool:
