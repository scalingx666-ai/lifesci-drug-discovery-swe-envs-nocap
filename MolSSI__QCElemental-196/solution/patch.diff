+        noncomment = "#define pc_{} {}".format(callname, qca.data)
+        text.append("{:80}  /*- {} [{}] {} -*/".format(noncomment, qca.label, qca.units, qca.comment))
+    text.append("/* clang-format on */")
+
+    text.append("")
+    text.append("/* For Cray X1 compilers */")
+    text.append("#ifndef M_PI")
