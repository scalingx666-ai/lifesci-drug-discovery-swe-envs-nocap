diff --git a/.github/dependabot.yml b/.github/dependabot.yml
new file mode 100644
index 00000000000..f90ee8b40c0
--- /dev/null
+++ b/.github/dependabot.yml
@@ -0,0 +1,12 @@
+version: 2
+updates:
+  # Workflow actions are pinned to commit SHAs. Dependabot opens one grouped
+  # PR per month that moves the SHAs and the version comments to new releases.
+  - package-ecosystem: github-actions
+    directory: /
+    schedule:
+      interval: quarterly
+    groups:
+      github-actions:
+        patterns:
+          - '*'
\ No newline at end of file
