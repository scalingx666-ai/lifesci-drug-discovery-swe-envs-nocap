+  integer :: atlist(nat)
+  logical :: reverse
+  integer :: i,j,k,l
+  character(len=10) :: dum
+  integer :: rev
+
+  if (reverse) then
+    rev = 0
+  else
+    rev = 1
+  end if
+  atstr = ''
+  k = 0
+  iloop: do i = 1,nat
+    if (k .gt. 0) then
+      k = k - 1
+      cycle iloop
