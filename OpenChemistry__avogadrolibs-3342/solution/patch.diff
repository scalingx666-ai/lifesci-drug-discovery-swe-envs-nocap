+  const double s2 = s * s;
+  int k = -1; // index of the rightmost parabola in the envelope
+  for (int q = 0; q < n; ++q) {
+    if (!std::isfinite(g[q]))
+      continue;
+    if (k < 0) {
+      k = 0;
+      vertex[0] = q;
+      bound[0] = -inf;
+      bound[1] = inf;
+      continue;
+    }
+    double cross = 0.0;
+    while (true) { // bound[0] is -infinity, so k never goes below 0
+      const int r = vertex[k];
