+   use iso_fortran_env, only: wp => real64
+   use strucrd
+
+   implicit none
+   integer, intent(in)         :: n1, n2, iter
+   real(wp)                    :: xyz1(3, n1)
+   real(wp)                    :: xyz2(3, n2*iter)
+   integer                     :: at1(n1), at2(n2*iter)
+   character(len=*), intent(in) :: fname_cluster, fname_solu_cut, fname_solv_cut
+   character(len=256)         :: atmp
