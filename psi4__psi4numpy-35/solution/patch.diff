+    "def ewald_rec_energy(alpha, maxm):\n",
+    "    \"\"\" Evaluate the long range (reciprocal space) Ewald energy using an\n",
+    "        attenuation parameter of alpha, and using up to maxm wavevectors. \"\"\"\n",
