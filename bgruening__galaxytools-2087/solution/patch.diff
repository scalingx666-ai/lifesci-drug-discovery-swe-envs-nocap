+            </param>
+            <param argument="--chm-resolution" type="float" min="0.001" max="1" value="0.5" label="CHM resolution (m)" help="Must divide 1 m evenly, for example 0.1, 0.2, 0.25, 0.5 or 1.">
+                <validator type="expression" message="Must divide 1 m evenly, for example 0.1, 0.2, 0.25, 0.5 or 1">abs(1 / value - round(1 / value)) &lt;= 1e-9 * max(1, 1 / value)</validator>
+            </param>
+            <param argument="--ptd-resolution" type="float" min="0.001" max="1000" value="20" label="Ground-seed resolution (m)" help="Seed resolution of the progressive TIN densification (PTD) ground classification."/>
