diff --git a/.github/workflows/pytest_cov.yml b/.github/workflows/pytest_cov.yml
new file mode 100644
index 000000000..27259a93b
--- /dev/null
+++ b/.github/workflows/pytest_cov.yml
@@ -0,0 +1,44 @@
+name: pytest_codecov
+
+on: [push, pull_request]
+
+jobs:
+  test:
+    name: Env (${{ matrix.python-version }}, ${{ matrix.os }})
+    runs-on: ${{ matrix.os }}
+
+    strategy:
+      fail-fast: true
+      matrix:
+        os: ["ubuntu-latest"]
+        python-version: ["3.7", "3.9"]   
+        
+    defaults:
+      run:
+        shell: bash -l {0}
+        
+    steps:
+    - uses: actions/checkout@v2
+        
+    - uses: conda-incubator/setup-miniconda@v2
+      with:
+        python-version: ${{ matrix.python-version }}
+        channels: conda-forge,defaults
+        auto-update-conda: true
+
+    - name: Install
+      run: |
+        conda activate test
+        conda install --file requirements.txt
+        conda install --file tests/requirements.txt
+        conda install xtb
+        python -m pip install . --no-deps
+
+    - name: Test
+      run: |
+        py.test --cov-report xml --cov autode tests/
+        
+    - uses: codecov/codecov-action@v1
+      with:
+        flags: unittests
+        fail_ci_if_error: true
