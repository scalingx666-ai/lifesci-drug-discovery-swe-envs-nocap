-    "    # 5. The metadata\n",
-    "    name=\"my-first-benchmark\",\n",
-    "    owner=\"your-username\", \n",
-    "    description=\"Created using the Polaris tutorial\",\n",
-    "    tags=[\"tutorial\"], \n",
-    "    user_attributes={\"Key\": \"Value\"}\n",
-    ")"
-   ]
-  },
-  {
