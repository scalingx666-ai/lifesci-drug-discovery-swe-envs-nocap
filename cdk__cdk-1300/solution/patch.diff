+                        for (IAtom nbor : e2.getValue()) {
+                            if (visited.add(nbor)) {
+                                complex = true;
+                                queue.add(nbor);
+                            }
+                        }
+                    }
+                } else {
+                    for (Map.Entry<IBond,Set<IAtom>> e2 : e.getValue()) {
+                        if (e2.getValue().contains(atom) && visited.add(e.getKey())) {
+                                complex = true;
+                            queue.add(e.getKey());
+                        }
+                    }
+                }
+            }
+        }
+        return complex;
+    }
