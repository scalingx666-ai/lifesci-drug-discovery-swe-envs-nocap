diff --git a/.github/workflows/build_linux.yml b/.github/workflows/build_linux.yml
index 531953d4869..f79fc89431f 100644
--- a/.github/workflows/build_linux.yml
+++ b/.github/workflows/build_linux.yml
@@ -181,6 +181,31 @@ jobs:
         rm appdir/AppRun
         cp ../avogadrolibs/openchemistry/avogadrolibs/scripts/AppImage.sh appdir/AppRun
         chmod a+x appdir/AppRun
+        # Bundled programs must run without LD_LIBRARY_PATH, since Avogadro
+        # strips it from child processes
+        checked=0
+        missing=""
+        for f in appdir/usr/bin/* appdir/usr/lib/openbabel/*.so; do
+          if file -b "$f" | grep -q ELF; then
+            checked=$((checked + 1))
+            deps=$(env -u LD_LIBRARY_PATH ldd "$f" 2>&1 | grep "not found" || true)
+            if [ -n "$deps" ]; then
+              missing="$missing$(echo "$deps" | sed "s|^|$f: |")"$'\n'
+            fi
+          fi
+        done
+        echo "Checked $checked ELF files with ldd"
+        if [ "$checked" -eq 0 ]; then
+          echo "No ELF files found to check"
+          exit 1
+        fi
+        if [ -n "$missing" ]; then
+          printf '%s' "$missing"
+          exit 1
+        fi
+        out=$(env -u LD_LIBRARY_PATH BABEL_LIBDIR=appdir/usr/lib/openbabel BABEL_DATADIR=$(echo appdir/usr/share/openbabel/*) appdir/usr/bin/obabel -:CCO -oinchi)
+        echo "$out"
+        echo "$out" | grep -q "InChI=1S/C2H6O" || exit 1
         ./appimagetool-x86_64.AppImage appdir
         mv Avogadro*.AppImage avogadroapp/Avogadro2-x86_64.AppImage # for upload
       working-directory: ${{ runner.workspace }}/build
