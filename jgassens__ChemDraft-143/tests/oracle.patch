+/* Frame depth stays inside the webview and follows any palette size or orientation.
+   Paint above opaque children without intercepting title, tool, or resize-handle hits. */
+.palette-window-shell,
+.plugin-panel-shell {
+  position: relative;
+}
+
+.palette-window-shell::after,
+.plugin-panel-shell::after,
+.web-floating-palette::after {
+  content: "";
+  position: absolute;
+  inset: 0;
+  z-index: 1;
+  border-radius: inherit;
+  box-shadow: var(--cd-shadow-edge);
+  pointer-events: none;
+}
