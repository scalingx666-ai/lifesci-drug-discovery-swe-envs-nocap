+   "metadata": {
+    "collapsed": true
+   },
+   "outputs": [],
+   "source": [
+    "# ==> Molecule & Psi4 Options Definitions <==\n",
+    "mol = psi4.geometry(\"\"\"\n",
+    "0 1\n",
+    "O\n",
+    "H 1 1.1\n",
+    "H 1 1.1 2 104\n",
+    "symmetry c1\n",
+    "\"\"\")\n",
+    "\n",
+    "\n",
+    "\n",
+    "psi4.set_options({'basis':        '6-31g',\n",
