+        conda install -c conda-forge -y \
+          numpy scipy matplotlib scikit-learn pandas pyyaml click tqdm \
+          rdkit biopython
         # Install additional deps that might not be in conda-forge
         python -m pip install psutil requests pytest pytest-cov flake8
         python -m pip install -e .
