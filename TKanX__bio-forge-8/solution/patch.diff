+
+    #[test]
+    fn build_uses_hetero_template_for_hetero_residue() {
+        let template = Template::new(
+            "LIG",
+            vec!["C1".into(), "O1".into(), "H1".into()],
+            vec![
+                ("C1".into(), "O1".into(), BondOrder::Double),
+                ("C1".into(), "H1".into(), BondOrder::Single),
