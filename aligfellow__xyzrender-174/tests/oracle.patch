-            new_origin = (origin - fit_centroid) @ rot.T
+            new_origin = (origin - centroid) @ rot.T
             self.cell_data.lattice = new_lat
             self.cell_data.cell_origin = new_origin
             self.graph.graph["lattice"] = new_lat
