+    struct RecursionDepthGuard
+    {
+      RecursionDepthGuard(Timeout &timeout) : m_timeout(timeout) { ++m_timeout.depth; }
+      ~RecursionDepthGuard() { --m_timeout.depth; }
+      Timeout &m_timeout;
     };
 
 
