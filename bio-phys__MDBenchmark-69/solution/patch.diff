+
+    assert validate_cpu_gpu_flags(cpu=True, gpu=False) is None
+    assert validate_cpu_gpu_flags(cpu=False, gpu=True) is None
+    assert validate_cpu_gpu_flags(cpu=True, gpu=True) is None
+
