diff --git a/cmake/FindPythonModule.cmake b/cmake/FindPythonModule.cmake
index 2b6f93172c0..86fc54040f6 100644
--- a/cmake/FindPythonModule.cmake
+++ b/cmake/FindPythonModule.cmake
@@ -73,8 +73,8 @@ macro(find_python_module module)
 
             if(${module}_tgtver)
                 execute_process(COMMAND "${Python_EXECUTABLE}" "-c"
-                                        "from pkg_resources import parse_version; \
-                                         print(parse_version('${${module}_VERSION}') ${_op} parse_version('${${module}_tgtver}'))"
