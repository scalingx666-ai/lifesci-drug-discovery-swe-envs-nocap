diff --git a/tests/test_RI_SCF.py b/tests/test_RI_SCF.py
index 6725a90e..c7aee724 100644
--- a/tests/test_RI_SCF.py
+++ b/tests/test_RI_SCF.py
@@ -21,6 +21,16 @@ def test_RHF(workspace):
     exe_py(workspace, tdir, 'RHF')
 
 
+@using_psi4_python_integral_deriv
+def test_RHF_Gradient(workspace):
+    exe_py(workspace, tdir, 'RHF_Gradient')
+
+
