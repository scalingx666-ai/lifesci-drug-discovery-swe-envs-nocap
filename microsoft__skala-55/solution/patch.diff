+            return torch.where(alpha <= 1.0, scan_interp, tail_interp)
+        if self.interpolation_mode == 1:
+            poly_interp = self._scan_horner(alpha, self.x_params)
+            return torch.where(
+                alpha <= 0.0,
+                scan_interp,
+                torch.where(alpha <= 2.5, poly_interp, tail_interp),
+            )
