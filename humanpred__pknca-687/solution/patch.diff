+  expect_lt(min(eigen(G, symmetric = TRUE)$values), 1e-8)
+  expect_fda_matches_nlme(w, tol = 1e-3)
+  expect_equal(m$contrasts$T$df, fda_dense_df(w, m), tolerance = 1e-3)
