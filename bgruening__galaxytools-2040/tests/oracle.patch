+                    <has_text text="`${table}/index_1.html`"/>
                     <not_has_text text="movies"/>
                 </assert_contents>
             </output>
@@ -136,7 +140,7 @@ datavzrd config.yaml --output report_output --overwrite-output &&
             <param name="output_format" value="html"/>
             <output name="output_html" ftype="html">
                 <assert_contents>
-                    <has_text text="const name = 'Datavzrd Report';"/>
+                    <has_text text="const name = &quot;Datavzrd Report&quot;;"/>
                     <has_text text="&quot;oscars&quot;:null"/>
                     <has_text text="&quot;movies&quot;:null"/>
                     <has_text text="&lt;script src=&quot;./static/bundle.js&quot;&gt;"/>
@@ -159,7 +163,7 @@ datavzrd config.yaml --output report_output --overwrite-output &&
             <param name="output_format" value="html"/>
             <output name="output_html" ftype="html">
                 <assert_contents>
-                    <has_text text="const name = 'My oscar report';"/>
+                    <has_text text="const name = &quot;My oscar report&quot;;"/>
                     <has_text text="&quot;oscars&quot;:"/>
                     <has_text text="&quot;movies&quot;:null"/>
                     <has_text text="&quot;oscar-plot&quot;:"/>
@@ -182,8 +186,10 @@ datavzrd config.yaml --output report_output --overwrite-output &&
             <param name="output_format" value="html"/>
             <output name="output_html" ftype="html">
                 <assert_contents>
-                    <has_text text="const name = 'Gene Report';"/>
+                    <has_text text="const name = &quot;Gene Report&quot;;"/>
                     <has_text text="const views = {&quot;genes&quot;:null};"/>
+                    <!-- Since datavzrd 2.73.2 reports with a single view skip the landing page -->
+                    <has_text text="const table = &quot;genes&quot;;"/>
                     <has_text text="&lt;script src=&quot;./static/bundle.js&quot;&gt;"/>
                 </assert_contents>
             </output>
