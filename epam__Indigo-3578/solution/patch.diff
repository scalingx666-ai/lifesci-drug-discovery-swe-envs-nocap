+    cp_errors.append(
+        "Expected 2 pendant atoms, got {}".format(len(pendant_ids))
+    )
+
+if len(ring_ids) != 10:
+    cp_errors.append("Expected 10 ring vertices, got {}".format(len(ring_ids)))
+else:
+    ok, msg = _is_regular_polygon(list(ring_ids), cp_positions)
+    if not ok:
