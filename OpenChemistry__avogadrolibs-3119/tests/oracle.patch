+  EXPECT_DOUBLE_EQ(spin->minimum(), FragmentTools::minimumChainDistance);
+  EXPECT_DOUBLE_EQ(spin->maximum(), FragmentTools::maximumChainDistance);
+  EXPECT_EQ(edited.count(), 0);
