       # The committed notebook (and the docs site) stay unbounded; this edits the
       # working-tree copy so tox -e notebook fits in the runner's memory.
       - name: Cap notebook memory for CI
+        if: runner.os != 'Windows'
         run: python tools/ci_cap_notebook_memory.py
       # Run the environments serially. In parallel mode, tox buffers each
       # environment's output and replays it once the run finishes, and a
       # failing environment's stderr does not survive that replay -- which
       # hides the compiler error when building fulqrum from its sdist fails.
+      #
+      # Windows runs the unit tests only. The notebooks need fulqrum and
+      # sbd-eigensolver, which publish no Windows wheels and build only against
+      # the BLAS, OpenMP and MPI installed above for Linux and macOS.
       - name: Test using tox environment
         shell: bash
         env:
