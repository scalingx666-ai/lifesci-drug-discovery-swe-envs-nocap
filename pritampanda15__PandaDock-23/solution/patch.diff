-            float inv_dist2 = inv_dist * inv_dist;
-            float inv_dist7 = inv_dist2 * inv_dist2 * inv_dist2 * inv_dist;
-            float inv_dist13 = inv_dist7 * inv_dist2 * inv_dist2 * inv_dist2;
