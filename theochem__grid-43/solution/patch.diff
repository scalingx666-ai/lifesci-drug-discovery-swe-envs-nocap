+def size_to_degree(num_array):
+    """Generate degs given nums."""
+    num_array = np.array(num_array)
+    unik_arr = np.unique(num_array)
+    degs = np.zeros(num_array.size)
+    for i in unik_arr:
+        deg = _select_grid_type(size=i)[0]
+        degs[np.where(num_array == i)] = deg
+    return degs
