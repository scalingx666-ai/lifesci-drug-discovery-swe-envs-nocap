+        for j, tol in enumerate(tolerances):
+            old, nom = get_old_and_nom(fps, j, ">1, >1")
+            old_ls = old.sum(0)
+            nom_ls = nom.sum(0)
+            new_ls = old_ls + nom_ls
+            old_n = len(old)
+            nom_n = len(nom)
+            new_n = old_n + nom_n
+            fn = NeverMerge(tolerance=tol)
+            val = fn(thresh, new_ls, new_n, old_ls, nom_ls, old_n, nom_n)
+            assert not val
