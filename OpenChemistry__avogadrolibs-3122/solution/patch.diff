+  ASSERT_NE(basis, nullptr);
+  ASSERT_EQ(basis->symmetry().size(), 2);
+  EXPECT_EQ(basis->symmetry()[0], GaussianSet::S);
+  EXPECT_EQ(basis->symmetry()[1], GaussianSet::P);
+  EXPECT_EQ(basis->atomIndices()[0], 0);
+  EXPECT_EQ(basis->atomIndices()[1], 0);
