+        rad_grid = RadialGrid(rad_pts, rad_wts)
+        degs = [3, 5, 7]
+        atgrid = AtomicGrid(rad_grid, degs=degs)
+        assert atgrid.n_shells == 3
+        # grep shell with r^2
