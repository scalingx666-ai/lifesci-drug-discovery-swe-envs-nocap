+
+                        charge = decimal.Decimal(pos_site.split()[4])
+
+                        extra_sites[sites_no] = [(parent, closest_atoms[0], closest_atoms[1]), (p1 * 0.1, p2 * 0.1, p3 * 0.1), charge]
+                        sites_no += 1
