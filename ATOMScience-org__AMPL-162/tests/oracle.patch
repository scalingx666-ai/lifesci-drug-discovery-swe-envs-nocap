diff --git a/atomsci/ddm/test/integrative/integrative_batch_tests.sh b/atomsci/ddm/test/integrative/integrative_batch_tests.sh
new file mode 100755
index 00000000..4d32dd71
--- /dev/null
+++ b/atomsci/ddm/test/integrative/integrative_batch_tests.sh
@@ -0,0 +1,15 @@
+#!/usr/bin/env bash
+
+# walk the directory tree and run pytest
+for f in *; do
+    if [ -d "$f" ] ; then
+         # look for the directories that contain test*.py. if found, cd into and run pytest
+         file=($f/test_*.py)
+         if [[ -f "$file" ]]; then
+            cd ${f}
+            echo "Testing $f"
+            pytest
+            cd ..
+        fi
+    fi
+done
