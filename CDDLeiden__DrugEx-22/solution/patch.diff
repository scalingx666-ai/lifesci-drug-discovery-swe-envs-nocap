+
+    def test_shape_mode_flags(self):
+        cmd = self._cmd("shape")
+        self.assertIn("-shapeonly", cmd)
+
+    def test_combo_mode_flags(self):
+        cmd = self._cmd("combo")
+        self.assertNotIn("-shapeonly", cmd)
