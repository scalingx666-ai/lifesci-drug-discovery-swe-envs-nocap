+            ("mol2chemprop", mol2chemprop),
+            ("error_filter", error_filter),
+            ("neural_fp", neural_fp),
+            ("rf", rf),
+            ("filter_reinserter", PostPredictionWrapper(filter_reinserter)),
+        ],
+        n_jobs=pipeline_n_jobs,
