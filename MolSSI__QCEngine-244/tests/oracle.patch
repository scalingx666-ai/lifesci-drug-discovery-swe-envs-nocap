+        "HF TOTAL ENERGY",
+        "LCCD CORRELATION ENERGY",
+        "LCCD TOTAL ENERGY",
+        "LCCD SAME-SPIN CORRELATION ENERGY",
+        "LCCD SINGLES ENERGY",
+        "LCCD DOUBLES ENERGY",
+        "LCCD OPPOSITE-SPIN CORRELATION ENERGY",
