+    g2 = nx.Graph()
+    for i, (s, p) in enumerate(
+        [
+            ("N", (0, 0, 0)),
+            ("C", (1, 1, 0)),
+            ("C", (2, 0, 0)),
+            ("F", (3, -1, 0)),
