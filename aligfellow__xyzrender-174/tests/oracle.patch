+    try:
+        a, b, c = float(cell["a"]), float(cell["b"]), float(cell["c"])
+        alpha, beta, gamma = float(cell["alpha"]), float(cell["beta"]), float(cell["gamma"])
+    except (KeyError, TypeError, ValueError):
+        return None
+    return _abc_angles_to_cell(a, b, c, alpha, beta, gamma)
