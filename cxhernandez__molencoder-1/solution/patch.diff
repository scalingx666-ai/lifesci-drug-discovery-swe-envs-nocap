+def adjust_learning_rate(optimizer, epoch, tau=30, lr_init=1E-4):
+    """Decays the LR by 10 every tau epochs"""
+    lr = lr_init * (0.1 ** (epoch // tau))
+    for param_group in optimizer.param_groups:
+        param_group['lr'] = lr
