+                                             program='geometric',
+                                             qc_specification=QCSpecification(program='psi4', method='b3lyp', basis='def2-svp', driver='deferred'),
+                                             keywords={'convergence_set': 'tight'})
+
+.. dropdown:: Add optimization records, adjust protocols
+
+  .. tab-set::
