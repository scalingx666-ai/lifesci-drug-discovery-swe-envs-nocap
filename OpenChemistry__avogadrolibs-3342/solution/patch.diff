+std::vector<char> insideSet(const Cube& cube)
+{
+  std::vector<char> set(cube.data()->size());
+  for (std::size_t i = 0; i < set.size(); ++i)
+    set[i] = (*cube.data())[i] > 0.0f ? 1 : 0;
