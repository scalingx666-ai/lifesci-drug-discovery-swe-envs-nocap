+
+    sdf_file_path = tmp_path / "mols_with_props.sdf"
+    MolToSDFTransformer(str(sdf_file_path)).transform(mols)
+
+    mols = MolFromSDFTransformer().transform(str(sdf_file_path))
+    mols = [pickle.loads(pickle.dumps(mol)) for mol in mols]
+
