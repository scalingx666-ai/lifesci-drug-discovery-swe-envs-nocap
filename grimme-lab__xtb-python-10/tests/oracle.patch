+    "methanol": Solvent.methanol,
+    "nhexane": Solvent.nhexane,
+    "n-hexane": Solvent.nhexane,
+    "thf": Solvent.thf,
+    "toluene": Solvent.toluene,
+}
+
+
+def get_solvent(solvent: str) -> Optional[Solvent]:
+    """Return the correct solvent enumerator for a string input."""
