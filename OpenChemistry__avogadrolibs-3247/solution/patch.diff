+TEST_F(SelectCommandTest, defaultRegisterCommandsEmitsEveryCommand)
+{
+  QStringList seen;
+  QObject::connect(&m_select, &Select::registerCommand,
+                   [&seen](QString name, QString description) {
+                     EXPECT_FALSE(description.isEmpty());
+                     seen << name;
