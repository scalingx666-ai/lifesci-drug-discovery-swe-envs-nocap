+    /** The mapping the other way round, from a molecule of {@code size} atoms. */
+    static int[] inverse(int[] mapping, int size) {
+        int[] inverse = new int[size];
+        Arrays.fill(inverse, -1);
+        for (int i = 0; i < mapping.length; i++) {
+            if (mapping[i] >= 0) {
+                inverse[mapping[i]] = i;
+            }
+        }
+        return inverse;
+    }
