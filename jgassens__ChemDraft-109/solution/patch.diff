diff --git a/apps/desktop/src/App.css b/apps/desktop/src/App.css
index 4802073c4..7b8583c4c 100644
--- a/apps/desktop/src/App.css
+++ b/apps/desktop/src/App.css
@@ -3367,6 +3367,47 @@ textarea:focus-visible,
   background-size: var(--ruler-unit) var(--ruler-unit);
 }
 
+/* Bound all document paint z-indices to one context. No number of object runs
+   can overtake edit chrome, live previews, Spin 3D or region-selection feedback. */
+.page-object-stack,
+.page-interaction-layer {
+  position: absolute;
+  inset: 0;
+  pointer-events: none;
+}
+
+.page-object-stack { z-index: 2; }
+.page-interaction-layer { z-index: 3; }
+
+.document-object-chrome {
+  position: absolute;
+  display: block;
+  pointer-events: none;
+  transform-origin: center;
+}
+
+.page-object-stack .document-object-overlay.selected { outline: none; }
+.document-object-chrome.selected {
+  outline: 2px solid var(--cd-accent);
+  outline-offset: 3px;
+}
+
+.document-object-chrome .native-atom-label-editor,
+.document-object-chrome .text-object-editor {
+  pointer-events: auto;
+}
+
+.object-transform-preview-visual {
+  position: absolute;
+  inset: 0;
+  width: 100%;
+  height: 100%;
+  overflow: visible;
+  pointer-events: none;
+}
+.object-transform-preview-visual * { pointer-events: none !important; }
+.document-object-chrome .text-object-edit-preview { opacity: 1; }
+
 .crosshair-overlay {
   --crosshair-tick-minor-length: 4px;
   --crosshair-tick-quarter-length: 6px;
@@ -3466,7 +3507,8 @@ textarea:focus-visible,
   pointer-events: auto;
 }
 
-.page-svg-surface {
+.page-svg-surface,
+.page-svg-visual-layer {
   position: absolute;
   inset: 0;
   z-index: 2;
@@ -7440,3 +7482,29 @@ textarea:focus-visible,
   font-size: 10px;
   line-height: 1.35;
 }
+
+/* Paint and ordinary hits live in the ordered SVG runs. These copies retain the
+   existing edit/preview DOM contract; editor and handle siblings stay interactive. */
+.document-object-overlay .graphic-glyph-shell,
+.document-object-overlay .art-transform-drag-preview,
+.document-object-overlay > .reaction-arrow-glyph,
+.document-object-overlay > .bracket-glyph {
+  opacity: 0;
+}
+.document-object-overlay .graphic-glyph-shell *,
+.reaction-arrow-object.document-object-overlay,
+.bracket-object.document-object-overlay {
+  pointer-events: none !important;
+}
+.molecule-object.document-object-overlay:not(.native-molecule-object) {
+  border-color: transparent;
+  background: transparent;
+}
+
+.generic-object.document-object-overlay {
+  border-color: transparent;
+  background: transparent;
+}
+.text-object-edit-preview {
+  opacity: 0;
+}
